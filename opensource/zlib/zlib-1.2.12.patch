+
+    test_CVE_2018_25032(default_file_data, 1, 15, 1, Z_FIXED);
+    test_CVE_2018_25032(default_file_data, 2, 15, 1, Z_FIXED);
+    test_CVE_2018_25032(default_file_data, 6, 15, 1, Z_FIXED);
+    test_CVE_2018_25032(fixed_file_data, 1, 15, 1, Z_FIXED);
+    test_CVE_2018_25032(fixed_file_data, 2, 15, 1, Z_FIXED);
+    test_CVE_2018_25032(fixed_file_data, 6, 15, 1, Z_FIXED);
+
     free(compr);
     free(uncompr);
 
