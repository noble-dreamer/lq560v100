+void test_CVE_2018_25032(data, level, window_bits, mem_level, strategy)
+    unsigned char *data;
+    int level, window_bits, mem_level, strategy;
+{
+    int err;
+    uLong len = (uLong)strlen(data) + 1;
+
+    // deflate
+    z_stream c_strm;
+    c_strm.zalloc = Z_NULL;
+    c_strm.zfree = Z_NULL;
+    c_strm.opaque = (void *)0;
+    c_strm.total_in = 0;
+    c_strm.total_out = 0;
+    c_strm.next_in = data;
+    c_strm.avail_in = len;
+    err = deflateInit2(&c_strm, level, Z_DEFLATED, window_bits, mem_level, strategy);
+    CHECK_ERR(err, "CVE-2018-25032");
+
+    uLong outlen = deflateBound(&c_strm, len);
+    unsigned char *c_out = (unsigned char *)calloc(outlen, 1);
+    unsigned char *d_out = (unsigned char *)calloc(len, 1);
+    if (c_out == Z_NULL || d_out == Z_NULL) {
+        printf("out of memory\n");
+        exit(1);
+    }
+    c_strm.next_out = c_out;
+    c_strm.avail_out = outlen;
+ 
+    err = deflate(&c_strm, Z_FINISH);
+    if (err != Z_STREAM_END) {
+        fprintf(stderr, "CVE-2018-25032 error: %d\n", err);
+        exit(1);
+    }
+
+    err = deflateEnd(&c_strm);
+    CHECK_ERR(err, "CVE-2018-25032");
+ 
+    // inflate
+    z_stream d_strm;
+    d_strm.zalloc = Z_NULL;
+    d_strm.zfree = Z_NULL;
+    d_strm.opaque = (void *)0;
+    d_strm.next_in = c_out;
+    d_strm.avail_in = c_strm.total_out;
+    d_strm.next_out = d_out;
+    d_strm.avail_out = len;
+    err = inflateInit2(&d_strm, window_bits);
+    CHECK_ERR(err, "CVE-2018-25032");
+ 
+    err = inflate(&d_strm, Z_FINISH);
+    if (err != Z_STREAM_END) {
+        fprintf(stderr, "CVE-2018-25032 error %d\n", err);
+        exit(1);
+    }
+ 
+    err = inflateEnd(&d_strm);
+    CHECK_ERR(err, "CVE-2018-25032");
+
+    if (strcmp(data, d_out)) {
+        fprintf(stderr, "CVE-2018-25032 error\n");
+        exit(1);
+    }
+ 
+    free(c_out);
+    free(d_out);
+}
+
+void test_CVE_2022_37434(compr, comprLen, uncompr, uncomprLen)
+    Byte *compr, *uncompr;
+    uLong comprLen, uncomprLen;
+{
+    int err;
+
+    // deflate gzip
+    uLong len = (uLong)strlen(hello) + 1;
+    z_stream c_strm;
+    c_strm.zalloc = Z_NULL;
+    c_strm.zfree = Z_NULL;
+    c_strm.opaque = (void *)0;
+    c_strm.total_in = 0;
+    c_strm.total_out = 0;
+    c_strm.next_in = hello;
+    c_strm.avail_in = len;
+    c_strm.next_out = compr;
+    c_strm.avail_out = comprLen;
+    err = deflateInit2(&c_strm, Z_DEFAULT_COMPRESSION, Z_DEFLATED, 31, MAX_MEM_LEVEL, Z_DEFAULT_STRATEGY);
+    CHECK_ERR(err, "CVE-2022-37434");
+
+    gz_header c_head;
+    c_head.comment = Z_NULL;
+    c_head.name = Z_NULL;
+    c_head.extra = (unsigned char*)malloc(100); /* 100 bytes of extra data */
+    c_head.extra_len = 100;
+    if (c_head.extra == Z_NULL) {
+        printf("out of memory\n");
+        exit(1);
+    }
+    err = deflateSetHeader(&c_strm, &c_head);
+    CHECK_ERR(err, "CVE-2022-37434");
+
+    err = deflate(&c_strm, Z_FINISH);
+    if (err != Z_STREAM_END) {
+        fprintf(stderr, "CVE-2022-37434 error %d\n", err);
+        exit(1);
+    }
+
+    err = deflateEnd(&c_strm);
+    CHECK_ERR(err, "CVE-2022-37434");
+
+    // inflate gzip
+    z_stream d_strm;
+    d_strm.zalloc = Z_NULL;
+    d_strm.zfree = Z_NULL;
+    d_strm.opaque = (void *)0;
+    d_strm.total_in = 0;
+    d_strm.total_out = 0;
+    d_strm.next_in = compr;
+    d_strm.next_out = uncompr;
+    d_strm.avail_out = uncomprLen;
+    err = inflateInit2(&d_strm, 31); /* inflate gzip data, and set windowBits = 15,  */
+    CHECK_ERR(err, "CVE-2022-37434");
+
+    gz_header d_head;
+    d_head.extra = (unsigned char*)malloc(10); /* malloc 10 bytes of memory to extra, less than real extra data length(100) */
+    d_head.extra_max = 10;
+    if (c_head.extra == Z_NULL) {
+        printf("out of memory\n");
+        exit(1);
+    }
+    err = inflateGetHeader(&d_strm, &d_head);
+    CHECK_ERR(err, "CVE-2022-37434");
+
+    do {
+        d_strm.avail_in = 5;
+        err = inflate(&d_strm, Z_NO_FLUSH);
+        if (err == Z_STREAM_END) {
+            break;
+        }
+        CHECK_ERR(err, "CVE-2022-37434");
+    } while (d_strm.total_in < c_strm.total_out);
+
+    err = inflateEnd(&d_strm);
+    CHECK_ERR(err, "CVE-2022-37434");
+
+    free(c_head.extra);
+    free(d_head.extra);
+}
