   <Part Sel="1" PartitionName="rootfs" FlashType="nand" FileSystem="none" Start="11776K" Length="8M" SelectFile="rootfs_lq560plusv100.ramdisk.img"/>
   <Part Sel="1" PartitionName="upgrade" FlashType="nand" FileSystem="none" Start="19968K" Length="32M" SelectFile="upgrade.ubi"/>
