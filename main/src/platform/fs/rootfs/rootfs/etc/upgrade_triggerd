#!/bin/sh
# upgrade_triggerd: COM-port trigger + version query for USB upgrade (UVC mode).
# Reads /dev/ttyGS0 (the CDC-ACM COM port). Two commands:
#   UPGRADE:5AA55AA5  -> switch to upgrade mode (usb_mode_ctl upgrade)
#   VERSION?           -> reply with current firmware version, no mode switch
TRIGGER=/etc/usb_mode_ctl.sh
TTY=/dev/ttyGS0
PIDFILE=/tmp/upgrade_triggerd.pid
TOKEN="${UPGRADE_TOKEN:-UPGRADE:5AA55AA5}"

echo $$ > "$PIDFILE"
trap 'rm -f "$PIDFILE"' EXIT INT TERM

# ttyGS0 appears once acm.usb0 is instantiated and carries data after UDC bind.
i=0
while [ ! -e "$TTY" ] && [ "$i" -lt 100 ]; do
    sleep 0.1
    i=$((i + 1))
done
[ -e "$TTY" ] || exit 0

stty -F "$TTY" -echo 2>/dev/null
# open read-write so we can answer VERSION? on the same port
exec 3<>"$TTY"
cr=$(printf '\r')

while IFS= read -r line <&3; do
    line="${line%$cr}"
    case "$line" in
        "$TOKEN")
            "$TRIGGER" upgrade >/dev/null 2>&1 &
            exit 0
            ;;
        "VERSION?")
            # reply with current version (first field of /etc/fs-version),
            # prefixed "V:"; do NOT switch modes.
            read -r ver </etc/fs-version 2>/dev/null
            printf 'V:%s\n' "$ver" >&3
            ;;
    esac
done
exit 0
