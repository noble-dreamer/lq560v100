+	if (len % MMC_MAX_BLOCK_LEN)
+		blk_dwrite(mmc_get_blk_desc(mmc), (offset >> EMMC_BLOCK_SHIFT),
+				   (len >> EMMC_BLOCK_SHIFT) + 1, buf);
+	else
