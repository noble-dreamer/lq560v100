+static td_bool is_ree_verify_enable(void)
+{
+   td_u8 flag = (td_u8)((readl(IMAGE_VERIFY_ENABLE_REG_ADDR) >> IMAGE_VERIFY_ENABLE_REG_BIT) & 0xFF);
+
+   if (flag == IMAGE_VERIFY_DISABLE_VAL) {
+       return TD_FALSE;
+   }
+
+    return TD_TRUE;
+}
+
+static td_u32 is_ree_dec_enable(void)
+{
+    /* 0x6[24:16], 8bit */
+    td_u32 val = readl(OTP_4BIT_ALIGNED_LOCKABLE);
+    if (((val >> 16) & 0xF) == 0) {
+        return TD_FALSE;
+    }
+
+    return TD_TRUE;
+}
+
+static td_u32 is_algo_gm(void)
+{
+    /* 0x0[0], 8bit */
+    td_u32 val = readl(OTP_BIT_ALIGNED_LOCKABLE);
+    if (((val >> 0) & 1) == 0) {
+        return TD_FALSE;
+    }
+
+    return TD_TRUE;
+}
+
+static u32 count_bit_set(u32 input)
+{
+    u32 count = 0; /* count accumulates the total bits set in input */
+    for (count = 0; input; count++) {
+        input &= input - 1; /* clear the least significant bit set */
+    }
+    return count;
+}
+
+static td_u32 ree_boot_version_get(td_u32 addr, td_u32 *version)
+{
+    /* [0x1D0 ~ 0x1D4), 32bit */
+    td_s32 ret = TD_FAILURE;
+
+    ret = ot_omi_otp_init();
+    if (ret != TD_SUCCESS) {
+        return SB_ERROR_OTP_ERR;
+    }
+
+    ret = ot_omi_otp_read_word(addr, version);
+    if (ret != TD_SUCCESS) {
+        return SB_ERROR_OTP_ERR;
+    }
+
+    ret = ot_omi_otp_deinit();
+    if (ret != TD_SUCCESS) {
+        return SB_ERROR_OTP_ERR;
+    }
+
+    return TD_SUCCESS;
+}
+
+static td_s32 check_image_version(const td_u32 img_ver, const td_u32 img_mask)
+{
+    u32 otp_boot_ver_l = 0x0;
+    u32 otp_boot_ver_h = 0x0;
+    static td_u8 init_ver = 0;
+    static td_u32 last_ver = 0;
+	if (is_ree_verify_enable() != TD_TRUE) {
+		/* Not Verify */
+		return SB_ERROR_NONE;
+	}
+    if (init_ver == 0) {
+        last_ver = img_ver;
+        init_ver = 1;
+    } else {
+        if (last_ver != img_ver) {
+            printf("image version not the same, last: %d, cur: %d\n\r", last_ver, img_ver);
+            return SB_ERROR_VERSION_ERR;
+        }
+    }
+
+    if ((ree_boot_version_get(OTP_REE_BOOT_VERSION_L, &otp_boot_ver_l) != SB_ERROR_NONE) || 
+        (ree_boot_version_get(OTP_REE_BOOT_VERSION_H, &otp_boot_ver_h) != SB_ERROR_NONE)) {
+        return SB_ERROR_OTP_ERR;
+    }
+
+    u32 otp_ver = count_bit_set(otp_boot_ver_h) + count_bit_set(otp_boot_ver_l);
+
+    if (otp_ver > img_ver) {
+        return SB_ERROR_VERSION_ERR;
+    }
+
+    return SB_ERROR_NONE;
+}
+
+static td_u8 local_xtoa_big(td_u8 hex)
+{
+    td_u8 ac = 0;
+    if (hex > 9) {
+       ac = hex - 10 + 'A';
+    } else {
+       ac = hex - 0 + '0';
+    }
+
+    return ac;
+}
+
+static void pub_key_xtoa(td_u8 *key_x, td_u8 *key_a, td_u32 klen)
+{
+    td_u32 i = 0;
+    key_a[0] = '0';
+    key_a[1] = 'x';
+    for (i = 0; i < klen; i++) {
+        /* Sample: 0x5A */
+        key_a[2 + 2 * i] = local_xtoa_big((key_x[i] >> 4) & 0xF);
+        key_a[2 + 2 * i + 1] = local_xtoa_big(key_x[i] & 0xF);
+    }
+
+    key_a[2 + 2 * i] = '\0';
+}
+
+
+static td_s32 hash_data(td_u8 *data, td_u32 len, crypto_hash_type hash_type, td_u8 *digest, td_u32 digest_len)
+{
+    td_s32 ret = TD_FAILURE;
+    crypto_hash_attr hash_attr = {0};
+    hash_attr.hash_type = hash_type;
+    td_handle hash_handle;
+    crypto_buf_attr hash_buf;
+    td_u32 cal_len = 0;
+
+    ret = ot_omi_cipher_hash_create(&hash_handle, &hash_attr);
+    if (ret != TD_SUCCESS) {
+        return ret;
+    }
+
+    hash_buf.virt_addr = data;
+    ret = ot_omi_cipher_hash_update(hash_handle, &hash_buf, len);
+
+    ot_omi_cipher_hash_finish(hash_handle, digest, digest_len, &cal_len);
+
+    return ret;
+}
+
+static td_s32 ecc_verify_data(td_u8 *image, td_u32 len, td_u8 *signature, td_u8 *pb_key)
+{
+    td_s32 ret = TD_FAILURE;
+
+    td_u8 x[ECC_256_KEY_LENGTH];
+    (td_void)memcpy_s(x, sizeof(x), (td_void *)pb_key, sizeof(x));
+
+    td_u8 y[ECC_256_KEY_LENGTH];
+    (td_void)memcpy_s(y, sizeof(y), (td_void *)(pb_key + sizeof(x)), sizeof(y));
+
+    td_u8 r[ECC_256_KEY_LENGTH];
+    (td_void)memcpy_s(r, sizeof(r), signature, sizeof(r));
+
+    td_u8 s[ECC_256_KEY_LENGTH];
+    (td_void)memcpy_s(s, sizeof(s), signature + sizeof(r), sizeof(s));
+
+    td_u8 hash[SHA_256_LEN];
+    (td_void)memset_s(hash, sizeof(hash), 0, sizeof(hash));
+
+    drv_pke_ecc_point pub_key;
+    (td_void)memset_s(&pub_key, sizeof(pub_key), 0, sizeof(pub_key));
+
+    drv_pke_ecc_sig sig;
+    (td_void)memset_s(&sig, sizeof(sig), 0, sizeof(sig));
+
+    drv_pke_data pke_data;
+    (td_void)memset_s(&pke_data, sizeof(pke_data), 0, sizeof(pke_data));
+
+    ret = hash_data(image, len, CRYPTO_HASH_TYPE_SHA256, hash, sizeof(hash));
+    if (ret != TD_SUCCESS) {
+        return ret;
+    }
+
+    /* ECC verify */
+    pub_key.x = x;
+    pub_key.y = y;
+    pub_key.length = ECC_256_KEY_LENGTH;
+
+    sig.r = r;
+    sig.s = s;
+    sig.length = ECC_256_KEY_LENGTH;
+
+    pke_data.data = hash;
+    pke_data.length = sizeof(hash);
+
+    ret = ot_omi_cipher_pke_init();
+    if (ret != TD_SUCCESS) {
+        return ret;
+    }
+
+    ret = ot_omi_cipher_pke_ecdsa_verify(DRV_PKE_ECC_TYPE_RFC5639_P256, &pub_key, &pke_data, &sig);
+    if (ret != TD_SUCCESS) {
+        printf("verify signature fail.\n\r");
+    } else {
+        printf("verify signature success.\n\r");
+    }
+
+    ot_omi_cipher_pke_deinit();
+
+    return ret;
+}
+
+static td_s32 sm2_verify_data(td_u8 *image, td_u32 len, td_u8 *signature, td_u8 *pb_key)
+{
+    td_s32 ret = TD_FAILURE;
+
+    td_u8 x[ECC_SM2_KEY_LENGTH];
+    (td_void)memcpy_s(x, sizeof(x), (td_void *)pb_key, sizeof(x));
+
+    td_u8 y[ECC_SM2_KEY_LENGTH];
+    (td_void)memcpy_s(y, sizeof(y), (td_void *)(pb_key + sizeof(x)), sizeof(y));
+
+    td_u8 r[ECC_SM2_KEY_LENGTH];
+    (td_void)memcpy_s(r, sizeof(r), signature, sizeof(r));
+
+    td_u8 s[ECC_SM2_KEY_LENGTH];
+    (td_void)memcpy_s(s, sizeof(s), signature + sizeof(r), sizeof(s));
+
+    td_u8 hash[SM3_HASH_LEN];
+    (td_void)memset_s(hash, sizeof(hash), 0, sizeof(hash));
+
+    drv_pke_ecc_sig sig;
+    (td_void)memset_s(&sig, sizeof(sig), 0, sizeof(sig));
+
+    td_u8 sm2_id_buf[SM2_ID_LEN];
+    memcpy_s(sm2_id_buf, SM2_ID_LEN, SM2_ID, SM2_ID_LEN);
+    drv_pke_data sm2_id;
+    (td_void)memset_s(&sm2_id, sizeof(sm2_id), 0, sizeof(sm2_id));
+
+    drv_pke_ecc_point pub_key;
+    (td_void)memset_s(&pub_key, sizeof(pub_key), 0, sizeof(pub_key));
+
+    drv_pke_msg msg;
+    (td_void)memset_s(&msg, sizeof(msg), 0, sizeof(msg));
+
+    drv_pke_data pke_data; /* output hash */
+    (td_void)memset_s(&pke_data, sizeof(pke_data), 0, sizeof(pke_data));
+
+    ret = ot_omi_cipher_pke_init();
+    if (ret != TD_SUCCESS) {
+        return ret;
+    }
+
+    sm2_id.data = sm2_id_buf;
+    sm2_id.length = SM2_ID_LEN;
+
+    pub_key.x = x;
+    pub_key.y = y;
+    pub_key.length = ECC_SM2_KEY_LENGTH;
+
+    msg.data = image;
+    msg.length = len;
+    msg.buf_sec = DRV_PKE_BUF_NONSECURE;
+
+    pke_data.data = hash;
+    pke_data.length = sizeof(hash);
+    ret = ot_omi_cipher_pke_sm2_dsa_hash(&sm2_id, &pub_key, &msg, &pke_data);
+    if (ret != TD_SUCCESS) {
+        return ret;
+    }
+
+    sig.r = r;
+    sig.s = s;
+    sig.length = ECC_SM2_KEY_LENGTH;
+
+    ret = ot_omi_cipher_pke_ecdsa_verify(DRV_PKE_ECC_TYPE_SM2, &pub_key, &pke_data, &sig);
+    if (ret != TD_SUCCESS) {
+        printf("verify signature fail.\n\r");
+    } else {
+        printf("verify signature success.\n\r");
+    }
+
+    ot_omi_cipher_pke_deinit();
+
+    return ret;
+}
+
+static td_u8 *get_verify_pub_key(void)
+{
+    td_u8 *pub_key = (td_u8 *)PUB_KEY_OFFSET;
+
+    return pub_key;
+}
+
+static td_s32 verify_image_sign(td_u8 *image, td_u32 len, td_u8 *signature, td_u8 algo_type)
+{
+    td_s32 ret = TD_FAILURE;
+
+    td_u8 *pub_key = get_verify_pub_key();
+
+    if (algo_type == SB_ALOG_NM) {
+        printf("ecc algo verify >>>\n\r");
+        ret = ecc_verify_data(image, len, signature, pub_key);
+    } else {
+        printf("sm2 algo verify >>>\n\r");
+        ret = sm2_verify_data(image, len, signature, pub_key);
+    }
+
+    return ret;
+}
+
+static td_s32 symc_cipher_set_rootkey(crypto_handle keyslot_crypto_handle, td_u8 algo_type,
+                                      td_u8 *session_key, td_u8 *content_key)
+{
+    td_s32 ret = TD_FAILURE;
+
+    crypto_handle klad_handle = 0;
+    td_u32 offset = 0x12;
+    td_u8 tee_enable = 0;
+
+    km_klad_attr klad_attr;
+    memset_s(&klad_attr, sizeof(klad_attr), 0, sizeof(klad_attr));
+
+    km_klad_session_key klad_session_key;
+    memset_s(&klad_session_key, sizeof(klad_session_key), 0, sizeof(klad_session_key));
+
+    km_klad_content_key klad_content_key;
+    memset_s(&klad_content_key, sizeof(klad_content_key), 0, sizeof(klad_content_key));
+
+    klad_attr.klad_cfg.rootkey_type = KLAD_ROOTKEY_TYPE;
+    klad_attr.key_cfg.decrypt_support = TD_TRUE;
+    klad_attr.key_cfg.encrypt_support = TD_TRUE;
+
+    klad_session_key.level = KM_KLAD_LEVEL1;
+    klad_session_key.key = session_key;
+
+    klad_content_key.key = content_key;
+
+    if (algo_type == SB_ALOG_NM) {
+        klad_attr.key_cfg.engine = KM_CRYPTO_ALG_AES;
+
+        klad_session_key.alg = KM_KLAD_ALG_TYPE_AES;
+        klad_session_key.key_size = KLAD_AES_SESSION_KEY_LEN;
+
+        klad_content_key.alg = KM_KLAD_ALG_TYPE_AES;
+        klad_content_key.key_size = KLAD_AES_CONTENT_KEY_LEN;
+    } else {
+        klad_attr.key_cfg.engine = KM_CRYPTO_ALG_SM4;
+
+        klad_session_key.alg = KM_KLAD_ALG_TYPE_SM4;
+        klad_session_key.key_size = KLAD_SM4_SESSION_KEY_LEN;
+
+        klad_content_key.alg = KM_KLAD_ALG_TYPE_SM4;
+        klad_content_key.key_size = KLAD_SM4_CONTENT_KEY_LEN;
+    }
+
+    (td_void)ot_omi_otp_init();
+    (td_void)ot_omi_otp_read_byte(offset, &tee_enable);
+    (td_void)ot_omi_otp_deinit();
+    if (tee_enable == 0x42) {
+        klad_attr.key_sec_cfg.key_sec = KM_KLAD_SEC_ENABLE;
+        klad_attr.key_sec_cfg.master_only_enable = TD_TRUE;
+        klad_attr.key_sec_cfg.dest_buf_sec_support = TD_TRUE;
+        klad_attr.key_sec_cfg.src_buf_sec_support = TD_TRUE;
+        klad_attr.key_sec_cfg.src_buf_non_sec_support = TD_FALSE;
+        klad_attr.key_sec_cfg.dest_buf_non_sec_support = TD_FALSE;
+    } else {
+        klad_attr.key_sec_cfg.key_sec = KM_KLAD_SEC_DISABLE;
+        klad_attr.key_sec_cfg.master_only_enable = TD_FALSE;
+        klad_attr.key_sec_cfg.dest_buf_sec_support = TD_FALSE;
+        klad_attr.key_sec_cfg.dest_buf_non_sec_support = TD_TRUE;
+        klad_attr.key_sec_cfg.src_buf_sec_support = TD_FALSE;
+        klad_attr.key_sec_cfg.src_buf_non_sec_support = TD_TRUE;
+    }
+
+    /* 1. klad create handle */
+    ret = ot_omi_klad_create(&klad_handle);
+
+    /* 2. klad set attr for rootkey */
+    ret = ot_omi_klad_set_attr(klad_handle, &klad_attr);
+
+    /* 3. attach klad handle & kslot handle */
+    ret = ot_omi_klad_attach(klad_handle, KM_KLAD_DEST_TYPE_MCIPHER, keyslot_crypto_handle);
+
+    /* 4. set session key */
+    ret = ot_omi_klad_set_session_key(klad_handle, &klad_session_key);
+
+    /* 5. set content key */
+    ret = ot_omi_klad_set_content_key(klad_handle, &klad_content_key);
+
+    ret = ot_omi_klad_detach(klad_handle, KM_KLAD_DEST_TYPE_MCIPHER, keyslot_crypto_handle);
+    ret = ot_omi_klad_destroy(klad_handle);
+
+    return ret;
+}
+
+static td_s32 decrypt_image(td_u8 *image, td_u32 len,
+                            td_u8 *session_key, td_u8 *content_key, td_u8 *iv,
+                            td_u8 algo_type)
+{
+    td_s32 ret = TD_FAILURE;
+    crypto_handle keyslot_crypto_handle = 0;
+
+    td_handle symc_handle = 0;
+
+    crypto_buf_attr src_buf;
+    memset_s(&src_buf, sizeof(src_buf), 0, sizeof(src_buf));
+
+    crypto_buf_attr dst_buf;
+    memset_s(&dst_buf, sizeof(dst_buf), 0, sizeof(dst_buf));
+
+    crypto_symc_attr symc_attr;
+    memset_s(&symc_attr, sizeof(symc_attr), 0, sizeof(symc_attr));
+
+    symc_attr.symc_type = CRYPTO_SYMC_TYPE_NORMAL;
+    symc_attr.is_long_term = TD_FALSE;
+
+    crypto_symc_ctrl_t symc_ctrl;
+    memset_s(&symc_ctrl, sizeof(symc_ctrl), 0, sizeof(symc_ctrl));
+
+
+    memcpy_s(symc_ctrl.iv, IV_LEN, iv, IV_LEN);
+    if (algo_type == SB_ALOG_NM) {
+        printf("AES Decrypt:\n\r");
+        symc_ctrl.symc_alg = CRYPTO_SYMC_ALG_AES;
+        symc_ctrl.work_mode = CRYPTO_SYMC_WORK_MODE_CBC;
+        symc_ctrl.symc_key_length = CRYPTO_SYMC_KEY_128BIT;
+        symc_ctrl.symc_bit_width = CRYPTO_SYMC_BIT_WIDTH_128BIT;
+        symc_ctrl.iv_length = IV_LEN;
+    } else {
+        printf("SM4 Decrypt:\n\r");
+        symc_ctrl.symc_alg = CRYPTO_SYMC_ALG_SM4;
+        symc_ctrl.work_mode = CRYPTO_SYMC_WORK_MODE_CBC;
+        symc_ctrl.symc_key_length = CRYPTO_SYMC_KEY_128BIT;
+        symc_ctrl.symc_bit_width = CRYPTO_SYMC_BIT_WIDTH_128BIT;
+        symc_ctrl.iv_length = IV_LEN;
+    }
+
+    ret = ot_omi_cipher_symc_create(&symc_handle, &symc_attr);
+    if (ret != TD_SUCCESS) {
+        printf("ot_omi_cipher_symc_create error, ret: 0x%x\n\r", ret);
+        return ret;
+    }
+
+    ret = ot_omi_keyslot_create(&keyslot_crypto_handle, KM_KEYSLOT_TYPE_MCIPHER);
+    if (ret != TD_SUCCESS) {
+        printf("ot_omi_keyslot_create error, ret: 0x%x\n\r", ret);
+        goto symc_destroy;
+    }
+
+    ret = ot_omi_cipher_symc_attach(symc_handle, keyslot_crypto_handle);
+    if (ret != TD_SUCCESS) {
+        printf("ot_omi_cipher_symc_attach error, ret: 0x%x\n\r", ret);
+        goto keyslot_destroy;
+    }
+
+    ret = symc_cipher_set_rootkey(keyslot_crypto_handle, algo_type,
+                                  session_key, content_key);
+    if (ret != TD_SUCCESS) {
+        printf("symc_cipher_set_rootkey error, ret: 0x%x\n\r", ret);
+        goto keyslot_destroy;
+    }
+
+    ret = ot_omi_cipher_symc_set_config(symc_handle, &symc_ctrl);
+    if (ret != TD_SUCCESS) {
+        printf("ot_omi_cipher_symc_set_config error, ret: 0x%x\n\r", ret);
+        goto keyslot_destroy;
+    }
+
+    src_buf.phys_addr = (unsigned long)image;
+    dst_buf.phys_addr = (unsigned long)image;
+
+    ret = ot_omi_cipher_symc_decrypt(symc_handle, &src_buf, &dst_buf, len);
+    if (ret != TD_SUCCESS) {
+        printf("ot_omi_cipher_symc_decrypt error, ret: 0x%x\n\r", ret);
+    } else {
+        printf("ot_omi_cipher_symc_decrypt success.\n\r");
+    }
+
+keyslot_destroy:
+    ot_omi_keyslot_destroy(keyslot_crypto_handle);
+symc_destroy:
+    ot_omi_cipher_symc_destroy(symc_handle);
+
+    return ret;
+}
+
+static td_void verify_error_handle(td_void)
+{
+    printf("%s:%d\n\r", __func__, __LINE__);
+
+    while(1);
+}
+
+static td_s32 verify_image(IMAGE_HEADER *header, td_u8 *image)
+{
+    td_s32 ret = TD_FAILURE;
+    td_u8 algo_type = SB_ALOG_GM;
+    crypto_hash_type hash_type = CRYPTO_HASH_TYPE_SM3;
+
+    td_u8 hash[SHA_256_LEN];
+    (td_void)memset_s(hash, sizeof(hash), 0, sizeof(hash));
+
+    if (is_algo_gm()) {
+        algo_type = SB_ALOG_GM;
+        hash_type = CRYPTO_HASH_TYPE_SM3;
+    } else {
+        algo_type = SB_ALOG_NM;
+        hash_type = CRYPTO_HASH_TYPE_SHA256;
+    }
+
+    if (!((is_ree_dec_enable() == TD_FALSE) && (header->code_enc_flag == CODE_ENC_DISABLE))) {
+        ret = decrypt_image(image, header->image_length,
+                header->protectionkey_l1_enc, header->protectionkey_l2_enc, header->iv,
+                algo_type);
+        if (ret != TD_SUCCESS) {
+            verify_error_handle();
+        }
+    }
+
+	if (is_ree_verify_enable() != TD_TRUE) {
+		/* Not Verify */
+		printf("\n\rverify Not Enable.\n\r");
+		return TD_SUCCESS;
+	}
+
+    ret = verify_image_sign((td_u8 *)header, sizeof(IMAGE_HEADER) - (SIG_LEN * 2),
+                            header->signature, algo_type);
+    if (ret != TD_SUCCESS) {
+        verify_error_handle();
+    }
+    ret = hash_data(image, header->image_length, hash_type, hash, sizeof(hash));
+
+    if (ret != TD_SUCCESS) {
+        verify_error_handle();
+    }
+
+    ret = memcmp(hash, header->code_hash, sizeof(hash));
+    if (ret != 0) {
+        printf("image hash verify fail\n\r");
+        verify_error_handle();
+    } else {
+        printf("image hash verify success\n\r");
+    }
+
+    return ret;
+}
+
+static td_s32 get_image_header(td_u32 offset, IMAGE_HEADER *header)
+{
+    td_s32 ret = flash_read(offset, sizeof(*header), (td_u8 *)header);
+    if (ret < 0) {
+        printf("[error] get image header failed, ret: %d!\n\r", ret);
+        return SB_ERROR_DEV_READ;
+    }
+
+    if (header->magic != IMAGE_MAGIC) {
+        printf("[error] image format err, magic: 0x%x, target: 0x %x\n\r", header->magic, IMAGE_MAGIC);
+        return SB_ERROR_FORMAT_ERR;
+    }
+
+    return SB_ERROR_NONE;
+}
+
+static td_s32 get_image_data(td_u32 offset, td_u32 length, td_u8 *data_addr)
+{
+    td_u32 block_size = READ_BLOCK_SIZE;
+    td_u32 remain = length;
+    td_u32 rlen = 0;
+    td_s32 ret = TD_FAILURE;
+    do {
+        rlen = (remain > block_size) ? block_size : remain;
+        ret = flash_read(offset, rlen, data_addr);
+        if (ret < 0) {
+            printf("[error] get image data , ret: %d!\n\r", ret);
+            return SB_ERROR_DEV_READ;
+        }
+        remain -= rlen;
+        offset += rlen;
+        data_addr += rlen;
+    } while(remain > 0);
+
+    return SB_ERROR_NONE;
+}
+
+static td_s32 add_sec_info_to_bootargs(td_u8 *pub_key, td_u32 ver)
+{
+    td_u32 bootargs_size = 128*10*3;
+
+    td_s8 *bootargs_origin = NULL;
+    td_u8 *bootargs_new = NULL;
+    td_u8 *pub_key_x = NULL;
+    td_u8 pub_key_a[ECC_256_KEY_LENGTH * 2 * 2 + 4]; /* (x, y), 0x1234...1234 */
+    (td_void)memset_s(pub_key_a, sizeof(pub_key_a), 0, sizeof(pub_key_a));
+    td_s8 *pubkey_tag = "verify_pubkey";
+    td_s8 *ver_tag = "image_ver";
+
+    bootargs_origin = env_get("bootargs");
+    if (strstr(bootargs_origin, pubkey_tag) != NULL) {
+        return TD_SUCCESS;
+    }
+
+    bootargs_new = (char *)malloc(bootargs_size);
+
+    if (bootargs_new == NULL) {
+        printf("malloc %d failed.\n\r", bootargs_size);
+        return TD_FAILURE;
+    }
+    (td_void)memset_s(bootargs_new, bootargs_size, 0, bootargs_size);
+
+    /* add pub key */
+    pub_key_x = pub_key;
+    pub_key_xtoa(pub_key_x, pub_key_a, ECC_256_KEY_LENGTH*2);
+
+    /* add image version */
+    td_u32 ver_x = (td_u32)((((ver >> 0) & 0xFF) << 24) | (((ver >> 8) & 0xFF) << 16) |
+                            (((ver >> 16) & 0xFF) << 8) | (((ver >> 24) & 0xFF) << 0));
+    td_u8 ver_a[16];
+    (td_void)memset_s(ver_a, sizeof(ver_a), 0, sizeof(ver_a));
+    pub_key_xtoa((td_u8 *)(&ver_x), (td_u8 *)(&ver_a), 4);
+
+    snprintf(bootargs_new, bootargs_size, "%s %s=%s %s=%s",
+            (bootargs_origin == NULL) ? "" : (char *)bootargs_origin,
+            (char *)pubkey_tag, (char *)pub_key_a, (char *)ver_tag, (char *)ver_a);
+
+
+    env_set("bootargs", bootargs_new);
+
+    free(bootargs_new);
+
+    return TD_SUCCESS;
+}
+
+#define CFG_VERIFY_MAXARGS          3
+static td_s32 do_verify_image(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+    td_s32 ret = TD_FAILURE;
+
+    if (argc != CFG_VERIFY_MAXARGS) {
+        printf("usage:\n%s\n", cmdtp->usage);
+        return -1;
+    }
+
+    td_u32 image_offset = (td_u32)hextoul(argv[1], NULL);
+    td_u8 *image_addr = (td_u8 *)hextoul(argv[2], NULL);
+
+    IMAGE_HEADER *img_header = (IMAGE_HEADER *)image_addr;
+
+#if CONFIG_IS_ENABLED(CMD_TIMESTAMP)
+    timestamp_mark("verify read start", __LINE__);
+#endif
+    memset_s(img_header, sizeof(*img_header), 0, sizeof(*img_header));
+    ret = get_image_header(image_offset, img_header);
+    if (ret != SB_ERROR_NONE) {
+        verify_error_handle();
+    }
+
+    ret = get_image_data(image_offset, sizeof(*img_header) + img_header->image_length, image_addr);
+    if (ret != SB_ERROR_NONE) {
+        printf("get image data failed(0x%x)\n\r", ret);
+        verify_error_handle();
+        return ret;
+    }
+
+#if CONFIG_IS_ENABLED(CMD_TIMESTAMP)
+   timestamp_mark("verify data start", __LINE__);
+#endif
+
+    ret = crypto_cipher_init();
+    if (ret != TD_SUCCESS) {
+        printf("crypto cipher failed(0x%x)\n\r", ret);
+        return ret;
+    }
+
+    ret = verify_image(img_header, image_addr + sizeof(*img_header));
+    if (ret != TD_SUCCESS) {
+        printf("verify image failed(0x%x)\n\r", ret);
+        verify_error_handle();
+    }
+
+    crypto_cipher_deinit();
+
+    ret = check_image_version(img_header->version_ext, img_header->mask_version_ext);
+    if (ret != SB_ERROR_NONE) {
+        printf("check image version failed(0x%x)\n\r", ret);
+        verify_error_handle();
+    }
+
+    td_u8 *pub_key = get_verify_pub_key();
+    ret = add_sec_info_to_bootargs(pub_key, img_header->version_ext);
+    if (ret != TD_SUCCESS) {
+        printf("add secure info failed(0x%x)\n\r", ret);
+        verify_error_handle();
+    }
+
+#if CONFIG_IS_ENABLED(CMD_TIMESTAMP)
+   timestamp_mark("verify data end", __LINE__);
+#endif
+
+    return 0;
+}
+U_BOOT_CMD(verify, CFG_VERIFY_MAXARGS, 0, do_verify_image,
+        "verify    - verify image"
+        "\t- verify <flash_offset> <ram_addr>",
+        "eg: verify 0x10000 0x42000000\n\rread from flash offset 0x10000 to ram 0x42000000 and verify image data");
+
