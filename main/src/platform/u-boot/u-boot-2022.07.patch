+    crypto_chk_return((val_length % CRYPTO_WORD_WIDTH) != 0, KM_COMPAT_ERRNO(ERROR_INVALID_PARAM),
+        "invalid val_length\n");
+
+    for (i = 0; i < val_length / CRYPTO_WORD_WIDTH; i++) {
+        kdf_val_word = km_reg_read(RKP_PBKDF2_VAL(i));
