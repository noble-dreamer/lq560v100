new file mode 100644
index 00000000..8a0f1d57
--- /dev/null
+++ b/board/vendor/lq560v100/partition.c
@@ -0,0 +1,120 @@
+/*
+ * Copyright (c) Oritek Technologies Co., Ltd. 2020-2023. All rights reserved.
+ */
+#include <config.h>
+#include <common.h>
+#include <hexdump.h>
+#include <asm/io.h>
+#include <asm/arch/platform.h>
+
+#include "partition.h"
+
+static void show_part(ot_partition_info_t *par)
+{
+	debug("{\n");
+	debug("\t name:%s\n", par->partition_name);
+	debug("\t flash_type:%s\n", par->flash_type);
+	debug("\t fs_type:%s\n", par->fs_type);
+	debug("\t start_addr:%llx\n", le64_to_cpu(par->start_addr));
+	debug("\t length:%llx\n", le64_to_cpu(par->length));
+	debug("}\n");
+}
+static int32_t do_unpack(ot_partition_bmp_info_t *bmp_info,
+			 ot_partition_info_t **part_info, uint32_t part_index,
+			 const int8_t *part_name,
+			 ot_partition_env_info_t **env_info)
+{
+	int32_t res = -1;
+	if (bmp_info) {
+		uint32_t offset = 0;
+		uint32_t bmp_sz = le32_to_cpu(bmp_info->bmp_info_size);
+		uint32_t block_sz = bmp_sz - sizeof(ot_partition_bmp_info_t);
+		uint32_t block_header_sz = sizeof(ot_partition_block_info_t);
+		ot_partition_block_info_t *block = NULL;
+		ot_partition_info_t *par = NULL;
+		uint32_t cur_part_idx = 0;
+		uint32_t part_sz = sizeof(ot_partition_info_t);
+		debug("bmp_sz:%d bmp_info:%p\n", bmp_sz, bmp_info);
+		for (offset = 0;
+		     (offset < block_sz) && (offset < OT_PARTITION_MAX_SIZE);
+		     offset += block_header_sz) {
+			block = (ot_partition_block_info_t
+					 *)((uint8_t *)&bmp_info->blocks[0] +
+					    offset);
+			debug("block:%p offset:%d block_type:%d \n", block,
+			      offset, block->block_type);
+			if (le32_to_cpu(block->block_type) ==
+			    OT_PARTITION_BLOCK) {
+				uint32_t par_offset = 0;
+				offset += block->block_size;
+				if (part_info == NULL) {
+					continue;
+				}
+				for (par_offset = 0;
+				     par_offset < block->block_size;
+				     par_offset += part_sz) {
+
+					par = (ot_partition_info_t
+						       *)((uint8_t *)block
+								  ->block_payload +
+							  par_offset);
+					if ((part_index == cur_part_idx) ||
+					    ((part_name != NULL) &&
+					     (0 ==
+					      strcmp(part_name,
+						     par->partition_name)))) {
+						*part_info = par;
+						res = 0;
+						show_part(par);
+						goto out;
+					}
+					cur_part_idx++;
+				}
+			}
+		}
+	}
+out:
+	return res;
+}
+
+/**
+ * @brief
+ *
+ * @param part_info
+ * @param part_wanted_index
+ * @return int32_t
+ */
+int32_t partition_get_partition_info_by_index(ot_partition_info_t **part_info,
+					      uint32_t part_wanted_index)
+{
+	int32_t res = -1;
+	ot_partition_bmp_info_t *bmp_info =
+		(ot_partition_bmp_info_t *)(u64)get_boot_param(BOOT_PARAM_PARTITION_ADDR);
+	if ((bmp_info != NULL) && (part_info != NULL)) {
+		return do_unpack(bmp_info, part_info, part_wanted_index, NULL,
+				 NULL);
+	}
+
+	return res;
+}
+
+/**
+ * @brief
+ *
+ * @param part_info
+ * @param part_name
+ * @return int32_t
+ */
+int32_t partition_get_partition_info_by_name(ot_partition_info_t **part_info,
+				     const int8_t *part_name)
+{
+	int32_t res = -1;
+	ot_partition_bmp_info_t *bmp_info =
+		(ot_partition_bmp_info_t *)(u64)get_boot_param(BOOT_PARAM_PARTITION_ADDR);
+	if ((bmp_info != NULL) && (part_info != NULL)) {
+		return do_unpack(bmp_info, part_info, UINT32_MAX, part_name,
+				 NULL);
+	}
+
+	return res;
+}
