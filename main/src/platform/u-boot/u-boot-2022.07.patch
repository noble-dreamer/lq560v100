+#define ddr_asm_dsb()                     { __asm__ __volatile__("fence"); }
+#elif (__LINUX_ARM_ARCH__ >= 8)
+#define ddr_asm_dsb() { \
+		__asm__ __volatile__("dsb sy"); \
+	}
+#else
+#define ddr_asm_dsb() { \
+		__asm__ __volatile__("dsb"); \
+	}
+#endif
+#endif
+
+#ifndef ddr_asm_nop
+#define ddr_asm_nop()                     { __asm__ __volatile__("nop"); }
