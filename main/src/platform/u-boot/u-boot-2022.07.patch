+    crypto_chk_return(ret != TD_SUCCESS, ret, "drv_cipher_pke_lock_secure failed, ret is 0x%x\n", ret);
+    ret = pke_ecdsa_sign(ecc_curve, priv_key, hash, sig);
+    (void)drv_cipher_pke_unlock_secure();
+    return ret;
