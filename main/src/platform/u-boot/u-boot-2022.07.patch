+#ifndef IMAGE_VERIFY_DEF_H_
+#define IMAGE_VERIFY_DEF_H_
+
+#define SM2_ID                    "1234567812345678"
+#define SM2_ID_LEN                0x10
+
+#define SHA_256_LEN               32
+#define SM3_HASH_LEN              32
+#define ECC_256_KEY_LENGTH        32
+#define ECC_SM2_KEY_LENGTH        32
+
+enum SB_ALGO_TYPE {
+    SB_ALOG_GM = 0,
+    SB_ALOG_NM,
+};
+
+#define PROTECT_KEY_LEN         16
+#define IV_LEN                  16
+#define SIG_LEN                 64
+#define HASH_LEN                32
+#define SIG_NUM                 2
+#define ECC_KEY_LEN             32
+
+#define KLAD_ROOTKEY_TYPE               KM_KLAD_KEY_TYPE_ABRK1
+#define KLAD_AES_SESSION_KEY_LEN        16
+#define KLAD_AES_CONTENT_KEY_LEN        16
+#define KLAD_SM4_SESSION_KEY_LEN        16
+#define KLAD_SM4_CONTENT_KEY_LEN        16
+
+#define IMAGE_MAGIC                     0x4AA4D33D
+/* Image encrypt flag */
+#define CODE_ENC_DISABLE                0x3C7896E1
+
+#pragma pack(4)
+typedef struct image_header {
+    unsigned int magic;          /* 4 */
+    unsigned int struct_version; /* 4 */
+    unsigned int struct_length;  /* 4 */
+    unsigned int signature_length;  /* 4 */
+    unsigned int version_ext;       /* 4 */
+    unsigned int mask_version_ext;  /* 4 */
+    unsigned int image_length;   /* 4 */
+    unsigned char code_hash[HASH_LEN];      /* 32 */
+    unsigned int code_enc_flag;  /* 4 */
+    unsigned char protectionkey_l1_enc[PROTECT_KEY_LEN]; /* 16 */
+    unsigned char protectionkey_l2_enc[PROTECT_KEY_LEN]; /*16 */
+    unsigned char iv[IV_LEN];               /* 16 */
+    unsigned char reserved[0x110];
+    unsigned char signature[SIG_LEN];       /* 64 */
+    unsigned char signature_ext[SIG_LEN];   /* 64 */
+} IMAGE_HEADER;
+#pragma pack()
+
+#define PUB_KEY_OFFSET                          CONFIG_SB_EXT_DAT_BASE
+#define OTP_REE_BOOT_VERSION_H                  0x1CC  /* 4bytes */
+#define OTP_REE_BOOT_VERSION_L                  0x1D0  /* 4bytes */
+#define IMAGE_VERIFY_ENABLE_REG_ADDR            0x101E8154
+#define IMAGE_VERIFY_ENABLE_REG_BIT             8
+#define IMAGE_VERIFY_ENABLE_REG_WIDTH           8
+#define IMAGE_VERIFY_DISABLE_VAL                0x42
+
+typedef enum {
+    SB_ERROR_NONE = 0,
+    SB_ERROR_DEV_READ = -100,
+    SB_ERROR_FORMAT_ERR,
+    SB_ERROR_OTP_ERR,
+    SB_ERROR_VERSION_ERR,
+} SB_ERROR_CODE;
+
+#endif /* IMAGE_VERIFY_DEF_H_ */
