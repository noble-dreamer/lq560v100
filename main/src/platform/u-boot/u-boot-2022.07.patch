+	fmc_pr(BT_DBG, "\t *-Start reset nand flash\n");
+
+	reg = fmc_cmd_cmd1(NAND_CMD_RESET);
+	fmc_write(host, FMC_CMD, reg);
+	fmc_pr(BT_DBG, "\t |-Set CMD[%#x]%#x\n", FMC_CMD, reg);
