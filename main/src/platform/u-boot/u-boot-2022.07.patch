+	writel(0x00000000, MVEBU_OMP_BASE + 0x1c);
+	writel(0x00000000, MVEBU_OMP_BASE + 0x20);
 
 	/* Configure GPIO */
 	writel(THEADORABLE_GPP_OUT_VAL_LOW, MVEBU_GPIO0_BASE + 0x00);
