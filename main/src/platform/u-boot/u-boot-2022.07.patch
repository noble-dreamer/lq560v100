+	reg = op_cfg_fm_cs(host->cmd_op.cs);
+	fmc_write(host, FMC_OP_CFG, reg);
+	fmc_pr(BT_DBG, "\t |-Set OP_CFG[%#x]%#x\n", FMC_OP_CFG, reg);
+
+	reg = fmc_op_cmd1_en(ENABLE) |
+			fmc_op_wait_ready_en(ENABLE) |
+			FMC_OP_REG_OP_START;
+	fmc_write(host, FMC_OP, reg);
