+{
+	int i;
+	unsigned int baudrate;
+	unsigned int uart0_clk_sel;
+	unsigned int uart0_ibrd;
+	unsigned int uart0_fbrd;
+
+	uart0_ibrd = readl(&regs->pl011_ibrd);
+	uart0_fbrd = readl(&regs->pl011_fbrd);
+	uart0_clk_sel = readl(REG_UART0_CRG) & UART_CLK_SEL_MASK;
+
+	for (i = 0; i < sizeof(baudinfo)/sizeof(baudinfo[0]); i++) {
+		if (((uart0_clk_sel & baudinfo[i].clksel) == baudinfo[i].clksel)
+				&& (uart0_ibrd == baudinfo[i].ibrd)
+				&& (uart0_fbrd == baudinfo[i].fbrd)) {
+			baudrate = baudinfo[i].baudrate;
+			break;
+		}
+	}
