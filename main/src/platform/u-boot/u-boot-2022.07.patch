+        ytphy_write_ext(phydev, 0x0062, 0x0000);
+        ytphy_write_ext(phydev, 0x9000, 0x0000);
+        ytphy_write_ext(phydev, 0x9031, 0xb200);
+        ytphy_write_ext(phydev, 0x9111, 0x5);
+        ytphy_write_ext(phydev, 0x9114, 0x3939);
