+#define FMC_OP_CTRL				0x68
+#define op_ctrl_rd_opcode(_code)		(((_code) & 0xff) << 16)
+#define op_ctrl_wr_opcode(_code)		(((_code) & 0xff) << 8)
+#define op_ctrl_rd_op_sel(_op)			(((_op) & 0x3) << 4)
+#define op_ctrl_dma_op(_type)			((_type) << 2)
