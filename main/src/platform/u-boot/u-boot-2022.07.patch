+    ret += gc2093_write_register(i2c_num, 0x014a, 0x0f);
+    ret += gc2093_write_register(i2c_num, 0x014b, 0x00);
+    ret += gc2093_write_register(i2c_num, 0x0155, 0x07);
+    ret += gc2093_write_register(i2c_num, 0x0414, 0x78);
+    ret += gc2093_write_register(i2c_num, 0x0415, 0x78);
+    ret += gc2093_write_register(i2c_num, 0x0416, 0x78);
+    ret += gc2093_write_register(i2c_num, 0x0417, 0x78);
+    ret += gc2093_write_register(i2c_num, 0x0454, 0x78);
+    ret += gc2093_write_register(i2c_num, 0x0455, 0x78);
+    ret += gc2093_write_register(i2c_num, 0x0456, 0x78);
+    ret += gc2093_write_register(i2c_num, 0x0457, 0x78);
+    ret += gc2093_write_register(i2c_num, 0x04e0, 0x18);
+    /* window */
+    ret += gc2093_write_register(i2c_num, 0x0192, 0x02);
+    ret += gc2093_write_register(i2c_num, 0x0194, 0x03);
+    ret += gc2093_write_register(i2c_num, 0x0195, 0x04);
+    ret += gc2093_write_register(i2c_num, 0x0196, 0x38);
+    ret += gc2093_write_register(i2c_num, 0x0197, 0x07);
+    ret += gc2093_write_register(i2c_num, 0x0198, 0x80);
+    /**** DVP & MIPI ****/
+    ret += gc2093_write_register(i2c_num, 0x019a, 0x06);
+    ret += gc2093_write_register(i2c_num, 0x007b, 0x2a);
+    ret += gc2093_write_register(i2c_num, 0x0023, 0x2d);
+    ret += gc2093_write_register(i2c_num, 0x0201, 0x27);
+    ret += gc2093_write_register(i2c_num, 0x0202, 0x56);
+    ret += gc2093_write_register(i2c_num, 0x0203, 0xce); // try 0xce or 0x8e
+    ret += gc2093_write_register(i2c_num, 0x0212, 0x80);
+    ret += gc2093_write_register(i2c_num, 0x0213, 0x07);
+    ret += gc2093_write_register(i2c_num, 0x0215, 0x10);
+    ret += gc2093_write_register(i2c_num, 0x003e, 0x91);
+    /**** HDR EN ****/
+    ret += gc2093_write_register(i2c_num, 0x0027, 0x71);
+    ret += gc2093_write_register(i2c_num, 0x0215, 0x92);
+    ret += gc2093_write_register(i2c_num, 0x024d, 0x01);
+    if (ret != 0) {
+        printf("gc2093 write register failed!\n");
+        return;
+    }
+    printf("\n== i2c_num:%d, gc2093 2M30fps(MIPI) 10bit vc-wdr 2to1 init success! ==\n", i2c_num);
+}
+
+void gc2093_sensor_init(unsigned char i2c_num, unsigned int sns_exp, unsigned int sns_again, unsigned int sns_dgain)
+{
+    gc2093_wdr2to1_2m30_10bit_init(i2c_num);
+}
diff --git a/product/quickboot_sensor/hal/sensor/hal_sensor.c b/product/quickboot_sensor/hal/sensor/hal_sensor.c
new file mode 100644
index 00000000..50a71e61
--- /dev/null
+++ b/product/quickboot_sensor/hal/sensor/hal_sensor.c
@@ -0,0 +1,236 @@
+/*
+ * Copyright (c) Oritek Technologies CO., Ltd. 2020-2023. All rights reserved.
+ */
+
+#include "hal_sensor.h"
+#include "hal_serdes.h"
+#include "hal_i2c.h"
+#include "sensor.h"
+#include "common.h"
+
+#define HAL_SENSOR_MAX_STR_LEN 64
+#define HAL_SENSOR_CLK_UNSED
+
+#define IOMUX1_REG_BASE 0x10260000
+#define IOMUX2_REG_BASE 0x179F0000
+#define IOMUX3_REG_BASE 0x0EFF0000
+#define IOMUX4_REG_BASE 0x11120200
+#define GPIO_REG_BASE   0x11090000
+
+static void i2c1_pin_mux(void)
+{
+    void *iocfg4_base = (void *)IOMUX4_REG_BASE;
+    writel(0x1302, (volatile void*)(unsigned long int)(iocfg4_base + 0x0010)); /* I2C1_SDA */
+    writel(0x1102, (volatile void*)(unsigned long int)(iocfg4_base + 0x0018)); /* I2C1_SCL */
+}
+
+static void i2c2_pin_mux(void)
+{
+    void *iocfg1_base = (void *)IOMUX1_REG_BASE;
+    writel(0x1105, (volatile void*)(unsigned long int)(iocfg1_base + 0x0008)); /* I2C2_SDA */
+    writel(0x1105, (volatile void*)(unsigned long int)(iocfg1_base + 0x000C)); /* I2C2_SCL */
+}
+
+static void i2c5_pin_mux(void)
+{
+    void *iocfg3_base = (void *)IOMUX3_REG_BASE;
+    writel(0x1752, (volatile void*)(unsigned long int)(iocfg3_base + 0x0028)); /* I2C5_SDA */
+    writel(0x1752, (volatile void*)(unsigned long int)(iocfg3_base + 0x0024)); /* I2C5_SCL */
+}
+
+static void i2c6_pin_mux(void)
+{
+    void *iocfg3_base = (void *)IOMUX3_REG_BASE;
+    writel(0x1752, (volatile void*)(unsigned long int)(iocfg3_base + 0x0030)); /* I2C6_SDA */
+    writel(0x1752, (volatile void*)(unsigned long int)(iocfg3_base + 0x002C)); /* I2C6_SCL */
+}
+
+static void hal_sensor_i2c_x_pin_mux(void)
+{
+    if (get_boot_media() == BOOT_MEDIA_EMMC) {
+        i2c1_pin_mux();
+        i2c2_pin_mux();
+    } else if ((get_boot_media() == BOOT_MEDIA_NAND) || (get_boot_media() == BOOT_MEDIA_SPIFLASH)) {
+        i2c5_pin_mux();
+        i2c6_pin_mux();
+    } else {
+        return;
+    }
+}
+
+static void sensor0_pin_mux(void)
+{
+    void *iocfg2_base = (void *)IOMUX2_REG_BASE;
+
+    writel(0x1100, (volatile void*)(unsigned long int)(iocfg2_base + 0x0044)); /* SENSOR0_RESET, GPIO12_0 */
+    writel(readl((volatile void*)(unsigned long int)(0x1109C400)) | 0x1, (volatile void*)(unsigned long int)(0x1109C400));
+    writel(readl((volatile void*)(unsigned long int)(0x1109C3FC)) | 0x1, (volatile void*)(unsigned long int)(0x1109C3FC));
+}
+
+static void sensor1_pin_mux(void)
+{
+    void *iocfg3_base = (void *)IOMUX3_REG_BASE;
+#ifndef HAL_SENSOR_CLK_UNSED
+    writel(0x1371, (volatile void*)(unsigned long int)(iocfg3_base + 0x0004)); /* SENSOR1_CLK */
+#endif
+    writel(0x1601, (volatile void*)(unsigned long int)(iocfg3_base + 0x0008)); /* SENSOR1_RSTN */
+}
+
+static void sensor_x_pin_mux(void)
+{
+    sensor0_pin_mux();
+    sensor1_pin_mux();
+}
+
+static void hal_sensor_pin_mux(void)
+{
+    hal_sensor_i2c_x_pin_mux();
+    sensor_x_pin_mux();
+}
+
+static void hal_sensor_clk_config(void)
+{
+    if (get_boot_media() == BOOT_MEDIA_EMMC) {
+        writel(0x1010, (volatile void*)(unsigned long int)0x11014288); /* i2c 1 clk setup */
+        writel(0x1010, (volatile void*)(unsigned long int)0x11014290); /* i2c 2 clk setup */
+    } else if ((get_boot_media() == BOOT_MEDIA_NAND) || (get_boot_media() == BOOT_MEDIA_SPIFLASH)) {
+        writel(0x1010, (volatile void*)(unsigned long int)0x110142A8); /* i2c 5 clk setup */
+        writel(0x1010, (volatile void*)(unsigned long int)0x110142B0); /* i2c 6 clk setup */
+    } else {
+        return;
+    }
+
+    writel(0x4010, (volatile void*)(unsigned long int)0x11018440); /* sensor 0 cancel soft reset, setup clk 24MHz */
+    writel(0x4010, (volatile void*)(unsigned long int)0x11018460); /* sensor 1 cancel soft reset, setup clk 24MHz */
+}
+
+static void gpio_pin_ctrl(void)
+{
+    unsigned long int val;
+    void *gpio_base   = (void *)GPIO_REG_BASE;
+    void *iocfg1_base = (void *)IOMUX1_REG_BASE;
+
+    writel(0x1100, (volatile void*)(unsigned long int)(iocfg1_base + 0x00d8)); /* GPIO8_3, MAX2008X POC */
+
+    val = readl((volatile void*)(unsigned long int)(gpio_base + 0x8400)); // GPIO8_3 dir
+    writel(val | 0x08, (volatile void*)(unsigned long int)(gpio_base + 0x8400));
+    val = readl((volatile void*)(unsigned long int)(gpio_base + 0x83fc)); // GPIO8_3 output 1
+    writel(val | 0x08, (volatile void*)(unsigned long int)(gpio_base + 0x83fc));
+}
+
+static void hal_sensor_pin_config(void)
+{
+    int ret = 0;
+    hal_sensor_pin_mux();
+    hal_sensor_clk_config();
+    gpio_pin_ctrl();
+
+    if (get_boot_media() == BOOT_MEDIA_EMMC) {
+        ret  = hal_i2c_init(HAL_I2C_BUS2);
+        ret |= hal_i2c_init(HAL_I2C_BUS1);
+    } else if ((get_boot_media() == BOOT_MEDIA_NAND) || (get_boot_media() == BOOT_MEDIA_SPIFLASH)) {
+        ret  = hal_i2c_init(HAL_I2C_BUS6);
+        ret |= hal_i2c_init(HAL_I2C_BUS5);
+    } else {
+        return;
+    }
+    if (ret < 0) {
+        printf("[error] hal_i2c_init error ret=%d\n", ret);
+    }
+}
+
+static sns_func hal_get_sns_init_func(hal_sensor_type sns_type)
+{
+    sns_func func;
+    switch (sns_type) {
+        case SENSOR_TYPE_IMX623: func = imx623_sensor_init; break;
+        case SENSOR_TYPE_IMX290: func = imx290_sensor_init; break;
+        case SENSOR_TYPE_GC2093: func = gc2093_sensor_init; break;
+        default: func = NULL;
+    }
+    return func;
+}
+
+static void hal_get_serdes_attr(hal_serdes_attr *attr)
+{
+    attr->serdes_type = SERDES_TYPE;
+    switch (attr->serdes_type) {
+        case SERDES_TYPE_MAX9295_MAX9296_ONE_MIPI_ONE_PORT:
+            attr->serdes_num = 1;
+            attr->sns_num = 1;
+
+            attr->sns_type[0] = SENSOR0_TYPE;
+            attr->i2c_num[0] = (get_boot_media() == BOOT_MEDIA_EMMC) ? HAL_I2C_BUS2 : HAL_I2C_BUS6;
+            attr->sns_init_func[0] = hal_get_sns_init_func(SENSOR0_TYPE);
+            break;
+        case SERDES_TYPE_MAX9295_MAX9296_ONE_MIPI_TWO_PORT:
+            attr->serdes_num = 1;
+            attr->sns_num = 2;
+
+            attr->sns_type[0] = SENSOR0_TYPE;
+            attr->i2c_num[0] = (get_boot_media() == BOOT_MEDIA_EMMC) ? HAL_I2C_BUS2 : HAL_I2C_BUS6;
+            attr->sns_init_func[0] = hal_get_sns_init_func(SENSOR0_TYPE);
+
+            attr->sns_type[1] = SENSOR1_TYPE;
+            attr->i2c_num[1] = HAL_I2C_BUS2;
+            attr->i2c_num[1] = (get_boot_media() == BOOT_MEDIA_EMMC) ? HAL_I2C_BUS2 : HAL_I2C_BUS6;
+            attr->sns_init_func[1] = hal_get_sns_init_func(SENSOR1_TYPE);
+            break;
+        case SERDES_TYPE_MAX9295_MAX9296_TWO_MIPI_TWO_PORT:
+            attr->serdes_num = 2;
+            attr->sns_num = 2;
+
+            attr->sns_type[0] = SENSOR0_TYPE;
+            attr->i2c_num[0] = (get_boot_media() == BOOT_MEDIA_EMMC) ? HAL_I2C_BUS2 : HAL_I2C_BUS6;
+            attr->sns_init_func[0] = hal_get_sns_init_func(SENSOR0_TYPE);
+
+            attr->sns_type[1] = SENSOR1_TYPE;
+            attr->i2c_num[1] = (get_boot_media() == BOOT_MEDIA_EMMC) ? HAL_I2C_BUS1 : HAL_I2C_BUS5;
+            attr->sns_init_func[1] = hal_get_sns_init_func(SENSOR1_TYPE);
+            break;
+        default:
+            printf("Invalud serdes type %d\n", attr->serdes_type);
+            return;
+    }
+}
+
+static void hal_init_sensor(const sensor_cfg *cfg, const hal_serdes_attr *attr)
+{
+    unsigned int sns_exp = cfg->cfg.light_convergence_cfg.sns_exp;
+    unsigned int sns_again = cfg->cfg.light_convergence_cfg.sns_again;
+    unsigned int sns_dgain = cfg->cfg.light_convergence_cfg.sns_dgain;
+
+    for (int i = 0; i < attr->sns_num; i++) {
+        if (attr->sns_init_func[i]) {
+            attr->sns_init_func[i](attr->i2c_num[i], sns_exp, sns_again, sns_dgain);
+        } else {
+            printf("i2c%d sensor init func is null.\n", attr->i2c_num[i]);
+        }
+    }
+}
+
+void hal_sensor_preinit(void)
+{
+    hal_serdes_attr serdes_attr;
+    hal_get_serdes_attr(&serdes_attr);
+    hal_sensor_pin_config();
+    hal_serdes_preinit(&serdes_attr);
+}
+
+void hal_sensor_init(const sensor_cfg *cfg)
+{
+    if (cfg == NULL) {
+        printf("[error] cfg pointer is null.\n");
+        return;
+    }
+
+    if (cfg->convergence_mode != SENSOR_CONVERGENCE_LIGHT_SENSOR) {
+        printf("[error] only support calibration convergence now.\n");
+        return;
+    }
+
+    hal_serdes_attr serdes_attr;
+    hal_get_serdes_attr(&serdes_attr);
+    hal_serdes_init(&serdes_attr);
+    hal_init_sensor(cfg, &serdes_attr);
+}
diff --git a/product/quickboot_sensor/hal/sensor/hal_sensor.h b/product/quickboot_sensor/hal/sensor/hal_sensor.h
new file mode 100644
index 00000000..76d8737e
--- /dev/null
+++ b/product/quickboot_sensor/hal/sensor/hal_sensor.h
@@ -0,0 +1,74 @@
+/*
+ * Copyright (c) Oritek Technologies CO., Ltd. 2020-2023. All rights reserved.
+ */
+
+#ifndef HAL_SENSOR_H
+#define HAL_SENSOR_H
+
+#include <asm/io.h>
+#include <linux/delay.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif /* End of #ifdef __cplusplus */
+
+/*
+* there are two sensor convergence modes for quick start now:
+* light sensor: user should get current illumination intensity by light sensor
+*               and lookup calibration table, then input init value and sensor
+*               will keep converging from those values.
+*               lightsensor is required.
+* image sensor: sensor will converge by image info without any init value. For
+*               this mode. lightsensor is not required.
+*
+* note: only convergence by light sensor is supported now.
+*/
+typedef enum {
+    SENSOR_CONVERGENCE_LIGHT_SENSOR = 0,
+    SENSOR_CONVERGENCE_IMAGE_SENSOR,
+    SENSOR_CONVERGENCE_BUTT,
+} sensor_convergence_mode;
+
+/* light sensor convergence cfg */
+typedef struct {
+    unsigned int sns_exp;
+    unsigned int sns_again;
+    unsigned int sns_dgain;
+} sensor_light_convergence_cfg;
+
+/* image sensor convergence cfg */
+typedef struct {
+    float frame_rate;
+} sensor_image_convergence_cfg;
+
+typedef struct {
+    sensor_convergence_mode convergence_mode;
+    union {
+        sensor_light_convergence_cfg light_convergence_cfg;
+        sensor_image_convergence_cfg image_convergence_cfg;
+    } cfg;
+} sensor_cfg;
+
+typedef enum {
+    SENSOR_TYPE_OS08A20,
+    SENSOR_TYPE_IMX623,
+    SENSOR_TYPE_IMX290,
+    SENSOR_TYPE_GC2093,
+} hal_sensor_type;
+
+#define SENSOR_MAX_NUM  4
+#define HAL_I2C_BUS1    1
+#define HAL_I2C_BUS2    2
+#define HAL_I2C_BUS5    5
+#define HAL_I2C_BUS6    6
+
+void hal_sensor_preinit(void);
+void hal_sensor_init(const sensor_cfg *cfg);
+
+#define sns_log_error(fmt, ...) printf("Err[%s-%d] " fmt, __FUNCTION__, __LINE__, ##__VA_ARGS__)
+
+#ifdef __cplusplus
+}
+#endif /* End of #ifdef __cplusplus */
+
+#endif /* End of #ifndef HAL_SENSOR_H */
diff --git a/product/quickboot_sensor/hal/sensor/hal_serdes.c b/product/quickboot_sensor/hal/sensor/hal_serdes.c
new file mode 100644
index 00000000..29b8a6b2
--- /dev/null
+++ b/product/quickboot_sensor/hal/sensor/hal_serdes.c
@@ -0,0 +1,382 @@
+/*
+ * Copyright (c) Oritek Technologies CO., Ltd. 2020-2023. All rights reserved.
+ */
+
+#include <asm/io.h>
+#include "hal_serdes.h"
+#include "hal_i2c.h"
+
+#define MAX9295_I2C_ADDR    0x80
+#define MAX9296_I2C_ADDR    0x90
+#define IMX623_I2C_ADDR     0x34
+#define SERDES_ADDR_BYTE    2
+#define SERDES_DETECT_CNT   200
+
+typedef enum {
+    SERDES_PORT_0,
+    SERDES_PORT_1,
+    SERDES_PORT_INVALID,
+} serdes_port;
+
+typedef enum {
+    SERDES_PIPE_X,
+    SERDES_PIPE_Y,
+    SERDES_PIPE_Z,
+    SERDES_PIPE_U,
+    SERDES_PIPE_INVALID,
+} serdes_pipe;
+
+#define serdes_i2c_write(i2c_num, i2c_addr, addr, data)    \
+    hal_i2c_write_byte(i2c_num, i2c_addr, addr, SERDES_ADDR_BYTE, data)
+
+#define serdes_i2c_read(i2c_num, i2c_addr, addr, data)    \
+    hal_i2c_read_byte(i2c_num, i2c_addr, addr, SERDES_ADDR_BYTE, data)
+
+#define MAX9295_CHG_ADDR(port)      (MAX9295_I2C_ADDR + 2 * (port + 1))
+#define IMX623_CHG_ADDR(port)       (IMX623_I2C_ADDR + 2 * (port + 1))
+
+static bool max9296_check_is_exist(unsigned char i2c_num, unsigned char dev_addr)
+{
+    int cnt;
+
+    for (cnt = SERDES_DETECT_CNT; cnt >= 0; cnt--) {
+        unsigned char data = 0x00;
+        serdes_i2c_read(i2c_num, dev_addr, 0x00, &data);
+        if (data == dev_addr) {
+            return true;
+        }
+        mdelay(1);
+    }
+    return false;
+}
+
+static bool max9295_check_is_exist(unsigned char i2c_num, unsigned char dev_addr)
+{
+    int cnt;
+
+    for (cnt = SERDES_DETECT_CNT; cnt >= 0; cnt--) {
+        unsigned char data = 0x00;
+        serdes_i2c_read(i2c_num, dev_addr, 0x00, &data);
+        if (data == dev_addr) {
+            return true;
+        }
+        mdelay(1);
+    }
+    return false;
+}
+
+static bool max9295_check_and_change_addr(unsigned char i2c_num, unsigned char src_addr, unsigned char dst_addr)
+{
+    int cnt;
+
+    // avoid reboot serdes init failed
+    for (cnt = SERDES_DETECT_CNT; cnt >= 0; cnt--) {
+        unsigned char data = 0x00;
+        serdes_i2c_read(i2c_num, src_addr, 0x00, &data);
+        if (data == src_addr) {
+            serdes_i2c_write(i2c_num, src_addr, 0x0000, dst_addr); // change i2c addr
+            return true;
+        }
+        serdes_i2c_read(i2c_num, dst_addr, 0x00, &data);
+        if (data == dst_addr) {
+            return true;
+        }
+        mdelay(1);
+    }
+    return false;
+}
+
+static int max9295_linear_two_sns_cfg(unsigned char i2c_num,
+    serdes_port serdes_port, unsigned char data_type, hal_sensor_type sns_type)
+{
+    unsigned char tmp;
+    unsigned char serial_dst_addr = MAX9295_CHG_ADDR(serdes_port);
+
+    if (max9295_check_and_change_addr(i2c_num, MAX9295_I2C_ADDR, serial_dst_addr) == false) {
+        sns_log_error("check MAX9295 0x%02X & 0x%02X error.\n", MAX9295_I2C_ADDR, serial_dst_addr);
+        return -1;
+    }
+
+    if (max9295_check_is_exist(i2c_num, serial_dst_addr) == false) {
+        sns_log_error("check MAX9295 0x%02X error.\n", serial_dst_addr);
+        return -1;
+    }
+    serdes_i2c_write(i2c_num, serial_dst_addr, 0x02BE, 0x10); // GPIO0 1, sensor unreset
+
+    // config source id
+    tmp = (serdes_port == SERDES_PORT_0) ? 0x41 : 0x42;
+    serdes_i2c_write(i2c_num, serial_dst_addr, 0x007B, tmp);
+    serdes_i2c_write(i2c_num, serial_dst_addr, 0x0083, tmp);
+    serdes_i2c_write(i2c_num, serial_dst_addr, 0x008B, tmp);
+    serdes_i2c_write(i2c_num, serial_dst_addr, 0x0093, tmp);
+    serdes_i2c_write(i2c_num, serial_dst_addr, 0x00A3, tmp);
+    serdes_i2c_write(i2c_num, serial_dst_addr, 0x00AB, tmp);
+
+    // reset sensor i2c addr
+    if (sns_type == SENSOR_TYPE_IMX623) {
+        serdes_i2c_write(i2c_num, serial_dst_addr, 0x0042, IMX623_CHG_ADDR(serdes_port));
+        serdes_i2c_write(i2c_num, serial_dst_addr, 0x0043, IMX623_I2C_ADDR);
+    }
+
+    // set PipeZ stream ID
+    tmp = (serdes_port == SERDES_PORT_0) ? 0x11 : 0x12;
+    serdes_i2c_write(i2c_num, serial_dst_addr, 0x005B, tmp);
+
+    serdes_i2c_write(i2c_num, serial_dst_addr, 0x0002, 0x43); // enable PipeZ
+    serdes_i2c_write(i2c_num, serial_dst_addr, 0x0318, 0x40 | data_type); // data type
+    serdes_i2c_write(i2c_num, serial_dst_addr, 0x0331, 0x33); // lane nums
+
+    serdes_i2c_write(i2c_num, serial_dst_addr, 0x0383, 0x00);
+    serdes_i2c_write(i2c_num, serial_dst_addr, 0x0003, 0x03);
+    serdes_i2c_write(i2c_num, serial_dst_addr, 0x0006, 0xb0);
+    serdes_i2c_write(i2c_num, serial_dst_addr, 0x03f0, 0x59);
+    serdes_i2c_write(i2c_num, serial_dst_addr, 0x0570, 0x0c);
+    return 0;
+}
+
+static void max9296_pipe_remap(unsigned char i2c_num,
+    serdes_pipe pipe, unsigned char src_vc, unsigned char dst_vc, unsigned char data_type)
+{
+    int ret = 0;
+    unsigned short addr_offset = 0x40 * pipe;
+
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x040B + addr_offset, 0x07);
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x040C + addr_offset, 0x00);
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x040D + addr_offset, (src_vc << 6) | data_type); // MAP DT
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x040E + addr_offset, (dst_vc << 6) | data_type);
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x040F + addr_offset, (src_vc << 6) | 0x00); // MAP FS
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0410 + addr_offset, (dst_vc << 6) | 0x00);
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0411 + addr_offset, (src_vc << 6) | 0x01); // MAP FE
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0412 + addr_offset, (dst_vc << 6) | 0x01);
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x042D + addr_offset, 0x15); // Map PHY B
+}
+
+static int serdes_max9295_max9296_linear_two_sns_preinit(unsigned char i2c_num, hal_sensor_type sns_type)
+{
+    int ret = 0;
+
+    if (max9296_check_is_exist(i2c_num, MAX9296_I2C_ADDR) == false) {
+        sns_log_error("check MAX9296 0x%02X error.\n", MAX9296_I2C_ADDR);
+        return -1;
+    }
+
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0313, 0x00); // disable mipi output
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0001, 0x02); // 6Gbps
+    return ret;
+}
+
+static int serdes_max9295_max9296_linear_two_sns_init(unsigned char i2c_num, hal_sensor_type sns_type)
+{
+    int i;
+    int ret = 0;
+    unsigned char data_type = 0x2e;
+
+    for (i = 0; i < SERDES_PORT_INVALID; i++) {
+        ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0010, 0x21 + i); // link port
+
+        ret |= max9295_linear_two_sns_cfg(i2c_num, i, data_type, sns_type);
+        if (ret != 0) {
+            sns_log_error("MAX9295 port%d config failed.\n", i);
+            return ret;
+        }
+    }
+
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0010, 0x23); // link port0 & port1
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0050, 0x01); // PipeX stream ID 1
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0051, 0x02); // PipeY stream ID 2
+
+    // PipeX VC0 -> PHY B vc_id 0
+    max9296_pipe_remap(i2c_num, SERDES_PIPE_X, 0, 0, data_type); // map vc0
+
+    // PipeY VC0 -> PHY B vc_id 1
+    max9296_pipe_remap(i2c_num, SERDES_PIPE_Y, 0, 1, data_type); // map vc1
+
+	ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x1D00, 0xF4); // PHY1 reset
+	ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0320, 0x34); // 2.0Gbsp/lane
+	ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x1D00, 0xF5);
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0331, 0x36);
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0332, 0xb4); // Turn on PHY0 and PHY1
+    if ((i2c_num == HAL_I2C_BUS6) || (i2c_num == HAL_I2C_BUS2)) {
+        ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0333, 0xB4); // set lane mapping
+        ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0335, 0x3F); // set lane polarity
+    }
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x044A, 0xD0); // 0xD0 - 4lane, 0x50 - 2lane
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0002, 0x33); // enable PipeX & PipeY
+
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0313, 0x02); // enable mipi output
+    return 0;
+}
+
+static int serdes_max9295_max9296_wdr_vc_2to1_preinit(unsigned char i2c_num, hal_sensor_type sns_type)
+{
+    int ret = 0;
+    unsigned char data_type = 0x2B;
+
+    if (max9296_check_is_exist(i2c_num, MAX9296_I2C_ADDR) == false) {
+        sns_log_error("check MAX9296 0x%02X error.\n", MAX9296_I2C_ADDR);
+        return -1;
+    }
+
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0001, 0x02); // 6G
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0313, 0x00); // (CSI_OUT_EN): CSI output disabled
+    // Video Pipes And Routing Configuration
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0050, 0x01); // (STR_SELX): 0x1
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0051, 0x02); // (STR_SELY): 0x2
+
+    // Pipe to Controller Mapping Configuration
+    max9296_pipe_remap(i2c_num, SERDES_PIPE_X, 0, 0, data_type);
+    max9296_pipe_remap(i2c_num, SERDES_PIPE_Y, 1, 1, data_type);
+
+    // Double Mode Configuration
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0473, 0x04); // (ALT_MEM_MAP10 CTRL1): Alternate memory map enabled
+    // MIPI DPHY Configuratio
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0330, 0x04); // (Default)  (Port Configuration): 2 (1x4)
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x044A, 0xD0); // (Default)  (Port A - Lane Count): 4
+    if (i2c_num == 6) {
+        ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0333, 0xB4); /* set lane mapping */
+        ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0335, 0x3F); /* set lane polarity */
+    }
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x1D00, 0xF4); // (config_soft_rst_n - PHY1): 0x0
+    // This is to set predefined (coarse) CSI output frequency
+    // CSI Phy 1 is 1500 Mbps/lane.
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0320, 0x26); // (Default)
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x1D00, 0xF5); // (config_soft_rst_n - PHY1): 0x1
+    // PHY Copy Configuration
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0313, 0x02); // (CSI_OUT_EN): CSI output enabled
+    // Video Transmit Configuration for Serializer(s)
+    return ret;
+}
+
+static int serdes_max9295_max9296_wdr_vc_2to1_init(unsigned char i2c_num, hal_sensor_type sns_type)
+{
+    int ret = 0;
+    unsigned char data_type = 0x2B;
+
+    if (max9295_check_is_exist(i2c_num, MAX9295_I2C_ADDR) == false) {
+        sns_log_error("check MAX9295 0x%02X error.\n", MAX9295_I2C_ADDR);
+        return -1;
+    }
+
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x02BE, 0x10); /* GPIO0 output 1 */
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x0331, 0x13); // (Port B - Lane Count): 2
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x0002, 0x33); // (VID_TX_EN_X): Enabled |  (VID_TX_EN_Y): Enabled
+    // Controller to Pipe Mapping Configuration
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x0308, 0x7F); // (CLK_SELX): Port B |  (CLK_SELY): Port B | (Default)  (START_PORTB): Enabled
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x0309, 0x01); // (VS_VC1_L): 0x1
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x030B, 0x02); // (VS_VC2_L): 0x2
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x0311, 0x35); // Start Video
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x0314, 0x40 + data_type); // (mem_dt1_selx): 0x6B
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x0316, 0x40 + data_type); // (mem_dt1_sely): 0x6B
+    // Double Mode Configuration
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x0313, 0x01); // (bpp10dblx): Send 10-bit pixels as 20-bit
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x031C, 0x34); // (soft_bppx): 0x14 |  (soft_bppx_en): Software override enabled
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x0313, 0x03); // (bpp10dbly): Send 10-bit pixels as 20-bit
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x031D, 0x34); // (soft_bppy): 0x14 |  (soft_bppy_en): Software override enabled
+    // Pipe Configuration
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x0053, 0x11); // (TX_STR_SEL Pipe X): 0x1
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x0057, 0x12); // (TX_STR_SEL Pipe Y): 0x2
+    return ret;
+}
+
+static int serdes_max9295_max9296_default_preinit(unsigned char i2c_num, hal_sensor_type sns_type)
+{
+    int ret = 0;
+
+    if (max9296_check_is_exist(i2c_num, MAX9296_I2C_ADDR) == false) {
+        sns_log_error("check MAX9296 0x%02X error.\n", MAX9296_I2C_ADDR);
+        return -1;
+    }
+
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0313, 0x00); /* disable mipi output */
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0001, 0x02); /* 6Gbps */
+
+	ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x1D00, 0xF4); /* PHY1 reset */
+	ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0320, 0x2C); /* 0xC * 100Mhz */
+	ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x1D00, 0xF5);
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0332, 0x30); /* Turn on PHY0 and PHY1 */
+    if ((i2c_num == HAL_I2C_BUS6) || (i2c_num == HAL_I2C_BUS2)) {
+        ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0333, 0xB4); /* set lane mapping */
+        ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0335, 0x3F); /* set lane polarity */
+    }
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x044A, 0xD0); /* 0xD0 - 4lane, 0x50 - 2lane */
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0051, 0x02); /* swap pipeline Y/Z */
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0052, 0x01);
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0002, 0x23); /* enable pipeline Y */
+    if (ret < 0) {
+        sns_log_error("serdes preinit write error!\n");
+    }
+    return ret;
+}
+
+static int serdes_max9295_max9296_default_init(unsigned char i2c_num, hal_sensor_type sns_type)
+{
+    int ret = 0;
+
+    if (max9295_check_is_exist(i2c_num, MAX9295_I2C_ADDR) == false) {
+        sns_log_error("check MAX9295 0x%02X error.\n", MAX9295_I2C_ADDR);
+        return -1;
+    }
+
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x02BE, 0x10); /* GPIO0 output 1 */
+
+    /* data type, raw16 - 0x2e, raw12 - 0x2c, raw10 - 0x2b */
+    if (sns_type == SENSOR_TYPE_IMX290) {
+        ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x0318, 0x6B);
+    } else {
+        ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x0318, 0x6E);
+    }
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x0383, 0x00);
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x0003, 0x03);
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x0006, 0xb0);
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x03f0, 0x59);
+    ret |= serdes_i2c_write(i2c_num, MAX9295_I2C_ADDR, 0x0570, 0x0c);
+    ret |= serdes_i2c_write(i2c_num, MAX9296_I2C_ADDR, 0x0313, 0x02); /* enable mipi output */
+    if (ret < 0) {
+        sns_log_error("serdes init write error!\n");
+    }
+    return ret;
+}
+
+int hal_serdes_preinit(const hal_serdes_attr *serdes_attr)
+{
+    int i;
+    int ret = 0;
+
+    if ((serdes_attr->serdes_type == SERDES_TYPE_MAX9295_MAX9296_ONE_MIPI_ONE_PORT) ||
+        (serdes_attr->serdes_type == SERDES_TYPE_MAX9295_MAX9296_TWO_MIPI_TWO_PORT)) {
+        for (i = 0; i < serdes_attr->serdes_num; i++) {
+            if (serdes_attr->sns_type[i] == SENSOR_TYPE_GC2093) {
+                ret = serdes_max9295_max9296_wdr_vc_2to1_preinit(serdes_attr->i2c_num[i], serdes_attr->sns_type[i]);
+            } else {
+                ret = serdes_max9295_max9296_default_preinit(serdes_attr->i2c_num[i], serdes_attr->sns_type[i]);
+            }
+        }
+    } else if (serdes_attr->serdes_type == SERDES_TYPE_MAX9295_MAX9296_ONE_MIPI_TWO_PORT) {
+        if (serdes_attr->serdes_num == 1) {
+            ret = serdes_max9295_max9296_linear_two_sns_preinit(serdes_attr->i2c_num[0], serdes_attr->sns_type[0]);
+        }
+    }
+    return ret;
+}
+
+int hal_serdes_init(const hal_serdes_attr *serdes_attr)
+{
+    int i;
+    int ret = 0;
+
+    if ((serdes_attr->serdes_type == SERDES_TYPE_MAX9295_MAX9296_ONE_MIPI_ONE_PORT) ||
+        (serdes_attr->serdes_type == SERDES_TYPE_MAX9295_MAX9296_TWO_MIPI_TWO_PORT)) {
+        for (i = 0; i < serdes_attr->serdes_num; i++) {
+            if (serdes_attr->sns_type[i] == SENSOR_TYPE_GC2093) {
+                ret = serdes_max9295_max9296_wdr_vc_2to1_init(serdes_attr->i2c_num[i], serdes_attr->sns_type[i]);
+            } else {
+                ret = serdes_max9295_max9296_default_init(serdes_attr->i2c_num[i], serdes_attr->sns_type[i]);
+            }
+        }
+    } else if (serdes_attr->serdes_type == SERDES_TYPE_MAX9295_MAX9296_ONE_MIPI_TWO_PORT) {
+        if (serdes_attr->serdes_num == 1) {
+            ret = serdes_max9295_max9296_linear_two_sns_init(serdes_attr->i2c_num[0], serdes_attr->sns_type[0]);
+        }
+    }
+    return ret;
+}
