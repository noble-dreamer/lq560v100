+char *ultohstr(unsigned long long size)
+{
+	int ix;
+	static char buffer[20];
+	char *fmt[] = {
+		"%u", "%uK", "%uM", "%uG", "%uT", "%uT"};
+	for (ix = 0; (ix < 5) && !(size & 0x3FF) && size; ix++) {
+		size = (size >> 10);
+	}
+	int count = sprintf_s(buffer, sizeof(buffer), fmt[ix], size);
+	if (count < 0) {
+		printf("\nultohstr fail for buffer overflow\n");
+		return NULL;
+	}
+
+	return buffer;
+}
