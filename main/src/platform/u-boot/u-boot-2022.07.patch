+    hal_pke_get_ram(PKE_MRAM, c->data, klen);
+    return TD_SUCCESS;
+}
+
+static td_s32 drv_cipher_pke_mod_param_chk(const drv_pke_data *a, const drv_pke_data *p, const drv_pke_data *c)
+{
