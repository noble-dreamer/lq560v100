@@ -0,0 +1,67 @@
+/*
+ * Copyright (c) Oritek Technologies CO., Ltd. 2020-2023. All rights reserved.
+ */
+
+#include "quickboot_sensor.h"
+#include <common.h>
+#include "hal_sensor.h"
+
+#if CONFIG_IS_ENABLED(CMD_TIMESTAMP)
+#include "cmd_timestamp.h"
+#endif
+
+int quickboot_sensor_preinit(void)
+{
+#if CONFIG_IS_ENABLED(CMD_TIMESTAMP)
+    timestamp_mark("quickboot_sensor_preinit_start", __LINE__);
+#endif
+
+    hal_sensor_preinit();
+
+#if CONFIG_IS_ENABLED(CMD_TIMESTAMP)
+    timestamp_mark("quickboot_sensor_preinit_end", __LINE__);
+#endif
+    return 0;
+}
+
+int quickboot_sensor_init(void)
+{
+#if CONFIG_IS_ENABLED(CMD_TIMESTAMP)
+    timestamp_mark("quickboot_sensor_init_start", __LINE__);
+#endif
+
+    sensor_cfg sensor_cfg = {0};
+    sensor_cfg.convergence_mode = SENSOR_CONVERGENCE_LIGHT_SENSOR;
+    sensor_cfg.cfg.light_convergence_cfg.sns_exp = 0;
+    sensor_cfg.cfg.light_convergence_cfg.sns_again = 0;
+    sensor_cfg.cfg.light_convergence_cfg.sns_dgain = 0;
+    hal_sensor_init(&sensor_cfg);
+
+#if CONFIG_IS_ENABLED(CMD_TIMESTAMP)
+    timestamp_mark("quickboot_sensor_init_end", __LINE__);
+#endif
+    return 0;
+}
+
+#define CFG_MAXARGS_SENSOR 2
+static int do_sensor_cfg(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+    static unsigned char init_flag = 0;
+    if (argc != CFG_MAXARGS_SENSOR) {
+        printf("usage:\n%s\n", cmdtp->usage);
+        return -1;
+    }
+    if (strcmp(argv[1], "preinit") == 0 && init_flag == 0) {
+        quickboot_sensor_preinit();
+        init_flag = 1;
+    } else if (strcmp(argv[1], "init") == 0 && init_flag == 1) {
+        quickboot_sensor_init();
+    } else {
+        printf("usage:\n%s\n", cmdtp->usage);
+        return -1;
+    }
+    return 0;
+}
+U_BOOT_CMD(sensor_cfg, CFG_MAXARGS_SENSOR, 1, do_sensor_cfg,
+           "sensor_cfg    - config sensor"
+           "\t- sensor_cfg [preinit/init], must preinit before init!", NULL);
