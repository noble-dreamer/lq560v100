+		if (gmac == 0) { /* first time */
+			g_gmac_board_info[0].mii_name = mdio_bus[tmp];
+			g_gmac_board_info[1].mii_name = mdio_bus[tmp];
+			gmac++;
+			s = e;
+			s = strchr(s, ',');
