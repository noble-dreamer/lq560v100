diff --git a/board/vendor/lq560v100/ab_boot.c b/board/vendor/lq560v100/ab_boot.c
new file mode 100644
index 00000000..a274cfd9
--- /dev/null
+++ b/board/vendor/lq560v100/ab_boot.c
@@ -0,0 +1,255 @@
+/*
+ * Copyright (c) Oritek Technologies Co., Ltd. 2020-2023. All rights reserved.
+ */
+#include "linux/stddef.h"
+#include <config.h>
+#include <common.h>
+#include <hexdump.h>
+#include <asm/io.h>
+#include <asm/arch/platform.h>
+#include <command.h>
+#include <malloc.h>
+#include "partition.h"
+#include "ab_boot.h"
+#include <stdlib.h>
+
+#define ENV_NAME_SIZE			32
+#define PART_NAME_SIZE			64
+#define OFFSET_SIZE				64
+
+
+/**
+ * @brief  check if ab_boot enable
+ * @return true
+ * @return false
+ */
+bool is_ab_enable(void)
+{
+	bool res = false;
+	ot_partition_info_t *part_info = NULL;
+	partition_get_partition_info_by_name(&part_info, "misc");
+	if (part_info != NULL) {
+		res = true;
+	}
+	return res;
+}
+
+static const char *slotname_to_slotsuffix(const char *name)
+{
+	const char *suffixs[] = {"_a", "_b", ""};
+	uint32_t idx = 0;
+
+	if ((name == NULL) || (strlen(name) == 0)){
+		return "";
+	}
+	idx = name[0] - 'a';
+	if (idx < ARRAY_SIZE(suffixs) - 1){
+		return suffixs[idx];
+	}else{
+		return suffixs[ARRAY_SIZE(suffixs) - 1];
+	}
+}
+
+/*get bootslot*/
+static int get_boot_slot(void)
+{
+	int slot = -1;
+	slot = get_boot_param(BOOT_PARAM_CURRENT_SLOT);
+	if (slot == -1){
+		pr_err("can't get slot");
+		return -1;
+	}
+	return slot;
+}
+/**
+ * @brief
+ *
+ * @return const char*
+ */
+const char *ab_get_boot_slotname(void)
+{
+	const char *name = NULL;
+	int slot = -1;
+	slot = get_boot_slot();
+	if ((slot == -1) || (is_ab_enable() == false)) {
+		name = "";
+	} else {
+		name = (slot == 0)?"a":"b";
+	}
+	debug("boot from slot:(%s)\n", name);
+	return name;
+}
+
+/* bootargs*/
+int ab_add_partinfo_to_bootargs(void)
+{
+	/*len(part_str)*128
+	  exp: len(512K(bl31))*128*/
+	int partinfo_str_size = 128*10;
+	int bootargs_size = 128*10*2;
+	int ret = -1;
+	int boot_media = -1;
+	int printed = 0;
+	char *default_bootargs = NULL;
+	char *bootargs = NULL;
+	char *partinfo_str = NULL;
+	const char *boot_slot_name = NULL;
+	const char *partinfo_head = NULL;
+	char *head = NULL;
+	uint32_t part_idx = 0;
+
+	ot_partition_info_t *part_info = NULL;
+	int idx = 0;
+
+	partinfo_str = (char *)malloc(partinfo_str_size);
+	bootargs = (char *)malloc(bootargs_size);
+
+	if ((bootargs == NULL) || (partinfo_str == NULL)){
+		pr_err("malloc failed");
+		ret = -1;
+		goto out;
+	}
+
+	boot_media = get_boot_media();
+	default_bootargs = env_get("bootargs");
+
+	boot_slot_name = ab_get_boot_slotname();
+
+	switch (boot_media) {
+	case BOOT_MEDIA_SPIFLASH:
+		partinfo_head = "mtdparts=sfc:";
+		break;
+	case BOOT_MEDIA_NAND:
+		partinfo_head = "mtdparts=nand:";
+		break;
+	case BOOT_MEDIA_EMMC:
+		partinfo_head = "blkdevparts=mmcblk0:";
+		break;
+	default:
+		boot_media = BOOT_MEDIA_UNKNOWN;
+		break;
+	}
+
+	head = strstr(default_bootargs, partinfo_head);
+	if (head != NULL){
+		debug("use saved partinfo, but not from parttion\n");
+		ret = 0;
+		goto out;
+	}
+
+	for (part_idx = 0, idx = 0;partition_get_partition_info_by_index(&part_info, part_idx) != -1; part_idx++){
+		uint64_t part_size = 0;
+		const char *part_size_suffix = NULL;
+		part_size = part_info->length;
+		if (part_size % 0x40000000 == 0){
+			part_size_suffix = "G";
+			part_size = part_size / 0x40000000;
+		} else if (part_size % 0x100000 == 0){
+			part_size_suffix = "M";
+			part_size = part_size / 0x100000;
+		} else if (part_size % 0x400 == 0){
+			part_size_suffix = "K";
+			part_size = part_size / 0x400;
+		}
+		printed = snprintf(partinfo_str + idx, partinfo_str_size - idx, "%lld%s(%s),",
+				part_size,part_size_suffix, part_info->partition_name);
+		idx += printed;
+	}
+	if (part_idx == 0){
+		pr_err("no partinfo in partition,this should not happen \n");
+		ret = -1;
+		goto out;
+	}else{
+		partinfo_str[idx-1] = '\0';
+	}
+	if ((partinfo_str != NULL)) {
+		snprintf(bootargs, bootargs_size, "%s boot_slot_name=%s %s%s",
+			 default_bootargs == NULL ? "" : default_bootargs,
+			 boot_slot_name == NULL ? "" : boot_slot_name,
+			 partinfo_head, partinfo_str);
+	}
+	env_set("bootargs", bootargs);
+	debug("update bootargs:%s\n", bootargs);
+	ret = 0;
+out:
+	if (bootargs != NULL){
+		free(bootargs);
+	}
+	if (partinfo_str != NULL){
+		free(partinfo_str);
+	}
+	return ret;
+}
+
+static int do_ab_part(struct cmd_tbl *cmdtp, int flag, int argc,
+			char *const argv[])
+{
+	const char *boot_part = NULL;
+	//const char *boot_parts[] = { "bl31", "rootfs", "kernel", NULL };
+	uint64_t offset = 0;
+	char env_name[ENV_NAME_SIZE] = { 0 };
+	char part_name[PART_NAME_SIZE] = { 0 };
+	char offset_str[OFFSET_SIZE] = { 0 };
+	int boot_media = -1;
+	unsigned long unit = 1;
+	int idx = 0;
+	int ret = 0;
+	const char *slot_name = NULL;
+	ot_partition_info_t *part_info = NULL;
+
+	slot_name = ab_get_boot_slotname();
+	boot_media = get_boot_media();
+
+	/*ab_part a 1 [b 1]... */
+	if (argc < 3 || ((argc - 1)%2 != 0)){
+		debug("wrong argc:%d\n", argc);
+		return CMD_RET_USAGE;
+	}
+
+
+	for (idx = 0;idx < argc - 1; idx+=2){
+		memset(env_name, 0, ENV_NAME_SIZE);
+		memset(part_name, 0, PART_NAME_SIZE);
+		memset(offset_str, 0, OFFSET_SIZE);
+		if (argv[idx + 1] == NULL || argv[idx + 2] == NULL) {
+			debug("argv is null\n");
+			return CMD_RET_USAGE;
+		}
+		boot_part = argv[idx + 1];
+
+
+		ret = strict_strtoul(argv[idx + 2], 0, &unit);
+		if (ret != 0){
+			debug("bad unit:%s\n", argv[idx + 2]);
+			return CMD_RET_USAGE;
+		}
+
+		part_info = NULL;
+		snprintf(part_name, PART_NAME_SIZE, "%s%s", boot_part,
+			 slotname_to_slotsuffix(slot_name));
+
+		partition_get_partition_info_by_name(&part_info, part_name);
+		if (part_info == NULL) {
+			pr_err("can't get %s part info\n", part_name);
+			return CMD_RET_USAGE;
+		}
+		offset = part_info->start_addr / unit;
+
+		/*exp: atf_offset*/
+		snprintf(env_name, ENV_NAME_SIZE, "%s_offset", boot_part);
+		snprintf(offset_str, OFFSET_SIZE, "0x%s", simple_xtoa(offset));
+		debug("update %s:%s\n", env_name, offset_str);
+		env_set(env_name, offset_str);
+	}
+	ab_add_partinfo_to_bootargs();
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(
+	ab_part_offset, CONFIG_SYS_MAXARGS, 0, do_ab_part,
+	"set part offset info to env. ab_part_offset bl31 512 kernel 1 rootfs 1",
+	"<part_name> <unit> [<part_name> <unit>] \n"
+	"    - ab_part_offset  bl31 512 kernel 1 rootfs 1; create bl31_offset env variable bl31_offset and set with it's offset, in 512 bytes unit,\n"
+	"      and create kernel_offset env variable kernel_offset and set with it's offset, in 1 bytes unit,\n"
+	"      and create kernel_offset env variable rootfs_offset and set with it's offset, in 1 bytes unit."
+);
