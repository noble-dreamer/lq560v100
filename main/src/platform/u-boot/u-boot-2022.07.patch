diff --git a/product/quickboot_sensor/hal/i2c/hal_i2c.c b/product/quickboot_sensor/hal/i2c/hal_i2c.c
new file mode 100644
index 00000000..14ed2ed8
--- /dev/null
+++ b/product/quickboot_sensor/hal/i2c/hal_i2c.c
@@ -0,0 +1,743 @@
+/*
+ * Copyright (c) Oritek Technologies CO., Ltd. 2020-2023. All rights reserved.
+ */
+
+#include "hal_i2c.h"
+#include <common.h>
+#include <asm/io.h>
+
+/*
+ * I2C Registers offsets
+ */
+#define BSP_I2C_GLB 0x0
+#define BSP_I2C_SCL_H 0x4
+#define BSP_I2C_SCL_L 0x8
+#define BSP_I2C_DATA1 0x10
+#define BSP_I2C_TXF 0x20
+#define BSP_I2C_RXF 0x24
+#define BSP_I2C_CMD_BASE 0x30
+#define BSP_I2C_LOOP1 0xb0
+#define BSP_I2C_DST1 0xb4
+#define BSP_I2C_TX_WATER 0xc8
+#define BSP_I2C_RX_WATER 0xcc
+#define BSP_I2C_CTRL1 0xd0
+#define BSP_I2C_CTRL2 0xd4
+#define BSP_I2C_STAT 0xd8
+#define BSP_I2C_INTR_RAW 0xe0
+#define BSP_I2C_INTR_EN 0xe4
+#define BSP_I2C_INTR_STAT 0xe8
+
+/*
+ * I2C Global Config Register -- BSP_I2C_GLB
+ *  */
+#define GLB_EN_MASK BIT(0)
+#define GLB_SDA_HOLD_MASK 0xffff00
+#define GLB_SDA_HOLD_SHIFT 8
+
+/*
+ * I2C Timing CMD Register -- BSP_I2C_CMD_BASE + n * 4 (n = 0, 1, 2, ... 31)
+ *  */
+#define CMD_EXIT 0x0
+#define CMD_TX_S 0x1
+#define CMD_TX_D1_2 0x4
+#define CMD_TX_D1_1 0x5
+#define CMD_TX_FIFO 0x9
+#define CMD_RX_FIFO 0x12
+#define CMD_RX_ACK 0x13
+#define CMD_IGN_ACK 0x15
+#define CMD_TX_ACK 0x16
+#define CMD_TX_NACK 0x17
+#define CMD_JMP1 0x18
+#define CMD_UP_TXF 0x1d
+#define CMD_TX_RS 0x1e
+#define CMD_TX_P 0x1f
+
+/*
+ * I2C Control Register 1 -- BSP_I2C_CTRL1
+ */
+#define CTRL1_CMD_START_MASK BIT(0)
+
+/*
+ * I2C Status Register -- BSP_I2C_STAT
+ */
+#define STAT_RXF_NOE_MASK BIT(16) /* RX FIFO not empty flag */
+#define STAT_TXF_NOF_MASK BIT(19) /* TX FIFO not full flag */
+
+/*
+ * I2C Interrupt status and mask Register --
+ * BSP_I2C_INTR_RAW, BSP_I2C_STAT, BSP_I2C_INTR_STAT
+ */
+#define INTR_ABORT_MASK (BIT(0) | BIT(11))
+#define INTR_RX_MASK BIT(2)
+#define INTR_TX_MASK BIT(4)
+#define INTR_CMD_DONE_MASK BIT(12)
+#define INTR_USE_MASK (INTR_ABORT_MASK | INTR_RX_MASK | INTR_TX_MASK | INTR_CMD_DONE_MASK)
+#define INTR_ALL_MASK 0xffffffff
+#define I2C_TXF_DEPTH 64
+#define I2C_RXF_DEPTH 64
+#define I2C_TXF_WATER 32
+#define I2C_RXF_WATER 32
+/* for i2c rescue */
+#define CHECK_SDA_IN_SHIFT 16
+#define GPIO_MODE_SHIFT 8
+#define FORCE_SCL_OEN_SHIFT 4
+#define FORCE_SDA_OEN_SHIFT 0
+
+#define PERI_CRG110 0x01b8
+#define I2C_CRG_REG_BASE (CRG_REG_BASE + PERI_CRG110)
+
+#if (defined CONFIG_TARGET_LQ560V100_FAMILY)
+#define I2C7_REG_BASE             0x11067000
+#define I2C6_REG_BASE             0x11066000
+#define I2C5_REG_BASE             0x11065000
+#define I2C4_REG_BASE             0x11064000
+#define I2C3_REG_BASE             0x11063000
+#define I2C2_REG_BASE             0x11062000
+#define I2C1_REG_BASE             0x11061000
+#define I2C0_REG_BASE             0x11060000
+#define I2C_NUM 8
+#endif
+
+struct bsp_platform_i2c {
+    unsigned int msg_buf_ptr;
+    int status;
+#define I2C_WAIT_RESPOND (1 << 0)
+};
+
+struct i2c_bsp_platform_data {
+    unsigned int freq;
+    unsigned int clk;
+};
+
+struct i2c_msg {
+    unsigned short addr; /* slave address */
+    unsigned short flags;
+#define I2C_M_TEN 0x0010
+#define I2C_M_RD 0x0001
+#define I2C_M_STOP 0x8000
+#define I2C_M_NOSTART 0x4000
+#define I2C_M_REV_DIR_ADDR 0x2000
+#define I2C_M_IGNORE_NAK 0x1000
+#define I2C_M_NO_RD_ACK 0x0800
+#define I2C_M_RECV_LEN 0x0400
+#define I2C_M_16BIT_DATA 0x0008
+#define I2C_M_16BIT_REG 0x0002
+    unsigned short len; /* msg length */
+    unsigned char *buf; /* pointer to msg data */
+};
+
+struct i2c_driver_data {
+    unsigned int reg_base;
+    unsigned int freq;
+    unsigned int irq;
+    unsigned int clk;
+    struct i2c_msg *msgs;
+    unsigned int msg_num;
+    unsigned int msg_idx;
+    unsigned int lock;
+    void *private;
+};
+
+#define CLK_LIMIT_DEFAULT 400000
+#define GET_UINT32(uwAddr) (*((volatile unsigned int *)(uwAddr)))
+#define WRITE_UINT32(uwValue, uwAddr) {                           \
+    *((volatile unsigned int *)(uwAddr)) = (uwValue); \
+    }
+#define write_reg_bit(value, offset, addr) ({     \
+    unsigned long t, mask;           \
+    mask = 1 << (offset);            \
+    t = GET_UINT32(addr);            \
+    t &= ~mask;                      \
+    t |= ((value) << (offset)) & mask; \
+    WRITE_UINT32(t, addr);             \
+    })
+#define get_bus_clk() 50000000
+#define get_host_clock(i2c_num) ({ get_bus_clk(); })
+
+#define I2C_WAIT_TIMEOUT (100 * 3)
+#define I2C_TIMEOUT_COUNT 0x10000
+#define I2C_BUF_SIZE 8
+#define I2C_INTERRUPT_NUM 0
+
+#if (defined CONFIG_TARGET_LQ560V100_FAMILY)
+static struct bsp_platform_i2c g_i2c_platform_data[I2C_NUM] = {0};
+static int g_i2c_host_cfg[I2C_NUM] = {0, 1, 2, 3, 4, 5, 6, 7}; /* 0,1,2,3,4,5,6,7: i2c index */
+static struct i2c_driver_data g_i2c_data[I2C_NUM] = {
+    {I2C0_REG_BASE, CLK_LIMIT_DEFAULT, I2C_INTERRUPT_NUM},
+    {I2C1_REG_BASE, CLK_LIMIT_DEFAULT, I2C_INTERRUPT_NUM},
+    {I2C2_REG_BASE, CLK_LIMIT_DEFAULT, I2C_INTERRUPT_NUM},
+    {I2C3_REG_BASE, CLK_LIMIT_DEFAULT, I2C_INTERRUPT_NUM},
+    {I2C4_REG_BASE, CLK_LIMIT_DEFAULT, I2C_INTERRUPT_NUM},
+    {I2C5_REG_BASE, CLK_LIMIT_DEFAULT, I2C_INTERRUPT_NUM},
+    {I2C6_REG_BASE, CLK_LIMIT_DEFAULT, I2C_INTERRUPT_NUM},
+    {I2C7_REG_BASE, CLK_LIMIT_DEFAULT, I2C_INTERRUPT_NUM},
+};
+#endif
+
+static void bsp_i2c_disable(const struct i2c_driver_data *i2c);
+static void bsp_i2c_cfg_irq(const struct i2c_driver_data *i2c, unsigned int flag);
+static unsigned int bsp_i2c_clr_irq(const struct i2c_driver_data *i2c);
+
+/* udelay defined in the lib/time.c */
+extern void udelay(unsigned long usec);
+
+static void bsp_i2c_rescue(const struct i2c_driver_data *i2c)
+{
+    bsp_i2c_disable(i2c);
+    bsp_i2c_cfg_irq(i2c, 0);
+    bsp_i2c_clr_irq(i2c);
+
+    unsigned int val = (0x1 << GPIO_MODE_SHIFT) | (0x1 << FORCE_SCL_OEN_SHIFT) |
+            (0x1 << FORCE_SDA_OEN_SHIFT);
+    writel(val, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_CTRL2));
+
+    unsigned int time_cnt = 0;
+    do {
+        for (int index = 0; index < 9; index++) { /* shift:9 */
+            val = (0x1 << GPIO_MODE_SHIFT) | 0x1;
+            writel(val, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_CTRL2));
+            udelay(5); /* delay: 5 us */
+            val = (0x1 << GPIO_MODE_SHIFT) |
+                (0x1 << FORCE_SCL_OEN_SHIFT) |
+                (0x1 << FORCE_SDA_OEN_SHIFT);
+            writel(val, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_CTRL2));
+            udelay(5); /* delay: 5 us */
+        }
+
+        time_cnt++;
+        if (time_cnt > I2C_WAIT_TIMEOUT) {
+            goto disable_rescue;
+        }
+
+        val = readl((volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_CTRL2));
+    } while (!(val & (0x1 << CHECK_SDA_IN_SHIFT)));
+
+    val = (0x1 << GPIO_MODE_SHIFT) | (0x1 << FORCE_SCL_OEN_SHIFT) |
+        (0x1 << FORCE_SDA_OEN_SHIFT);
+    writel(val, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_CTRL2));
+    val = (0x1 << GPIO_MODE_SHIFT) | (0x1 << FORCE_SCL_OEN_SHIFT);
+    writel(val, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_CTRL2));
+    udelay(10); /* delay: 10 us */
+    val = (0x1 << GPIO_MODE_SHIFT) | (0x1 << FORCE_SCL_OEN_SHIFT) |
+        (0x1 << FORCE_SDA_OEN_SHIFT);
+    writel(val, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_CTRL2));
+
+disable_rescue:
+    val = (0x1 << FORCE_SCL_OEN_SHIFT) | 0x1;
+    writel(val, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_CTRL2));
+}
+
+static void bsp_i2c_disable(const struct i2c_driver_data *i2c)
+{
+    unsigned int val = readl((volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_GLB));
+    val &= ~GLB_EN_MASK;
+    writel(val, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_GLB));
+}
+
+static void bsp_i2c_disable_irq(const struct i2c_driver_data *i2c, unsigned int flag)
+{
+    unsigned int val = readl((volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_INTR_EN));
+    val &= ~flag;
+    writel(val, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_INTR_EN));
+}
+
+static unsigned int bsp_i2c_clr_irq(const struct i2c_driver_data *i2c)
+{
+    unsigned int val = readl((volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_INTR_STAT));
+    writel(INTR_ALL_MASK, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_INTR_RAW));
+
+    return val;
+}
+
+static void bsp_i2c_set_freq(struct i2c_driver_data *i2c)
+{
+    unsigned int val;
+    unsigned int freq = i2c->freq;
+    unsigned int clk_rate = i2c->clk;
+    unsigned int max_freq = clk_rate >> 1;
+
+    if (freq > max_freq) {
+        i2c->freq = max_freq;
+        freq = i2c->freq;
+    }
+
+    if (freq <= 100000) { /* 100000:100KHz */
+        val = clk_rate / (freq * 2); /* 1/2:0.5 */
+        writel(val, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_SCL_H));
+        writel(val, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_SCL_L));
+    } else {
+        val = (clk_rate * 36) / (freq * 100); /* 36/100:0.36 */
+        writel(val, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_SCL_H));
+        val = (clk_rate * 64) / (freq * 100); /* 64/100:0.64 */
+        writel(val, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_SCL_L));
+    }
+    val = readl((volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_GLB));
+    val &= ~GLB_SDA_HOLD_MASK;
+    val |= ((0xa << GLB_SDA_HOLD_SHIFT) & GLB_SDA_HOLD_MASK);
+    writel(val, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_GLB));
+}
+
+/*
+ * set i2c controller TX and RX FIFO water
+ */
+static void bsp_i2c_set_water(const struct i2c_driver_data *i2c)
+{
+    writel(I2C_TXF_WATER, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_TX_WATER));
+    writel(I2C_RXF_WATER, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_RX_WATER));
+}
+
+static void bsp_i2c_enable_clk(unsigned char i2c_num)
+{
+    const unsigned int clk_start_bit = 11 + i2c_num; /* 11: i2c clk start bit */
+    const unsigned int rst_start_bit = 19 + i2c_num; /* 19: i2c rst start bit */
+    const unsigned int enable_clck = 1;
+    const unsigned int enable_rst = 0;
+    write_reg_bit(enable_clck, clk_start_bit, (unsigned long int)I2C_CRG_REG_BASE);
+    write_reg_bit(enable_rst, rst_start_bit, (unsigned long int)I2C_CRG_REG_BASE);
+}
+
+/*
+ * initialise the controller, set i2c bus interface freq
+ */
+static void bsp_i2c_init_cfg(const struct i2c_driver_data *i2c, unsigned char i2c_num)
+{
+    bsp_i2c_enable_clk(i2c_num);
+    bsp_i2c_disable(i2c);
+    bsp_i2c_disable_irq(i2c, INTR_ALL_MASK);
+    bsp_i2c_set_freq((struct i2c_driver_data *)i2c);
+    bsp_i2c_set_water(i2c);
+}
+
+static void bsp_i2c_cmdreg_set(const struct i2c_driver_data *i2c, unsigned int cmd, unsigned int *offset)
+{
+    writel(cmd, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_CMD_BASE + (*offset) * 4)); /* 4: bytes */
+    (*offset)++;
+}
+
+static void bsp_i2c_cfg_cmd(const struct i2c_driver_data *i2c)
+{
+    struct i2c_msg *msg = i2c->msgs;
+    unsigned int offset = 0;
+
+    if (i2c->msg_idx == 0)
+        bsp_i2c_cmdreg_set(i2c, CMD_TX_S, &offset);
+    else
+        bsp_i2c_cmdreg_set(i2c, CMD_TX_RS, &offset);
+
+    if (msg->flags & I2C_M_TEN) {
+        if (i2c->msg_idx == 0) {
+            bsp_i2c_cmdreg_set(i2c, CMD_TX_D1_2, &offset);
+            bsp_i2c_cmdreg_set(i2c, CMD_TX_D1_1, &offset);
+        } else {
+            bsp_i2c_cmdreg_set(i2c, CMD_TX_D1_2, &offset);
+        }
+    } else {
+        bsp_i2c_cmdreg_set(i2c, CMD_TX_D1_1, &offset);
+    }
+
+    if (msg->flags & I2C_M_IGNORE_NAK)
+        bsp_i2c_cmdreg_set(i2c, CMD_IGN_ACK, &offset);
+    else
+        bsp_i2c_cmdreg_set(i2c, CMD_RX_ACK, &offset);
+
+    if (msg->flags & I2C_M_RD) {
+        if (msg->len >= 2) { /* msg len:2 */
+            writel(offset, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_DST1));
+            writel(msg->len - 2, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_LOOP1)); /* 2: max len */
+            bsp_i2c_cmdreg_set(i2c, CMD_RX_FIFO, &offset);
+            bsp_i2c_cmdreg_set(i2c, CMD_TX_ACK, &offset);
+            bsp_i2c_cmdreg_set(i2c, CMD_JMP1, &offset);
+        }
+        bsp_i2c_cmdreg_set(i2c, CMD_RX_FIFO, &offset);
+        bsp_i2c_cmdreg_set(i2c, CMD_TX_NACK, &offset);
+    } else {
+        writel(offset, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_DST1));
+        writel(msg->len - 1, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_LOOP1));
+        bsp_i2c_cmdreg_set(i2c, CMD_UP_TXF, &offset);
+        bsp_i2c_cmdreg_set(i2c, CMD_TX_FIFO, &offset);
+
+        if (msg->flags & I2C_M_IGNORE_NAK) {
+            bsp_i2c_cmdreg_set(i2c, CMD_IGN_ACK, &offset);
+        } else {
+            bsp_i2c_cmdreg_set(i2c, CMD_RX_ACK, &offset);
+        }
+        bsp_i2c_cmdreg_set(i2c, CMD_JMP1, &offset);
+    }
+
+    if ((i2c->msg_idx == (i2c->msg_num - 1)) || (msg->flags & I2C_M_STOP)) {
+        bsp_i2c_cmdreg_set(i2c, CMD_TX_P, &offset);
+    }
+
+    bsp_i2c_cmdreg_set(i2c, CMD_EXIT, &offset);
+}
+
+static void bsp_i2c_enable(const struct i2c_driver_data *i2c)
+{
+    unsigned int val = readl((volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_GLB));
+    val |= GLB_EN_MASK;
+    writel(val, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_GLB));
+}
+
+/*
+ * config i2c slave addr
+ */
+static void bsp_i2c_set_addr(const struct i2c_driver_data *i2c)
+{
+    struct i2c_msg *msg = i2c->msgs;
+    unsigned int addr;
+
+    if (msg->flags & I2C_M_TEN) {
+        /* first byte is 11110XX0 where XX is upper 2 bits */
+        addr = ((msg->addr & 0x300) << 1) | 0xf000;
+        if (msg->flags & I2C_M_RD) {
+            addr |= 1 << 8; /* shift:8 */
+        }
+
+        /* second byte is the remaining 8 bits */
+        addr |= msg->addr & 0xff;
+    } else {
+        addr = (msg->addr & 0x7f) << 1;
+        if (msg->flags & I2C_M_RD) {
+            addr |= 1;
+        }
+    }
+
+    writel(addr, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_DATA1));
+}
+
+/*
+ * start command sequence
+ */
+static void bsp_i2c_start_cmd(const struct i2c_driver_data *i2c)
+{
+    unsigned int val = readl((volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_CTRL1));
+    val |= CTRL1_CMD_START_MASK;
+    writel(val, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_CTRL1));
+}
+
+static int bsp_i2c_wait_rx_noempty(const struct i2c_driver_data *i2c)
+{
+    unsigned int time_cnt = 0;
+    unsigned int val;
+
+    do {
+        val = readl((volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_STAT));
+        if (val & STAT_RXF_NOE_MASK) {
+            return 0;
+        }
+        udelay(50); /* delay:50 us */
+        time_cnt++;
+    } while (time_cnt < I2C_TIMEOUT_COUNT);
+
+    bsp_i2c_rescue(i2c);
+
+    return -EIO;
+}
+
+static int bsp_i2c_wait_tx_nofull(const struct i2c_driver_data *i2c)
+{
+    unsigned int time_cnt = 0;
+    unsigned int val;
+
+    do {
+        val = readl((volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_STAT));
+        if (val & STAT_TXF_NOF_MASK) {
+            return 0;
+        }
+        udelay(50); /* delay:50 us */
+        time_cnt++;
+    } while (time_cnt < I2C_TIMEOUT_COUNT);
+
+    bsp_i2c_rescue(i2c);
+
+    return -EIO;
+}
+
+static int bsp_i2c_wait_idle(const struct i2c_driver_data *i2c)
+{
+    unsigned int time_cnt = 0;
+    unsigned int val;
+
+    do {
+        val = readl((volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_INTR_RAW));
+        if (val & (INTR_ABORT_MASK)) {
+            return -EIO;
+        }
+
+        if (val & INTR_CMD_DONE_MASK) {
+            return 0;
+        }
+        udelay(50); /* delay:50 us */
+        time_cnt++;
+    } while (time_cnt < I2C_WAIT_TIMEOUT);
+
+    bsp_i2c_rescue(i2c);
+
+    return -EIO;
+}
+
+static int bsp_i2c_polling_xfer_one_msg(const struct i2c_driver_data *i2c)
+{
+    int status;
+    unsigned int val;
+    struct i2c_msg *msg = i2c->msgs;
+    unsigned int msg_buf_ptr = 0;
+
+    bsp_i2c_enable(i2c);
+    bsp_i2c_clr_irq(i2c);
+    bsp_i2c_set_addr(i2c);
+    bsp_i2c_cfg_cmd(i2c);
+    bsp_i2c_start_cmd(i2c);
+
+    if (msg->flags & I2C_M_RD) {
+        while (msg_buf_ptr < msg->len) {
+            status = bsp_i2c_wait_rx_noempty(i2c);
+            if (status) {
+                printf("bsp_i2c_wait_rx_noempty return status=%d\n", status);
+                goto end;
+            }
+            val = readl((volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_RXF));
+            msg->buf[msg_buf_ptr] = val;
+            msg_buf_ptr++;
+        }
+    } else {
+        while (msg_buf_ptr < msg->len) {
+            status = bsp_i2c_wait_tx_nofull(i2c);
+            if (status) {
+                printf("bsp_i2c_wait_tx_nofull return status=%d\n", status);
+                goto end;
+            }
+            val = msg->buf[msg_buf_ptr];
+            writel(val, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_TXF));
+            msg_buf_ptr++;
+        }
+    }
+
+    status = bsp_i2c_wait_idle(i2c);
+    if (status) {
+        printf("bsp_i2c_wait_idle return status=%d\n", status);
+    }
+end:
+    bsp_i2c_disable(i2c);
+
+    return status;
+}
+
+static void bsp_i2c_cfg_irq(const struct i2c_driver_data *i2c, unsigned int flag)
+{
+    writel(flag, (volatile void*)(unsigned long int)(i2c->reg_base + BSP_I2C_INTR_EN));
+}
+
+static int bsp_i2c_xfer(unsigned char i2c_num, const struct i2c_msg *msgs, int num)
+{
+    int status = 0;
+
+    if (msgs == NULL) {
+        printf("[error] msg pointer is null.\n");
+        return -EIO;
+    }
+
+    struct i2c_driver_data *i2c = &g_i2c_data[i2c_num];
+    struct bsp_platform_i2c *hpi = &g_i2c_platform_data[i2c_num];
+
+    i2c->clk = get_host_clock(0);
+    i2c->private = (void *)(hpi);
+
+    i2c->msgs = (struct i2c_msg *)msgs;
+    i2c->msg_num = (unsigned int)num;
+    i2c->msg_idx = 0;
+
+    while (i2c->msg_idx < i2c->msg_num) {
+        status = bsp_i2c_polling_xfer_one_msg(i2c);
+         if (status) {
+            break;
+         }
+
+        i2c->msgs++;
+        i2c->msg_idx++;
+    }
+
+    if (!status || i2c->msg_idx > 0) {
+        status = i2c->msg_idx;
+    }
+
+    return status;
+}
+
+static int bsp_i2c_check_enable(unsigned char i2c_num)
+{
+    if (i2c_num >= I2C_NUM) {
+        return -1;
+    }
+
+    return g_i2c_host_cfg[i2c_num];
+}
+
+static int bsp_i2c_recv(const struct i2c_client *client, unsigned int *buf,
+    unsigned int count)
+{
+    struct i2c_msg msg[I2C_BUF_SIZE] = {0};
+    unsigned char recv_buf[I2C_BUF_SIZE] = {0};
+
+    if (client->reg_width == 2) { /* reg_width:2 */
+        recv_buf[0] = (client->reg_addr >> 8) & 0xff; /* shift:8 */
+        recv_buf[1] = client->reg_addr & 0xff;
+    } else {
+        recv_buf[0] = client->reg_addr & 0xff;
+    }
+
+    msg[0].addr = client->dev_addr;
+    msg[0].flags = 0;
+    msg[0].len = client->reg_width;
+    msg[0].buf = recv_buf;
+
+    msg[1].addr = client->dev_addr;
+    msg[1].flags = 0;
+    msg[1].flags |= I2C_M_RD;
+    msg[1].len = count;
+    msg[1].buf = recv_buf;
+
+    int ret = bsp_i2c_xfer(client->i2c_num, msg, 2); /* msg num:2 */
+    if (ret < 0) {
+        return -1;
+    }
+
+    if (count == 2) { /* data_width:2 */
+        *buf = recv_buf[0] | (recv_buf[1] << 8); /* shift:8 */
+    } else {
+        *buf = recv_buf[0];
+    }
+
+    return 0;
+}
+
+static int bsp_i2c_send(unsigned char i2c_num, unsigned short dev_addr, const char *buf, unsigned int count)
+{
+    struct i2c_msg msg = {0};
+    msg.addr = dev_addr;
+    msg.flags = 0;
+    msg.len = count;
+    msg.buf = (unsigned char *)buf;
+    int ret = bsp_i2c_xfer(i2c_num, &msg, 1);
+    return (ret == 1) ? count : ret;
+}
+
+static int bsp_i2c_init(unsigned char i2c_num)
+{
+    struct i2c_driver_data *i2c = NULL;
+    struct bsp_platform_i2c *hpi = NULL;
+
+    int ret = bsp_i2c_check_enable(i2c_num);
+    if (ret < 0) {
+        printf("bsp_i2c_init error ret=%d\n", ret);
+        return -1;
+    }
+
+    i2c = &g_i2c_data[i2c_num];
+    hpi = &g_i2c_platform_data[i2c_num];
+    i2c->clk = get_host_clock(i2c_num);
+    i2c->private = (void *)(hpi);
+    i2c->irq = 0;
+    bsp_i2c_init_cfg(i2c, i2c_num);
+
+    return 0;
+}
+
+int hal_i2c_recv(const struct i2c_client *client, unsigned char *buf, unsigned int count)
+{
+    if ((client == NULL) || (buf == NULL)) {
+        printf("[error] i2c recv param is null.\n");
+        return -1;
+    }
+
+    if (client->i2c_num >= I2C_NUM) {
+        printf("[error] i2c num(%u) is invalid.\n", client->i2c_num);
+        return -1;
+    }
+
+    if (count > I2C_BUF_SIZE) {
+        printf("[error] buf count(%u) should lees than(%d).\n", count, I2C_BUF_SIZE);
+        return -1;
+    }
+
+    return bsp_i2c_recv(client, (unsigned int*)buf, count);
+}
+
+int hal_i2c_send(unsigned char i2c_num, unsigned short dev_addr, const char *buf, unsigned int count)
+{
+    if (i2c_num >= I2C_NUM) {
+        printf("[error] i2c num(%u) is invalid.\n", i2c_num);
+        return -1;
+    }
+
+    if (buf == NULL) {
+        printf("[error] i2c send param is null.\n");
+        return -1;
+    }
+
+    if (count > I2C_BUF_SIZE) {
+        printf("[error] buf count(%u) should lees than(%d).\n", count, I2C_BUF_SIZE);
+        return -1;
+    }
+
+    return bsp_i2c_send(i2c_num, dev_addr, buf, count);
+}
+
+int hal_i2c_init(unsigned char i2c_num)
+{
+    if (i2c_num >= I2C_NUM) {
+        printf("[error] i2c num(%u) is invalid.\n", i2c_num);
+        return -1;
+    }
+    return bsp_i2c_init(i2c_num);
+}
+
+#define I2C_BUF_LEN      8
+int hal_i2c_write_byte(unsigned char i2c_num, unsigned char i2c_addr,
+    unsigned int addr, unsigned char addr_byte, unsigned char data)
+{
+    int ret = 0;
+    unsigned int idx = 0;
+    char buf[I2C_BUF_LEN] = {0};
+
+    if (addr_byte == 2) {        /* 2 byte */
+        buf[idx++] = (addr >> 8) & 0xff; /* shift 8 */
+        buf[idx++] = addr & 0xff;
+    } else {
+        buf[idx++] = addr & 0xff;
+    }
+    buf[idx++] = data & 0xff;
+
+    ret = hal_i2c_send(i2c_num, (i2c_addr >> 1), buf, addr_byte + 1);
+    if (ret <= 0) {
+        printf("[error] hal_i2c_send bus%u 0x%02X addr 0x%02X value 0x%02X ret: %d\n",
+            i2c_num, i2c_addr, addr, data, ret);
+        return ret;
+    }
+    if (ret != (addr_byte + 1)) {
+        printf("[error] hal_i2c_send error, send bytes not match.\n");
+        return ret;
+    }
+    return 0;
+}
+
+int hal_i2c_read_byte(unsigned char i2c_num, unsigned char i2c_addr,
+    unsigned int addr, unsigned char addr_byte, unsigned char *data)
+{
+    int ret = 0;
+    char buf[I2C_BUF_LEN] = {0};
+    struct i2c_client client = {0};
+
+    client.i2c_num = i2c_num;
+    client.dev_addr = (i2c_addr >> 1);
+    client.reg_addr = addr;
+    client.reg_width = addr_byte;
+
+    ret = hal_i2c_recv(&client, buf, 1);
+    if (ret != 0) {
+        return ret;
+    }
+
+    *data = buf[0];
+    return 0;
+}
