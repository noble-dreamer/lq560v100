+#define HKL_ENGINE_AES          0x20
+#define HKL_ENGINE_SM4          0x50
+#define HKL_ENGINE_SHA1_HMAC    0xa0
+#define HKL_ENGINE_SHA2_HMAC    0xa1
+#define HKL_ENGINE_SM3_HMAC     0xa2
