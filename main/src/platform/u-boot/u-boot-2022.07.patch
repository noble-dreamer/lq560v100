+static unsigned short fmc100_read_word(struct mtd_info* const mtd)
+{
+	struct nand_chip *chip = mtd_to_nand(mtd);
+	struct fmc_host *host = chip->priv;
+
+	return readw(host->buffer + host->column + host->offset);
+}
