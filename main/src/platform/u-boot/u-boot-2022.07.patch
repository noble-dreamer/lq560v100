+/* DDR_DDRT_SPECIAL_CONFIG     : DDRT read and write special operate. */
+/* DDR_DDR4_CONFIG             : DDR4 special operate. */
+/* DDR_TRAINING_CUT_CODE_CONFIG: Cut code for small SRAM. */
