+#define CRYPTO_IOC_TYPE(cmd)      (((cmd) >> 8) & 0xFF)
+#define CRYPTO_IOC_NR(cmd)        (((cmd) >> 0) & 0xFF)
+#define CRYPTO_IOC_SIZE(cmd)      (((cmd) >> 16) & 0x3FFF)
