+            port_sel_reg_val = HKL_PORT_SEL_HMAC;
+            break;
+        case CRYPTO_KLAD_DEST_FLASH:
+            port_sel_reg_val = HKL_PORT_SEL_FLASH;
+            break;
+        case CRYPTO_KLAD_DEST_NPU:
+            port_sel_reg_val = HKL_PORT_SEL_NPU;
+            break;
