+#ifndef __KIRKWOOD_OMP_H
+#define __KIRKWOOD_OMP_H
+
+#define OMP(_num, _sel, _in, _out, _F6180, _F6190, _F6192, _F6281) ( \
+	/* OMP number */		((_num) & 0xff) | \
+	/* OMP select value */		(((_sel) & 0xf) << 8) | \
+	/* may be input signal */	((!!(_in)) << 12) | \
+	/* may be output signal */	((!!(_out)) << 13) | \
+	/* available on F6180 */	((!!(_F6180)) << 14) | \
+	/* available on F6190 */	((!!(_F6190)) << 15) | \
+	/* available on F6192 */	((!!(_F6192)) << 16) | \
+	/* available on F6281 */	((!!(_F6281)) << 17))
+
+#define OMP_NUM(x)	((x) & 0xff)
+#define OMP_SEL(x)	(((x) >> 8) & 0xf)
+
+				/*   num sel  i  o  6180 6190 6192 6281 */
+
+#define OMP_INPUT_MASK		OMP(  0, 0x0, 1, 0, 0,   0,   0,   0    )
+#define OMP_OUTPUT_MASK		OMP(  0, 0x0, 0, 1, 0,   0,   0,   0    )
+
+#define OMP_F6180_MASK		OMP(  0, 0x0, 0, 0, 1,   0,   0,   0    )
+#define OMP_F6190_MASK		OMP(  0, 0x0, 0, 0, 0,   1,   0,   0    )
+#define OMP_F6192_MASK		OMP(  0, 0x0, 0, 0, 0,   0,   1,   0    )
+#define OMP_F6281_MASK		OMP(  0, 0x0, 0, 0, 0,   0,   0,   1    )
+
