+        return TD_NULL;
+    }
+
+    if (crypto_ecc_support(curve_type) == TD_FALSE) {
+        return TD_NULL;
+    }
+    if (curve_type == DRV_PKE_ECC_TYPE_SM2 && !crypto_sm_support(CRYPTO_SM_ALG_SM2)) {
