@@ -0,0 +1,541 @@
+/*
+ * Copyright (c) Oritek Technologies Co., Ltd. 2020-2023. All rights reserved.
+ */
+#include <config.h>
+#include <common.h>
+#include <asm/io.h>
+#include <asm/arch/platform.h>
+#include <spi_flash.h>
+#include <nand.h>
