+#define DDR_REG_BASE_DMC2        0x1114a000
+/* [CUSTOM] DDR DMC3 base register */
+#define DDR_REG_BASE_DMC3        0x1114b000
+/* [CUSTOM] DDR DDRT base register */
+#define DDR_REG_BASE_DDRT        0x11160000
