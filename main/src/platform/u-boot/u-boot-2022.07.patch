+    hal_pke_set_ram(PKE_NRAM, a->data, a->length, max_len);
+    hal_pke_set_ram(PKE_KRAM, b->data, b->length, max_len);
+    hal_pke_set_ram(PKE_RRAM, p->data, p->length, max_len);
