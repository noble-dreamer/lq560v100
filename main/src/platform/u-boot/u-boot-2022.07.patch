diff --git a/fb/cmd/nand_ota_upgrade.c b/fb/cmd/nand_ota_upgrade.c
new file mode 100644
index 0000000..7274ef0
--- /dev/null
+++ b/cmd/nand_ota_upgrade.c
@@ -0,0 +1,1080 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * SD3589C NAND + UBI OTA recovery commands
+ *
+ * Commands:
+ *   misc_check                - read uflag, return 1 if PENDING/RUNNING
+ *   nand_ota_upgrade          - read upgrade pkg from UBI upgrade volume, verify and flash
+ *
+ * Reference: 3589E nor_upgrade.c (SD3589E_SDK_V100R001C00SPC005)
+ */
+
+#include <common.h>
+#include <command.h>
+#include <env.h>
+#include <malloc.h>
+#include <memalign.h>
+#include <nand.h>
+#include <linux/mtd/mtd.h>
+#include <linux/mtd/partitions.h>
+#include <u-boot/crc.h>
+#include <linux/string.h>
+#include <stdint.h>
+
+/* ---- Local OTA layout constants (embedded; keep in sync with ota_prepare/mkupgrade) ---- */
+
+#define UFLAG_PART_NAME		"uflag"
+#define UFLAG_PART_OFFSET	0x00180000	/* 1536K */
+#define UFLAG_PART_SIZE		0x00080000	/* 512K */
+#define UFLAG_REDUNDANT_NUM	4
+#define UFLAG_REDUNDANT_STRIDE	0x00020000	/* 128KB block stride */
+
+#define OTA_UPGRADE_MAGIC	0x55504752	/* "UPGR" */
+#define OTA_UPGRADE_FLAG_VERSION	1
+
+#define OTA_STATE_IDLE		0
+#define OTA_STATE_PENDING	1
+#define OTA_STATE_RUNNING	2
+#define OTA_STATE_DONE		3
+#define OTA_STATE_FAILED	4
+
+/* Keep in sync with ota_prepare.c and mkupgrade.py */
+struct ota_upgrade_flag {
+	uint32_t magic;
+	uint32_t version;
+	uint32_t state;
+	uint32_t upgrade_source;
+	uint32_t upgrade_size;
+	uint32_t upgrade_crc;
+	uint32_t component_mask;
+	uint32_t retry_count;
+	uint32_t version_new;
+	uint32_t version_old;
+	uint32_t completed_mask;
+	uint8_t  reserved[16];
+	uint32_t crc32;
+};
+
+#define OTA_PKG_MAGIC		0x4F544155	/* "OTAU" */
+#define OTA_PKG_VERSION		1
+#define OTA_PKG_HEADER_SIZE	512
+#define OTA_PKG_COMP_SIZE	64
+#define OTA_PKG_MAX_COMPS	16
+#define OTA_PKG_SIG_SIZE	256
+
+struct ota_pkg_header {
+	uint32_t magic;
+	uint32_t version;
+	uint32_t total_size;
+	uint32_t component_cnt;
+	uint32_t package_crc;
+	uint32_t fw_version;
+	uint32_t reserved0;
+	uint8_t  reserved[484];
+};
+
+struct ota_pkg_component {
+	uint8_t  name[16];
+	uint32_t flash_offset;
+	uint32_t flash_size;
+	uint32_t data_offset;
+	uint32_t data_size;
+	uint32_t data_crc;
+	uint8_t  media;
+	uint8_t  fs_type;
+	uint8_t  reserved[26];
+};
+
+#define OTA_COMP_UBOOT		(1U << 0)
+#define OTA_COMP_BL31		(1U << 1)
+#define OTA_COMP_KERNEL		(1U << 2)
+#define OTA_COMP_ROOTFS		(1U << 3)
+#define OTA_COMP_USERFS		(1U << 4)
+#define OTA_COMP_DATA		(1U << 5)
+
+#define OTA_MEDIA_NAND		0
+#define OTA_FS_RAW		0
+
+#define NAND_FLASH_SIZE		0x08000000	/* 128MB */
+#define NAND_PAGE_SIZE		2048
+#define NAND_BLOCK_SIZE		(128 * 1024)
+
+/* Partition offsets (must match nand.xml) */
+#define PART_OFFSET_OTFL	0x00000000
+#define PART_SIZE_OTFL		0x00180000	/* 1536K */
+#define PART_OFFSET_UFLAG	0x00180000
+#define PART_SIZE_UFLAG		0x00080000	/* 512K */
+#define PART_OFFSET_UBOOT	0x00200000
+#define PART_SIZE_UBOOT		0x00100000	/* 1M */
+#define PART_OFFSET_BL31	0x00300000
+#define PART_SIZE_BL31		0x00080000	/* 512K */
+#define PART_OFFSET_KERNEL	0x00380000
+#define PART_SIZE_KERNEL	0x00800000	/* 8M */
+#define PART_OFFSET_ROOTFS	0x00B80000
+#define PART_SIZE_ROOTFS	0x00800000	/* 8M */
+#define PART_OFFSET_UPGRADE	0x01380000
+#define PART_SIZE_UPGRADE	0x02000000	/* 32M */
+#define PART_OFFSET_USERFS	0x03380000
+#define PART_SIZE_USERFS	0x02000000	/* 32M */
+#define PART_OFFSET_DATA	0x05380000
+#define PART_SIZE_DATA		0x02C80000	/* ~44.5M */
+
+/* Maximum upgrade package size (must fit in upgrade partition) */
+#define MAX_UPGRADE_SIZE	PART_SIZE_UPGRADE	/* 32MB; ~30.8MB usable after UBI overhead, oversized packages already fail at ubimkvol on the Linux side */
+
+static struct mtd_info *nand_mtd;
+
+static int nand_mtd_init(void)
+{
+	if (nand_mtd)
+		return 0;
+
+	nand_mtd = get_nand_dev_by_index(0);
+	if (!nand_mtd) {
+		printf("nand_ota: NAND device not found\n");
+		return -1;
+	}
+	return 0;
+}
+
+/*
+ * ---- Bad-block aware NAND accessors (3589E CP006/CP009 style) ----
+ *
+ * The boot path reads images via `nand read` (nand_read_skip_bad): data
+ * is laid out contiguously in good-block space, skipping bad blocks
+ * within the partition's physical region. Upgrade writes MUST use the
+ * same layout or the system boots a misaligned image.
+ *
+ * erase: erase each good block in the region; on erase failure mark the
+ *        block bad (mtd_block_markbad, updates on-flash BBT + RAM BBT).
+ * write: write data contiguously skipping bad blocks; on write failure
+ *        mark the block bad and rewrite the SAME data chunk to the next
+ *        good block (source data is NOT consumed by a failed block).
+ * read:  read contiguously skipping bad blocks (matches boot path).
+ */
+
+static int ota_nand_erase(uint32_t offset, uint32_t len)
+{
+	uint32_t cur = offset & ~(NAND_BLOCK_SIZE - 1);
+	uint32_t end = offset + len;
+	int erased = 0;
+
+	while (cur < end) {
+		if (nand_block_isbad(nand_mtd, cur)) {
+			printf("ota_nand_erase: skip bad block 0x%x\n", cur);
+			cur += NAND_BLOCK_SIZE;
+			continue;
+		}
+
+		if (nand_erase(nand_mtd, cur, NAND_BLOCK_SIZE)) {
+			printf("ota_nand_erase: block 0x%x erase failed, marking bad\n",
+			       cur);
+			mtd_block_markbad(nand_mtd, cur);
+			cur += NAND_BLOCK_SIZE;
+			continue;
+		}
+		erased++;
+		cur += NAND_BLOCK_SIZE;
+	}
+
+	/* all-fail guard: nothing erased means either all-bad region or a
+	 * hardware problem; proceeding to write would be meaningless */
+	if (erased == 0) {
+		printf("ota_nand_erase: no block erased in [0x%x, 0x%x)\n",
+		       offset, end);
+		return -1;
+	}
+	return 0;
+}
+
+static int ota_nand_write(uint32_t offset, const uint8_t *data, uint32_t len,
+			  uint32_t limit)
+{
+	uint32_t cur = offset;
+	uint32_t done = 0;
+
+	while (done < len) {
+		uint32_t blk_start = cur & ~(NAND_BLOCK_SIZE - 1);
+		uint32_t blk_off = cur - blk_start;
+		uint32_t chunk = NAND_BLOCK_SIZE - blk_off;
+		size_t wr;
+		int ret;
+
+		/* partition end guard: too many consecutive bad blocks must
+		 * NOT spill the write into the next partition */
+		if (cur >= limit) {
+			printf("ota_nand_write: no space left before 0x%x "
+			       "(done %u/%u, too many bad blocks)\n",
+			       limit, done, len);
+			return -1;
+		}
+
+		if (chunk > len - done)
+			chunk = len - done;
+
+		if (nand_block_isbad(nand_mtd, blk_start)) {
+			printf("ota_nand_write: skip bad block 0x%x\n", blk_start);
+			cur = blk_start + NAND_BLOCK_SIZE;
+			continue;
+		}
+
+		wr = chunk;
+		ret = nand_write(nand_mtd, cur, &wr, (u_char *)(data + done));
+		if (ret || wr != chunk) {
+			printf("ota_nand_write: block 0x%x write failed, marking bad\n",
+			       blk_start);
+			mtd_block_markbad(nand_mtd, blk_start);
+			/* same data chunk is rewritten to the next good block */
+			cur = blk_start + NAND_BLOCK_SIZE;
+			continue;
+		}
+
+		done += chunk;
+		cur += chunk;
+	}
+	return 0;
+}
+
+static int ota_nand_read(uint32_t offset, uint8_t *buf, uint32_t len,
+			 uint32_t limit)
+{
+	uint32_t cur = offset;
+	uint32_t done = 0;
+
+	while (done < len) {
+		uint32_t blk_start = cur & ~(NAND_BLOCK_SIZE - 1);
+		uint32_t blk_off = cur - blk_start;
+		uint32_t chunk = NAND_BLOCK_SIZE - blk_off;
+		size_t rd;
+		int ret;
+
+		if (cur >= limit) {
+			printf("ota_nand_read: read past 0x%x "
+			       "(done %u/%u, too many bad blocks)\n",
+			       limit, done, len);
+			return -1;
+		}
+
+		if (chunk > len - done)
+			chunk = len - done;
+
+		if (nand_block_isbad(nand_mtd, blk_start)) {
+			cur = blk_start + NAND_BLOCK_SIZE;
+			continue;
+		}
+
+		rd = chunk;
+		ret = nand_read(nand_mtd, cur, &rd, buf + done);
+		if (ret) {
+			printf("ota_nand_read: read failed at 0x%x\n", cur);
+			return -1;
+		}
+
+		done += chunk;
+		cur += chunk;
+	}
+	return 0;
+}
+
+/*
+ * Read uflag from NAND with 4-page redundancy.
+ *
+ * 3589E strategy: read ALL copies and pick the valid one with the
+ * largest completed_mask. completed_mask doubles as the "newest token",
+ * so no sequence number field is needed. This prevents a stale copy
+ * (e.g. an old RUNNING state left in a copy whose erase failed during
+ * a previous write) from being revived.
+ *
+ * Returns 0 and fills *flag on success, -1 if no valid copy.
+ */
+static int uflag_read(struct ota_upgrade_flag *flag)
+{
+	struct ota_upgrade_flag cand;
+	int i;
+	u32 calc_crc;
+	u32 best_mask = 0;
+	int found = 0;
+
+	if (nand_mtd_init())
+		return -1;
+
+	for (i = 0; i < UFLAG_REDUNDANT_NUM; i++) {
+		size_t offset = UFLAG_PART_OFFSET + i * UFLAG_REDUNDANT_STRIDE;
+		size_t len;
+		int ret;
+
+		/* a factory/runtime bad block just makes this copy unusable;
+		 * redundancy covers it - skip, do NOT relocate (fixed stride) */
+		if (nand_block_isbad(nand_mtd, offset))
+			continue;
+
+		len = sizeof(cand);
+		ret = nand_read(nand_mtd, offset, &len, (u_char *)&cand);
+		if (ret)
+			continue;
+
+		if (cand.magic != OTA_UPGRADE_MAGIC)
+			continue;
+
+		if (cand.version != OTA_UPGRADE_FLAG_VERSION)
+			continue;
+
+		calc_crc = crc32(0, (const unsigned char *)&cand,
+				 sizeof(cand) - sizeof(cand.crc32));
+		if (calc_crc != cand.crc32)
+			continue;
+
+		/* pick the valid copy with the largest completed_mask */
+		if (!found || cand.completed_mask > best_mask) {
+			memcpy(flag, &cand, sizeof(*flag));
+			best_mask = cand.completed_mask;
+			found = 1;
+		}
+	}
+
+	if (!found) {
+		printf("uflag_read: no valid copy found\n");
+		return -1;
+	}
+
+	printf("uflag_read: state=%u completed_mask=0x%x\n",
+	       flag->state, flag->completed_mask);
+	return 0;
+}
+
+/*
+ * Write uflag to 4 redundant copies in REVERSE order (copy 3 -> copy 0).
+ *
+ * Copy 0 is written last: if power fails mid-sequence, copy 0 (the one
+ * most readers check first) still holds the previous consistent state,
+ * while the newer copies further in already hold the new state. Combined
+ * with uflag_read picking max(completed_mask), a torn write recovers to
+ * the newest available state instead of a stale one.
+ *
+ * Tolerates partial failure: success if at least one copy was written.
+ */
+static int uflag_write(struct ota_upgrade_flag *flag)
+{
+	static u8 page_buf[NAND_PAGE_SIZE];
+	int i;
+	int ok = 0;
+
+	if (nand_mtd_init())
+		return -1;
+
+	flag->crc32 = crc32(0, (const unsigned char *)flag,
+			    sizeof(*flag) - sizeof(flag->crc32));
+
+	/* write one full NAND page (2KB): flag + 0xFF padding.
+	 * sub-page writes are unreliable on drivers without subpage
+	 * support and match the ota_prepare side (2048B page write) */
+	memset(page_buf, 0xFF, sizeof(page_buf));
+	memcpy(page_buf, flag, sizeof(*flag));
+
+	for (i = UFLAG_REDUNDANT_NUM - 1; i >= 0; i--) {
+		size_t offset = UFLAG_PART_OFFSET + i * UFLAG_REDUNDANT_STRIDE;
+		size_t len;
+		int r;
+
+		/* bad block: skip this copy (fixed stride, redundancy covers it) */
+		if (nand_block_isbad(nand_mtd, offset))
+			continue;
+
+		r = nand_erase(nand_mtd, offset, UFLAG_REDUNDANT_STRIDE);
+		if (r) {
+			printf("uflag_write: copy %d erase failed at 0x%zx\n", i, offset);
+			mtd_block_markbad(nand_mtd, offset);
+			continue;
+		}
+
+		len = sizeof(page_buf);
+		r = nand_write(nand_mtd, offset, &len, page_buf);
+		if (r) {
+			printf("uflag_write: copy %d write failed at 0x%zx\n", i, offset);
+			mtd_block_markbad(nand_mtd, offset);
+			continue;
+		}
+		ok++;
+	}
+
+	if (ok == 0) {
+		printf("uflag_write: all %d copies failed\n", UFLAG_REDUNDANT_NUM);
+		return -1;
+	}
+	if (ok < UFLAG_REDUNDANT_NUM)
+		printf("uflag_write: warning: only %d/%d copies written\n",
+		       ok, UFLAG_REDUNDANT_NUM);
+	return 0;
+}
+
+static void uflag_set_env(struct ota_upgrade_flag *flag)
+{
+	char buf[16];
+
+	snprintf(buf, sizeof(buf), "%u", flag->state);
+	env_set("misc_state", buf);
+	snprintf(buf, sizeof(buf), "%u", flag->upgrade_source);
+	env_set("upgrade_source", buf);
+	snprintf(buf, sizeof(buf), "%u", flag->upgrade_size);
+	env_set("upgrade_size", buf);
+	snprintf(buf, sizeof(buf), "%u", flag->completed_mask);
+	env_set("completed_mask", buf);
+	snprintf(buf, sizeof(buf), "%u", flag->retry_count);
+	env_set("retry_count", buf);
+}
+
+static int do_misc_check(struct cmd_tbl *cmdtp, int flag, int argc,
+			 char *const argv[])
+{
+	struct ota_upgrade_flag uflag;
+	int ret;
+
+	ret = uflag_read(&uflag);
+	if (ret) {
+		/* no valid flag copy: treat as no upgrade (return 0),
+		 * NOT CMD_RET_FAILURE(=1) which would falsely trigger
+		 * nand_ota_upgrade from bootcmd 'test $? -eq 1' */
+		printf("misc_check: no valid uflag, normal boot\n");
+		return 0;
+	}
+
+	if (uflag.magic != OTA_UPGRADE_MAGIC) {
+		printf("misc_check: invalid magic 0x%08x, normal boot\n", uflag.magic);
+		return 0;
+	}
+
+	uflag_set_env(&uflag);
+
+	if (uflag.state == OTA_STATE_PENDING || uflag.state == OTA_STATE_RUNNING) {
+		printf("misc_check: upgrade pending (state=%u)\n", uflag.state);
+		return 1;	/* return 1 so bootcmd 'test $? -eq 1' triggers upgrade */
+	}
+
+	printf("misc_check: no upgrade (state=%u)\n", uflag.state);
+	return 0;
+}
+
+U_BOOT_CMD(misc_check, 1, 1, do_misc_check,
+	   "Check uflag upgrade flag",
+	   " - read uflag partition, return 1 if PENDING/RUNNING\n");
+
+static int do_misc_set_running(struct cmd_tbl *cmdtp, int flag, int argc,
+			       char *const argv[])
+{
+	struct ota_upgrade_flag uflag;
+	int ret;
+
+	ret = uflag_read(&uflag);
+	if (ret)
+		return CMD_RET_FAILURE;
+
+	if (uflag.magic != OTA_UPGRADE_MAGIC) {
+		printf("misc_set_running: invalid uflag\n");
+		return CMD_RET_FAILURE;
+	}
+
+	if (uflag.state != OTA_STATE_PENDING && uflag.state != OTA_STATE_RUNNING) {
+		printf("misc_set_running: state is not PENDING/RUNNING (%u)\n", uflag.state);
+		return CMD_RET_FAILURE;
+	}
+
+	uflag.state = OTA_STATE_RUNNING;
+	ret = uflag_write(&uflag);
+	if (ret) {
+		printf("misc_set_running: write failed\n");
+		return CMD_RET_FAILURE;
+	}
+	printf("misc_set_running: state -> RUNNING\n");
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(misc_set_running, 1, 1, do_misc_set_running,
+	   "Set uflag upgrade state to RUNNING",
+	   "");
+
+static const char *comp_name(struct ota_pkg_component *c)
+{
+	static char buf[17];
+	memcpy(buf, c->name, 16);
+	buf[16] = '\0';
+	return buf;
+}
+
+static u32 comp_bit_by_name(const char *name)
+{
+	if (strncmp(name, "bl31", 16) == 0)
+		return OTA_COMP_BL31;
+	if (strncmp(name, "kernel", 16) == 0)
+		return OTA_COMP_KERNEL;
+	if (strncmp(name, "rootfs", 16) == 0)
+		return OTA_COMP_ROOTFS;
+	if (strncmp(name, "uboot", 16) == 0)
+		return OTA_COMP_UBOOT;
+	if (strncmp(name, "userfs", 16) == 0)
+		return OTA_COMP_USERFS;
+	if (strncmp(name, "data", 16) == 0)
+		return OTA_COMP_DATA;
+	return 0;
+}
+
+static int is_nand_component_allowed(struct ota_pkg_component *c)
+{
+	if (c->media != OTA_MEDIA_NAND)
+		return 0;
+	if (comp_bit_by_name((const char *)c->name) == 0) {
+		printf("validate: unknown NAND component '%s'\n", comp_name(c));
+		return 0;
+	}
+	/* userfs/data components not allowed in V1.1 - UBIFS dynamic volumes, not raw partitions */
+	if (strncmp((const char *)c->name, "userfs", 16) == 0 ||
+	    strncmp((const char *)c->name, "data", 16) == 0) {
+		printf("validate: '%s' component not allowed (UBIFS dynamic volume, not raw partition)\n",
+		       comp_name(c));
+		return 0;
+	}
+	/*
+	 * uboot component is safe: OTFL checks uflag at boot and loads this
+	 * Recovery U-Boot from the otfl partition when PENDING/RUNNING.
+	 * The uboot partition being erased is NOT the medium we run from.
+	 * If power fails mid-write, next boot OTFL falls back to the intact
+	 * otfl-resident Recovery and resumes the upgrade.
+	 */
+	return 1;
+}
+
+static int validate_nand_components(struct ota_pkg_header *hdr,
+				    struct ota_pkg_component *table)
+{
+	u32 i;
+	u32 data_start = OTA_PKG_HEADER_SIZE + hdr->component_cnt * OTA_PKG_COMP_SIZE;
+
+	if (hdr->component_cnt == 0 || hdr->component_cnt > OTA_PKG_MAX_COMPS) {
+		printf("validate: invalid component count %u\n", hdr->component_cnt);
+		return -1;
+	}
+
+	for (i = 0; i < hdr->component_cnt; i++) {
+		struct ota_pkg_component *c = &table[i];
+		u32 end;
+
+		if (c->media != OTA_MEDIA_NAND) {
+			printf("validate: skipping non-NAND component '%s' (media=%u)\n",
+			       comp_name(c), c->media);
+			continue;
+		}
+
+		if (!is_nand_component_allowed(c))
+			return -1;
+
+		if (c->flash_size == 0 || c->data_size == 0 ||
+		    c->data_size > c->flash_size) {
+			printf("validate: '%s' bad size (flash=%u data=%u)\n",
+			       comp_name(c), c->flash_size, c->data_size);
+			return -1;
+		}
+
+		/* spec #12: flash_offset/flash_size must be 128KB block aligned,
+		 * otherwise erase geometry is ambiguous */
+		if ((c->flash_offset & (NAND_BLOCK_SIZE - 1)) != 0 ||
+		    (c->flash_size & (NAND_BLOCK_SIZE - 1)) != 0) {
+			printf("validate: '%s' not 128KB aligned (off=0x%x size=0x%x)\n",
+			       comp_name(c), c->flash_offset, c->flash_size);
+			return -1;
+		}
+
+		end = c->flash_offset + c->flash_size;
+		if (end > NAND_FLASH_SIZE) {
+			printf("validate: '%s' exceeds NAND size (0x%x)\n",
+			       comp_name(c), end);
+			return -1;
+		}
+
+		/* protect otfl and uflag regions */
+		if (c->flash_offset < PART_OFFSET_UBOOT) {
+			printf("validate: '%s' overlaps protected region\n",
+			       comp_name(c));
+			return -1;
+		}
+
+		/* match known partition bounds */
+		if (strncmp((const char *)c->name, "bl31", 16) == 0 &&
+		    (c->flash_offset != PART_OFFSET_BL31 ||
+		     c->flash_size > PART_SIZE_BL31))
+			goto bad_bounds;
+		if (strncmp((const char *)c->name, "kernel", 16) == 0 &&
+		    (c->flash_offset != PART_OFFSET_KERNEL ||
+		     c->flash_size > PART_SIZE_KERNEL))
+			goto bad_bounds;
+		if (strncmp((const char *)c->name, "rootfs", 16) == 0 &&
+		    (c->flash_offset != PART_OFFSET_ROOTFS ||
+		     c->flash_size > PART_SIZE_ROOTFS))
+			goto bad_bounds;
+		if (strncmp((const char *)c->name, "uboot", 16) == 0 &&
+		    (c->flash_offset != PART_OFFSET_UBOOT ||
+		     c->flash_size > PART_SIZE_UBOOT))
+			goto bad_bounds;
+
+		/* check overlap with other NAND components */
+		{
+			u32 j;
+
+			for (j = 0; j < i; j++) {
+				struct ota_pkg_component *p = &table[j];
+				u32 p_end;
+
+				if (p->media != OTA_MEDIA_NAND)
+					continue;
+				p_end = p->flash_offset + p->flash_size;
+				if (c->flash_offset < p_end &&
+				    p->flash_offset < end) {
+					printf("validate: '%s' [0x%x,0x%x) overlaps '%s' [0x%x,0x%x)\n",
+					       comp_name(c), c->flash_offset, end,
+					       comp_name(p), p->flash_offset, p_end);
+					return -1;
+				}
+			}
+		}
+
+		if (c->data_offset < data_start ||
+		    c->data_offset + c->data_size > hdr->total_size) {
+			printf("validate: '%s' data out of range\n", comp_name(c));
+			return -1;
+		}
+		continue;
+
+bad_bounds:
+		printf("validate: '%s' bounds mismatch\n", comp_name(c));
+		return -1;
+	}
+
+	return 0;
+}
+
+static int verify_package_crc(struct ota_pkg_header *hdr,
+			      struct ota_pkg_component *table, u8 *base)
+{
+	u32 data_start = OTA_PKG_HEADER_SIZE;
+	u32 signed_end = hdr->total_size - OTA_PKG_SIG_SIZE; /* exclude signature slot */
+	u32 calc_crc;
+	u8 header_copy[OTA_PKG_HEADER_SIZE];
+
+	/*
+	 * CRC covers the full header with package_crc zeroed out, plus the
+	 * component table and data area.
+	 */
+	memcpy(header_copy, base, OTA_PKG_HEADER_SIZE);
+	/* package_crc is stored at offset 16 in the header */
+	memset(header_copy + 16, 0, 4);
+	calc_crc = crc32(0, header_copy, OTA_PKG_HEADER_SIZE);
+	calc_crc = crc32(calc_crc, base + data_start, signed_end - data_start);
+
+	if (calc_crc != hdr->package_crc) {
+		printf("verify_package_crc: mismatch (expected 0x%08x, got 0x%08x)\n",
+		       hdr->package_crc, calc_crc);
+		return -1;
+	}
+	printf("verify_package_crc: OK (0x%08x)\n", calc_crc);
+	return 0;
+}
+
+#define VERIFY_CHUNK_SIZE	(128 * 1024)	/* 128KB chunks to stay within malloc pool */
+
+static int nand_verify_component(struct ota_pkg_component *c, u8 *data_base)
+{
+	u8 *verify_buf;
+	u32 crc;
+	size_t len;
+	size_t remaining;
+	size_t offset;
+	u8 *data = data_base + c->data_offset;
+
+	verify_buf = memalign(ARCH_DMA_MINALIGN, VERIFY_CHUNK_SIZE);
+	if (!verify_buf) {
+		printf("verify: malloc failed (%d)\n", VERIFY_CHUNK_SIZE);
+		return -1;
+	}
+
+	crc = 0;
+	remaining = c->data_size;
+	offset = 0;
+
+	while (remaining > 0) {
+		size_t chunk = (remaining < VERIFY_CHUNK_SIZE) ? remaining : VERIFY_CHUNK_SIZE;
+
+		/* bad-block aware read, same skip layout as write/boot path */
+		if (ota_nand_read(c->flash_offset + offset, verify_buf, chunk,
+				  c->flash_offset + c->flash_size) != 0) {
+			printf("verify: read failed at 0x%lx\n",
+			       (unsigned long)(c->flash_offset + offset));
+			free(verify_buf);
+			return -1;
+		}
+		len = chunk;
+
+		/* Compare with source data in DDR */
+		if (memcmp(verify_buf, data + offset, len) != 0) {
+			printf("verify FAIL: %s data mismatch at offset 0x%zx\n",
+			       comp_name(c), offset);
+			free(verify_buf);
+			return -1;
+		}
+
+		crc = crc32(crc, verify_buf, len);
+		remaining -= len;
+		offset += len;
+	}
+
+	free(verify_buf);
+
+	if (crc != c->data_crc) {
+		printf("verify FAIL: %s CRC expected 0x%08x got 0x%08x\n",
+		       comp_name(c), c->data_crc, crc);
+		return -1;
+	}
+	printf("verify OK: %s\n", comp_name(c));
+	return 0;
+}
+
+static int nand_write_component(struct ota_pkg_component *c, u8 *data_base)
+{
+	u8 *data = data_base + c->data_offset;
+	u32 crc;
+
+	printf("Writing %-12s offset=0x%06x size=0x%x\n",
+	       comp_name(c), c->flash_offset, c->data_size);
+
+	crc = crc32(0, data, c->data_size);
+	if (crc != c->data_crc) {
+		printf("CRC mismatch: expected 0x%08x got 0x%08x\n",
+		       c->data_crc, crc);
+		return -1;
+	}
+
+	/* bad-block aware erase+write: same skip layout as boot path
+	 * (nand read skip_bad); failures mark blocks bad and data is
+	 * rewritten to the next good block, never consumed by bad ones */
+	if (ota_nand_erase(c->flash_offset, c->flash_size) != 0) {
+		printf("Erase failed at 0x%x\n", c->flash_offset);
+		return -1;
+	}
+
+	if (ota_nand_write(c->flash_offset, data, c->data_size,
+			   c->flash_offset + c->flash_size) != 0) {
+		printf("Write failed at 0x%x\n", c->flash_offset);
+		return -1;
+	}
+
+	if (nand_verify_component(c, data_base) != 0) {
+		printf("Verify failed for %s\n", comp_name(c));
+		return -1;
+	}
+
+	printf("%-12s done\n", comp_name(c));
+	return 0;
+}
+
+
+/*
+ * Load upgrade package from UBI 'upgrade' volume into DDR.
+ * Uses U-Boot native UBI commands via run_command().
+ */
+static int load_upgrade_from_ubi(ulong addr, ulong max_size, ulong *out_size)
+{
+	int ret;
+	char cmd[128];
+
+	/* Attach upgrade partition */
+	snprintf(cmd, sizeof(cmd), "ubi part upgrade");
+	ret = run_command(cmd, 0);
+	if (ret) {
+		printf("load_upgrade: ubi part upgrade failed\n");
+		return -1;
+	}
+
+	/* Read upgrade volume to DDR */
+	snprintf(cmd, sizeof(cmd), "ubi read 0x%lx upgrade 0x%lx", addr, max_size);
+	ret = run_command(cmd, 0);
+	if (ret) {
+		printf("load_upgrade: ubi read failed\n");
+		return -1;
+	}
+
+	/* Get actual filesize from UBI layer */
+	{
+		char *fsz = env_get("filesize");
+		if (fsz)
+			*out_size = simple_strtoul(fsz, NULL, 16);
+		else
+			*out_size = max_size;
+	}
+
+	printf("load_upgrade: loaded %lu bytes from UBI upgrade volume to 0x%lx\n",
+	       *out_size, addr);
+	return 0;
+}
+
+static int do_nand_ota_upgrade(struct cmd_tbl *cmdtp, int flag, int argc,
+			       char *const argv[])
+{
+	ulong addr;
+	struct ota_pkg_header *hdr = NULL;
+	struct ota_pkg_component *table;
+	struct ota_upgrade_flag uflag;
+	u8 *base;
+	u32 i;
+	int ret;
+	int failed = 0;
+	/* 1 = deterministic failure (bad package: version/size/component/CRC/rollback),
+	 *    mark FAILED immediately, no retry.
+	 * 0 = I/O failure (NAND read/write, uflag write, UBI load), retry via retry_count. */
+	int deterministic = 0;
+	ulong pkg_size = 0;
+
+	if (argc < 2) {
+		/* Default load address */
+		addr = 0x42000000;
+	} else {
+		addr = simple_strtoul(argv[1], NULL, 16);
+		if (addr == 0 || addr > 0x80000000) {
+			printf("nand_ota: invalid load address 0x%lx\n", addr);
+			return CMD_RET_FAILURE;
+		}
+	}
+	base = (u8 *)addr;
+
+	ret = nand_mtd_init();
+	if (ret) {
+		printf("nand_ota: NAND init failed\n");
+		return CMD_RET_FAILURE;
+	}
+
+	ret = uflag_read(&uflag);
+	if (ret) {
+		printf("nand_ota: uflag read failed\n");
+		return CMD_RET_FAILURE;
+	}
+
+	if (uflag.magic != OTA_UPGRADE_MAGIC ||
+	    (uflag.state != OTA_STATE_PENDING && uflag.state != OTA_STATE_RUNNING)) {
+		printf("nand_ota: invalid uflag state\n");
+		return CMD_RET_FAILURE;
+	}
+
+	/* PENDING -> RUNNING transition */
+	if (uflag.state == OTA_STATE_PENDING) {
+		uflag.state = OTA_STATE_RUNNING;
+		ret = uflag_write(&uflag);
+		if (ret) {
+			printf("nand_ota: failed to set RUNNING\n");
+			goto fail;
+		}
+		printf("nand_ota: state PENDING -> RUNNING\n");
+	}
+
+	/* Load upgrade package from UBI upgrade volume */
+	ret = load_upgrade_from_ubi(addr, uflag.upgrade_size, &pkg_size);
+	if (ret) {
+		printf("nand_ota: failed to load upgrade package\n");
+		goto fail;
+	}
+
+	hdr = (struct ota_pkg_header *)base;
+
+	/* Validation phase: failures here are deterministic (the package itself is
+	 * invalid, so retrying is pointless). */
+	deterministic = 1;
+
+	if (hdr->magic != OTA_PKG_MAGIC) {
+		printf("nand_ota: bad package magic 0x%08x\n", hdr->magic);
+		goto fail;
+	}
+
+	if (hdr->version != OTA_PKG_VERSION) {
+		printf("nand_ota: unsupported version %u\n", hdr->version);
+		goto fail;
+	}
+
+	if (hdr->total_size < OTA_PKG_HEADER_SIZE + OTA_PKG_SIG_SIZE +
+	    sizeof(struct ota_pkg_component)) {
+		printf("nand_ota: total_size too small (%u)\n", hdr->total_size);
+		goto fail;
+	}
+
+	if (hdr->total_size > MAX_UPGRADE_SIZE) {
+		printf("nand_ota: total_size too large (%u > %u)\n",
+		       hdr->total_size, MAX_UPGRADE_SIZE);
+		goto fail;
+	}
+
+	if (uflag.upgrade_size > 0 && hdr->total_size != uflag.upgrade_size) {
+		printf("nand_ota: total_size mismatch (uflag=%u, pkg=%u)\n",
+		       uflag.upgrade_size, hdr->total_size);
+		goto fail;
+	}
+
+	if (hdr->component_cnt == 0 || hdr->component_cnt > OTA_PKG_MAX_COMPS) {
+		printf("nand_ota: invalid component count (%u)\n",
+		       hdr->component_cnt);
+		goto fail;
+	}
+
+	/* Check component_mask consistency with package */
+	{
+		u32 pkg_comp_mask = 0;
+		u32 j;
+		for (j = 0; j < hdr->component_cnt; j++) {
+			struct ota_pkg_component *c = (struct ota_pkg_component *)
+				((u8 *)base + OTA_PKG_HEADER_SIZE + j * OTA_PKG_COMP_SIZE);
+			u32 bit = comp_bit_by_name((const char *)c->name);
+			if (bit)
+				pkg_comp_mask |= bit;
+		}
+		if (pkg_comp_mask != uflag.component_mask) {
+			printf("nand_ota: component_mask mismatch (pkg=0x%x, uflag=0x%x)\n",
+			       pkg_comp_mask, uflag.component_mask);
+			goto fail;
+		}
+	}
+
+	table = (struct ota_pkg_component *)(base + OTA_PKG_HEADER_SIZE);
+
+	if (validate_nand_components(hdr, table) != 0) {
+		printf("nand_ota: component validation failed\n");
+		goto fail;
+	}
+
+	if (verify_package_crc(hdr, table, base) != 0)
+		goto fail;
+
+	/* Version anti-rollback check */
+	if (hdr->fw_version < uflag.version_new) {
+		printf("nand_ota: version rollback detected (pkg=0x%08x, uflag_new=0x%08x)\n",
+		       hdr->fw_version, uflag.version_new);
+		goto fail;
+	}
+	if (hdr->fw_version < uflag.version_old) {
+		printf("nand_ota: version rollback detected (pkg=0x%08x, uflag_old=0x%08x)\n",
+		       hdr->fw_version, uflag.version_old);
+		goto fail;
+	}
+
+	printf("nand_ota: package v%u, %u components, size=%u\n",
+	       hdr->version, hdr->component_cnt, hdr->total_size);
+
+	/* Validation passed; now flashing. NAND write / uflag write failures here are
+	 * I/O errors and may be retried. */
+	deterministic = 0;
+
+	/*
+	 * No uboot backup needed: OTFL loads this Recovery from the otfl
+	 * partition (which is never an OTA target). A power failure while
+	 * erasing the uboot partition just resumes via the intact otfl
+	 * Recovery on next boot.
+	 */
+
+	/* Component write order: bl31 -> kernel -> rootfs -> uboot */
+	{
+		const char *write_order[] = {"bl31", "kernel", "rootfs", "uboot"};
+		u32 order_idx;
+
+		for (order_idx = 0; order_idx < ARRAY_SIZE(write_order); order_idx++) {
+			for (i = 0; i < hdr->component_cnt; i++) {
+				struct ota_pkg_component *c = &table[i];
+				u32 bit;
+
+				if (c->media != OTA_MEDIA_NAND)
+					continue;
+
+				if (strncmp((const char *)c->name, write_order[order_idx], 16) != 0)
+					continue;
+
+				bit = comp_bit_by_name((const char *)c->name);
+				if (bit == 0) {
+					printf("Skipping %-12s (unknown NAND component)\n", comp_name(c));
+					continue;
+				}
+				if (!(uflag.component_mask & bit)) {
+					printf("Skipping %-12s (not selected by component_mask 0x%x)\n",
+					       comp_name(c), uflag.component_mask);
+					continue;
+				}
+				if (uflag.completed_mask & bit) {
+					printf("Skipping %-12s (already done)\n", comp_name(c));
+					continue;
+				}
+
+				if (nand_write_component(c, base) != 0) {
+					printf("FAILED: %-12s\n", comp_name(c));
+					failed = 1;
+					break;
+				}
+
+				uflag.completed_mask |= bit;
+				if (uflag_write(&uflag) != 0) {
+					printf("FAILED to update uflag completed_mask\n");
+					failed = 1;
+					break;
+				}
+			}
+			if (failed)
+				break;
+		}
+	}
+
+	if (failed)
+		goto fail;
+
+	/* Success: clear uflag to IDLE */
+	uflag.state = OTA_STATE_IDLE;
+	uflag.completed_mask = 0;
+	if (uflag_write(&uflag) != 0) {
+		printf("nand_ota: failed to clear uflag\n");
+		goto fail;
+	}
+
+	{
+		struct ota_upgrade_flag verify;
+		if (uflag_read(&verify) != 0 ||
+		    verify.state != OTA_STATE_IDLE) {
+			printf("nand_ota: uflag clear verification failed\n");
+			goto fail;
+		}
+		printf("nand_ota: uflag cleared and verified OK\n");
+	}
+
+	printf("nand_ota: SUCCESS, resetting...\n");
+	do_reset(NULL, 0, 0, NULL);
+	return CMD_RET_SUCCESS;
+
+fail:
+	/* Distinguish failure type via the deterministic flag instead of reading hdr:
+	 * some failures happen before hdr is assigned, so dereferencing hdr here
+	 * would be unsafe.
+	 *   deterministic=1 (invalid package) -> mark FAILED immediately;
+	 *   deterministic=0 (I/O error)       -> retry via retry_count. */
+	if (deterministic) {
+		uflag.state = OTA_STATE_FAILED;
+		printf("nand_ota: deterministic failure, marking FAILED\n");
+	} else if (uflag.retry_count > 0) {
+		uflag.retry_count--;
+		if (uflag.retry_count == 0) {
+			uflag.state = OTA_STATE_FAILED;
+			printf("nand_ota: retries exhausted, marking FAILED\n");
+		} else {
+			printf("nand_ota: FAILED, retry_count=%u, resetting...\n",
+			       uflag.retry_count);
+		}
+	} else {
+		uflag.state = OTA_STATE_FAILED;
+		printf("nand_ota: no retries left, marking FAILED\n");
+	}
+
+	if (uflag_write(&uflag) != 0)
+		printf("nand_ota: failed to write uflag on fail path\n");
+	do_reset(NULL, 0, 0, NULL);
+	return CMD_RET_FAILURE;
+}
+
+U_BOOT_CMD(nand_ota_upgrade, 2, 1, do_nand_ota_upgrade,
+	   "NAND OTA upgrade from UBI upgrade volume",
+	   "[addr]  - load upgrade pkg from UBI and flash components (default addr=0x42000000)\n");
