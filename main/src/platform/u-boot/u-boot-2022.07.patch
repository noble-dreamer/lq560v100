diff --git a/arch/arm/mach-kirkwood/omp.c b/arch/arm/mach-kirkwood/omp.c
new file mode 100644
index 00000000..d4d98c48
--- /dev/null
+++ b/arch/arm/mach-kirkwood/omp.c
@@ -0,0 +1,91 @@
+/*
+ * arch/arm/mach-kirkwood/omp.c
+ *
+ * OMP functions for Marvell Kirkwood SoCs
+ * Referenced from Linux kernel source
+ *
+ * This file is licensed under the terms of the GNU General Public
+ * License version 2.  This program is licensed "as is" without any
+ * warranty of any kind, whether express or implied.
+ */
+
+#include <common.h>
+#include <log.h>
+#include <asm/io.h>
+#include <asm/arch/cpu.h>
+#include <asm/arch/soc.h>
+#include <asm/arch/omp.h>
+
+static u32 kirkwood_variant(void)
+{
+	switch (readl(KW_REG_DEVICE_ID) & 0x03) {
+	case 1:
+		return OMP_F6192_MASK;
+	case 2:
+		return OMP_F6281_MASK;
+	default:
+		debug("OMP setup: unknown kirkwood variant\n");
+		return 0;
+	}
+}
+
+#define OMP_CTRL(i)	(KW_OMP_BASE + (i* 4))
+#define OMP_NR_REGS	(1 + OMP_MAX/8)
+
+void kirkwood_omp_conf(const u32 *omp_list, u32 *omp_save)
+{
+	u32 omp_ctrl[OMP_NR_REGS];
+	unsigned int variant_mask;
+	int i;
+
+	variant_mask = kirkwood_variant();
+	if (!variant_mask)
+		return;
+
+	debug( "initial OMP regs:");
+	for (i = 0; i < OMP_NR_REGS; i++) {
+		omp_ctrl[i] = readl(OMP_CTRL(i));
+		debug(" %08x", omp_ctrl[i]);
+	}
+	debug("\n");
+
+
+	while (*omp_list) {
+		unsigned int num = OMP_NUM(*omp_list);
+		unsigned int sel = OMP_SEL(*omp_list);
+		unsigned int sel_save;
+		int shift;
+
+		if (num > OMP_MAX) {
+			debug("kirkwood_omp_conf: invalid OMP "
+					"number (%u)\n", num);
+			continue;
+		}
+		if (!(*omp_list & variant_mask)) {
+			debug("kirkwood_omp_conf: requested OMP%u config "
+				"unavailable on this hardware\n", num);
+			continue;
+		}
+
+		shift = (num & 7) << 2;
+
+		if (omp_save) {
+			sel_save = (omp_ctrl[num / 8] >> shift) & 0xf;
+			*omp_save = num | (sel_save << 8) | variant_mask;
+			omp_save++;
+		}
+
+		omp_ctrl[num / 8] &= ~(0xf << shift);
+		omp_ctrl[num / 8] |= sel << shift;
+
+		omp_list++;
+	}
+
+	debug("  final OMP regs:");
+	for (i = 0; i < OMP_NR_REGS; i++) {
+		writel(omp_ctrl[i], OMP_CTRL(i));
+		debug(" %08x", omp_ctrl[i]);
+	}
+	debug("\n");
+
+}
