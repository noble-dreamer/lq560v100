diff --git a/product/quickboot_sensor/hal/sensor/imx290/imx290_sensor_ctl.c b/product/quickboot_sensor/hal/sensor/imx290/imx290_sensor_ctl.c
new file mode 100644
index 00000000..1bf24694
--- /dev/null
+++ b/product/quickboot_sensor/hal/sensor/imx290/imx290_sensor_ctl.c
@@ -0,0 +1,137 @@
+#include "hal_sensor.h"
+#include <common.h>
+#include "hal_i2c.h"
+
+#define IMX290_BUF_LEN      8
+#define IMX290_I2C_ADDR     0x34
+#define IMX290_ADDR_BYTE    2
+
+#define imx290_write_register(i2c_num, addr, data)    \
+    hal_i2c_write_byte(i2c_num, IMX290_I2C_ADDR, addr, IMX290_ADDR_BYTE, data)
+
+static void imx290_wdr2t0_2m60_10bit_init(unsigned char i2c_num)
+{
+    int ret = 0;
+    ret += imx290_write_register(i2c_num, 0x3000, 0x01);  /* standby */
+
+    ret += imx290_write_register(i2c_num, 0x3002, 0x00);  /* XTMSTA */
+    ret += imx290_write_register(i2c_num, 0x3005, 0x00);
+    ret += imx290_write_register(i2c_num, 0x3007, 0x00);
+    ret += imx290_write_register(i2c_num, 0x3009, 0x00);
+    ret += imx290_write_register(i2c_num, 0x300a, 0x3c);
+    ret += imx290_write_register(i2c_num, 0x300c, 0x11);
+    ret += imx290_write_register(i2c_num, 0x300f, 0x00);
+    ret += imx290_write_register(i2c_num, 0x3010, 0x21);
+    ret += imx290_write_register(i2c_num, 0x3012, 0x64);
+    ret += imx290_write_register(i2c_num, 0x3016, 0x09);
+    ret += imx290_write_register(i2c_num, 0x3018, 0x65);  /* VMAX */
+    ret += imx290_write_register(i2c_num, 0x3019, 0x04);  /* VMAX */
+    ret += imx290_write_register(i2c_num, 0x301c, 0x4C);  /* HMAX */
+    ret += imx290_write_register(i2c_num, 0x301d, 0x04);  /* HMAX */
+
+    ret += imx290_write_register(i2c_num, 0x3020, 0x02);  /* SHS1 */
+    ret += imx290_write_register(i2c_num, 0x3021, 0x00);
+    ret += imx290_write_register(i2c_num, 0x3024, 0xC9);  /* SHS2 */
+    ret += imx290_write_register(i2c_num, 0x3025, 0x07);
+    ret += imx290_write_register(i2c_num, 0x3030, 0x0B);  /* RHS1 */
+    ret += imx290_write_register(i2c_num, 0x3031, 0x00);
+
+    ret += imx290_write_register(i2c_num, 0x3045, 0x05);
+    ret += imx290_write_register(i2c_num, 0x3046, 0x00);
+    ret += imx290_write_register(i2c_num, 0x304b, 0x0a);
+    ret += imx290_write_register(i2c_num, 0x305c, 0x18);
+    ret += imx290_write_register(i2c_num, 0x305d, 0x03);
+    ret += imx290_write_register(i2c_num, 0x305e, 0x20);
+    ret += imx290_write_register(i2c_num, 0x305f, 0x01);
