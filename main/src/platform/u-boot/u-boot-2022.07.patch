+        (td_void)drv_cipher_symc_destroy(symc_ctx->drv_symc_handle);
+    }
+
+    crypto_mutex_unlock(&symc_channel->symc_ctx_mutex[idx]);
+    crypto_kapi_func_exit();
+    return ret;
+
+error_mac_finish:
+    if (symc_ctx->is_long_term == TD_FALSE) {
