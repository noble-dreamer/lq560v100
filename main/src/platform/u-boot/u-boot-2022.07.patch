+
+unsigned int ddrtrn_hal_get_trfc_threshold1_val(unsigned int base_phy)
+{
+	return ddrtrn_reg_read(base_phy + DDR_PHY_TRFC_THRESHOLD1);
+}
+
+unsigned int ddrtrn_hal_get_dmsel(unsigned int base_phy)
+{
