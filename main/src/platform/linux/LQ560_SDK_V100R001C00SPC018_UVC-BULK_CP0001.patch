+static void dwc3_prepare_one_trb_for_uvc(struct dwc3_ep *dep,
+		struct dwc3_request *req, struct scatterlist *sg_first, struct scatterlist *sg_second, unsigned last)
+{
+	struct dwc3_trb		*trb;
+	unsigned int		length_first, length_second;
+	dma_addr_t dma_first = 0;
+	dma_addr_t dma_second = 0;
+	int i;
+	u8 *mem = sg_virt(sg_second);
+
+	dma_first = sg_dma_address(sg_first);
+	length_first = sg_dma_len(sg_first);
+
+	for (i = 0; i < 8; i++)
+		dma_second = (dma_second << 8) | mem[i];
+	length_second = (mem[8] << 24) | (mem[9] << 16) | (mem[10] << 8) | (mem[11]);
+	if (length_second == 0) {
+		printk(KERN_EMERG"length_second == 0; [%x %x %x %x %x %x %x %x] [%x %x %x %x]\n",
+			mem[0], mem[1], mem[2], mem[3], mem[4], mem[5], mem[6], mem[7], mem[8], mem[9], mem[10], mem[11]);
+	}
+	trb = &dep->trb_pool[dep->trb_enqueue];
+	if (!req->trb) {
+		dwc3_gadget_move_started_request(req);
+		req->trb = trb;
+		req->trb_dma = dwc3_trb_dma_offset(dep, trb);
+	}
+	req->num_trbs++;
+	__dwc3_prepare_one_trb_for_uvc(dep, trb, dma_first,
+			length_first, length_second, true,
+			false, req->request.no_interrupt);
+
+	trb = &dep->trb_pool[dep->trb_enqueue];
+	if (!req->trb) {
+		dwc3_gadget_move_started_request(req);
+		req->trb = trb;
+		req->trb_dma = dwc3_trb_dma_offset(dep, trb);
+	}
+	req->num_trbs++;
+	__dwc3_prepare_one_trb_for_uvc(dep, trb, dma_second,
+			length_second, 0, false,
+			last, req->request.no_interrupt);
+}
