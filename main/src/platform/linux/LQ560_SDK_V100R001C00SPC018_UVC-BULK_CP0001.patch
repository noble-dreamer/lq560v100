+void uvc_still_check_commit_status(struct still_image *still, int select, int interface)
+{
+	if (select == UVC_STILL_IMAGE_COMMIT && interface == UVC_STILL_IMAGE_INTERFACE && uvc_still_is_md2(still)) {
+		iprec("still image method%d to STILL_COMMIT status", still->still_capture_method);
+		still->still_status = STILL_COMMIT;	  /* Only still image method2 usb STILL_COMMIT state. */
+	}
