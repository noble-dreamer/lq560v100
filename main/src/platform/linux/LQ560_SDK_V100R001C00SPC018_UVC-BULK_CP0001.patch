+static void __dwc3_prepare_one_trb_for_uvc(struct dwc3_ep *dep, struct dwc3_trb *trb,
+		dma_addr_t dma, unsigned length, unsigned length_second, unsigned chain, unsigned last, unsigned no_interrupt)
+{
+	struct dwc3		*dwc = dep->dwc;
+	struct usb_gadget	*gadget = dwc->gadget;
+	enum usb_device_speed	speed = gadget->speed;
+
+	trb->size = DWC3_TRB_SIZE_LENGTH(length);
+	trb->bpl = lower_32_bits(dma);
+	trb->bph = upper_32_bits(dma);
+
+	if (usb_endpoint_xfer_isoc(dep->endpoint.desc)) {
+		if (chain)
+			trb->ctrl = DWC3_TRBCTL_ISOCHRONOUS_FIRST;
+		else
+			trb->ctrl = DWC3_TRBCTL_ISOCHRONOUS;
+		/* always enable Interrupt on Missed ISOC */
+		trb->ctrl |= DWC3_TRB_CTRL_ISP_IMI;
+	} else if (usb_endpoint_xfer_bulk(dep->endpoint.desc)) {
+		trb->ctrl = DWC3_TRBCTL_NORMAL;
+	}
+
+	if (chain) {
+		trb->ctrl |= DWC3_TRB_CTRL_CHN;
+
+		if (speed == USB_SPEED_HIGH) {
+				struct usb_ep *ep = &dep->endpoint;
+				unsigned int mult = 2;
+				unsigned int maxp = usb_endpoint_maxp(ep->desc);
+
+				if (length_second <= (2 * maxp))
+					mult--;
+
+				if (length_second <= maxp)
+					mult--;
+
+				trb->size |= DWC3_TRB_SIZE_PCM1(mult);
+		}
+
+	} else {
+		if (dep->stream_capable && last)
+			trb->ctrl |= DWC3_TRB_CTRL_LST;
+	}
+
+	if (!no_interrupt && !chain)
+		trb->ctrl |= DWC3_TRB_CTRL_ISP_IMI;
+
+	if (last || (dwc3_calc_trbs_left(dep) == 1))
+		trb->ctrl |= DWC3_TRB_CTRL_IOC;
+
+	trb->ctrl |= DWC3_TRB_CTRL_HWO;
+
+	dwc3_ep_inc_enq(dep);
+
+	if (last)
+		iprec(" %s Prepare TRB:%04d in pool[0x%x] [%x %x %x %x] %d length:%d %s%s%s%sHWO CTL%d",
+			dep->name, dep->trb_enqueue, dep->trb_pool_dma, trb->bpl, trb->bph, trb->size, trb->ctrl,
+			(trb->size >> 24) & 0x3, trb->size & DWC3_TRB_SIZE_MASK,
+			(trb->ctrl & DWC3_TRB_CTRL_IOC) ? "IOC " : "",
+			(trb->ctrl & DWC3_TRB_CTRL_CSP) ? "CSP " : "",
+			(trb->ctrl & DWC3_TRB_CTRL_CHN) ? "CHN " : "",
+			(trb->ctrl & DWC3_TRB_CTRL_LST) ? "LST " : "",
+			((trb->ctrl >> 4) & 0x3f));
+}
