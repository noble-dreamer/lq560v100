# =============================================================================
# board-network-setup / config.env
# 集中定义所有可能因切换电脑或设备而变化的参数
# 使用前根据实际环境修改本文件
# =============================================================================

# -------- WSL 配置 --------
WSL_DISTRO=Ubuntu
WSL_USER=lzx

# -------- NFS 共享目录（WSL 内 ext4 路径） --------
# Direct Windows <-> board SSH does not use NFS.  Keep this path accurate for
# optional future NFS use rather than inheriting the old machine's path.
NFS_EXPORT_DIR=/home/lzx/lq560v100_sdk

# -------- 网络地址 --------
# PC 端 RNDIS 网卡 IP（板子的网关）
PC_RNDIS_IP=192.168.1.3
# 板子 USB 网口 IP
BOARD_IP=192.168.1.101
# 子网掩码
SUBNET_MASK=255.255.255.0
SUBNET_CIDR=24

# -------- NFS 固定端口 --------
PORT_RPCBIND=111
PORT_NFS=2049
PORT_MOUNTD=20048

# -------- 板子端挂载 --------
BOARD_NFS_MOUNTPOINT=/tmp/nfs
BOARD_NFS_OPTS="nolock,vers=3,proto=tcp,soft,timeo=30,rsize=8192,wsize=8192"

# -------- USB Gadget --------
USB_VID=0x3ef5
USB_PID=0x15b0
USB_MANUFACTURER="Linux"
USB_PRODUCT="RNDIS+ACM Gadget"

# =============================================================================
# ⚠ PER-MACHINE VARIABLES — 以下参数每台电脑/每次 WSL 重启都可能变化
#    换电脑后先运行: powershell -File scripts\detect_env.ps1
#    它会自动检测并告诉你哪些值需要修改
# =============================================================================

# -------- WSL 子网（用于板子回程路由）--------
# ★ AUTO-DETECT: 运行 detect_env.ps1 获取当前实际值
# WSL 子网在不同电脑/不同 WSL 版本/Windows 更新后可能不同
# 已知变化: 172.29.192.0/20 (某台机器), 172.23.224.0/20 (另一台)
# 当前机器使用 mirrored WSL 网络；当前地址段为 10.10.10.0/24。
# Direct Windows SSH does not install a board return route, so this is only for
# an explicitly configured future WSL/NFS workflow.
WSL_SUBNET=10.10.10.0/24

# -------- 串口（板子调试串口）--------
# ★ AUTO-DETECT: 运行 detect_env.ps1 列出可用串口
# COM5  = RNDIS 模式下 USB-ACM 升级触发协议口（upgrade_triggerd，非 getty）
# COM7  = UVC 模式下 USB-ACM（该模式下为 getty 控制台）
# COM6  = CH340C 硬件调试串口（当前未连接）
# COM8  = CH340C 硬件调试串口（命令控制台，115200）
# COM13 = CH340 硬件调试串口 (另一台机器)
# COM14 = CH340 历史环境
# 确认方法: [System.IO.Ports.SerialPort]::GetPortNames()
SERIAL_PORT=COM8
SERIAL_BAUD=115200
