# SD3589C OpenSSH 9.9 Server Configuration
Port 22
ListenAddress 0.0.0.0

# Host keys (auto-generated on first boot)
HostKey /data/openssh/etc/ssh/ssh_host_rsa_key
HostKey /data/openssh/etc/ssh/ssh_host_ed25519_key

# Authentication
PermitRootLogin yes
PasswordAuthentication yes
PermitEmptyPasswords no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys

# SFTP
Subsystem sftp /data/openssh/bin/sftp-server

# Logging
SyslogFacility AUTH
LogLevel INFO

# Misc
PrintMotd yes
UseDNS no
