++
++	uflag_set_env(&uflag);
++
++	if (uflag.state == OTA_STATE_PENDING || uflag.state == OTA_STATE_RUNNING) {
++		printf("misc_check: upgrade pending (state=%u)\n", uflag.state);
++		return 1;	/* return 1 so bootcmd 'test $? -eq 1' triggers upgrade */
++	}
++
++	printf("misc_check: no upgrade (state=%u)\n", uflag.state);
++	return 0;
++}
