++/*
++ * ---- Bad-block aware NAND accessors (3589E CP006/CP009 style) ----
++ *
++ * The boot path reads images via `nand read` (nand_read_skip_bad): data
++ * is laid out contiguously in good-block space, skipping bad blocks
++ * within the partition's physical region. Upgrade writes MUST use the
++ * same layout or the system boots a misaligned image.
++ *
++ * erase: erase each good block in the region; on erase failure mark the
++ *        block bad (mtd_block_markbad, updates on-flash BBT + RAM BBT).
++ * write: write data contiguously skipping bad blocks; on write failure
++ *        mark the block bad and rewrite the SAME data chunk to the next
++ *        good block (source data is NOT consumed by a failed block).
++ * read:  read contiguously skipping bad blocks (matches boot path).
++ */
++
++static int ota_nand_erase(uint32_t offset, uint32_t len)
++{
++	uint32_t cur = offset & ~(NAND_BLOCK_SIZE - 1);
++	uint32_t end = offset + len;
++	int erased = 0;
++
++	while (cur < end) {
++		if (nand_block_isbad(nand_mtd, cur)) {
++			printf("ota_nand_erase: skip bad block 0x%x\n", cur);
++			cur += NAND_BLOCK_SIZE;
++			continue;
++		}
++
++		if (nand_erase(nand_mtd, cur, NAND_BLOCK_SIZE)) {
++			printf("ota_nand_erase: block 0x%x erase failed, marking bad\n",
++			       cur);
++			mtd_block_markbad(nand_mtd, cur);
++			cur += NAND_BLOCK_SIZE;
++			continue;
++		}
++		erased++;
++		cur += NAND_BLOCK_SIZE;
++	}
++
++	/* all-fail guard: nothing erased means either all-bad region or a
++	 * hardware problem; proceeding to write would be meaningless */
++	if (erased == 0) {
++		printf("ota_nand_erase: no block erased in [0x%x, 0x%x)\n",
++		       offset, end);
++		return -1;
++	}
++	return 0;
++}
++
++static int ota_nand_write(uint32_t offset, const uint8_t *data, uint32_t len,
++			  uint32_t limit)
++{
++	uint32_t cur = offset;
++	uint32_t done = 0;
++
++	while (done < len) {
++		uint32_t blk_start = cur & ~(NAND_BLOCK_SIZE - 1);
++		uint32_t blk_off = cur - blk_start;
++		uint32_t chunk = NAND_BLOCK_SIZE - blk_off;
++		size_t wr;
++		int ret;
++
++		/* partition end guard: too many consecutive bad blocks must
++		 * NOT spill the write into the next partition */
++		if (cur >= limit) {
++			printf("ota_nand_write: no space left before 0x%x "
++			       "(done %u/%u, too many bad blocks)\n",
++			       limit, done, len);
++			return -1;
++		}
++
++		if (chunk > len - done)
++			chunk = len - done;
++
++		if (nand_block_isbad(nand_mtd, blk_start)) {
++			printf("ota_nand_write: skip bad block 0x%x\n", blk_start);
++			cur = blk_start + NAND_BLOCK_SIZE;
++			continue;
++		}
++
++		wr = chunk;
++		ret = nand_write(nand_mtd, cur, &wr, (u_char *)(data + done));
++		if (ret || wr != chunk) {
++			printf("ota_nand_write: block 0x%x write failed, marking bad\n",
++			       blk_start);
++			mtd_block_markbad(nand_mtd, blk_start);
++			/* same data chunk is rewritten to the next good block */
++			cur = blk_start + NAND_BLOCK_SIZE;
++			continue;
++		}
++
++		done += chunk;
++		cur += chunk;
++	}
++	return 0;
++}
++
++static int ota_nand_read(uint32_t offset, uint8_t *buf, uint32_t len,
++			 uint32_t limit)
++{
++	uint32_t cur = offset;
++	uint32_t done = 0;
++
++	while (done < len) {
++		uint32_t blk_start = cur & ~(NAND_BLOCK_SIZE - 1);
++		uint32_t blk_off = cur - blk_start;
++		uint32_t chunk = NAND_BLOCK_SIZE - blk_off;
++		size_t rd;
++		int ret;
++
++		if (cur >= limit) {
++			printf("ota_nand_read: read past 0x%x "
++			       "(done %u/%u, too many bad blocks)\n",
++			       limit, done, len);
++			return -1;
++		}
++
++		if (chunk > len - done)
++			chunk = len - done;
++
++		if (nand_block_isbad(nand_mtd, blk_start)) {
++			cur = blk_start + NAND_BLOCK_SIZE;
++			continue;
++		}
++
++		rd = chunk;
++		ret = nand_read(nand_mtd, cur, &rd, buf + done);
++		if (ret) {
++			printf("ota_nand_read: read failed at 0x%x\n", cur);
++			return -1;
++		}
++
++		done += chunk;
++		cur += chunk;
++	}
++	return 0;
++}
++
++/*
++ * Read uflag from NAND with 4-page redundancy.
++ *
++ * 3589E strategy: read ALL copies and pick the valid one with the
++ * largest completed_mask. completed_mask doubles as the "newest token",
++ * so no sequence number field is needed. This prevents a stale copy
++ * (e.g. an old RUNNING state left in a copy whose erase failed during
++ * a previous write) from being revived.
++ *
++ * Returns 0 and fills *flag on success, -1 if no valid copy.
++ */
++static int uflag_read(struct ota_upgrade_flag *flag)
++{
++	struct ota_upgrade_flag cand;
++	int i;
++	u32 calc_crc;
++	u32 best_mask = 0;
++	int found = 0;
++
++	if (nand_mtd_init())
++		return -1;
++
++	for (i = 0; i < UFLAG_REDUNDANT_NUM; i++) {
++		size_t offset = UFLAG_PART_OFFSET + i * UFLAG_REDUNDANT_STRIDE;
++		size_t len;
++		int ret;
++
++		/* a factory/runtime bad block just makes this copy unusable;
++		 * redundancy covers it - skip, do NOT relocate (fixed stride) */
++		if (nand_block_isbad(nand_mtd, offset))
++			continue;
++
++		len = sizeof(cand);
++		ret = nand_read(nand_mtd, offset, &len, (u_char *)&cand);
++		if (ret)
++			continue;
++
++		if (cand.magic != OTA_UPGRADE_MAGIC)
++			continue;
++
++		if (cand.version != OTA_UPGRADE_FLAG_VERSION)
++			continue;
++
++		calc_crc = crc32(0, (const unsigned char *)&cand,
++				 sizeof(cand) - sizeof(cand.crc32));
++		if (calc_crc != cand.crc32)
++			continue;
++
++		/* pick the valid copy with the largest completed_mask */
++		if (!found || cand.completed_mask > best_mask) {
++			memcpy(flag, &cand, sizeof(*flag));
++			best_mask = cand.completed_mask;
++			found = 1;
++		}
++	}
++
++	if (!found) {
++		printf("uflag_read: no valid copy found\n");
++		return -1;
++	}
++
++	printf("uflag_read: state=%u completed_mask=0x%x\n",
++	       flag->state, flag->completed_mask);
++	return 0;
++}
++
++/*
++ * Write uflag to 4 redundant copies in REVERSE order (copy 3 -> copy 0).
++ *
++ * Copy 0 is written last: if power fails mid-sequence, copy 0 (the one
++ * most readers check first) still holds the previous consistent state,
++ * while the newer copies further in already hold the new state. Combined
++ * with uflag_read picking max(completed_mask), a torn write recovers to
++ * the newest available state instead of a stale one.
++ *
++ * Tolerates partial failure: success if at least one copy was written.
++ */
++static int uflag_write(struct ota_upgrade_flag *flag)
++{
++	static u8 page_buf[NAND_PAGE_SIZE];
++	int i;
++	int ok = 0;
++
++	if (nand_mtd_init())
++		return -1;
++
++	flag->crc32 = crc32(0, (const unsigned char *)flag,
++			    sizeof(*flag) - sizeof(flag->crc32));
++
++	/* write one full NAND page (2KB): flag + 0xFF padding.
++	 * sub-page writes are unreliable on drivers without subpage
++	 * support and match the ota_prepare side (2048B page write) */
++	memset(page_buf, 0xFF, sizeof(page_buf));
++	memcpy(page_buf, flag, sizeof(*flag));
++
++	for (i = UFLAG_REDUNDANT_NUM - 1; i >= 0; i--) {
++		size_t offset = UFLAG_PART_OFFSET + i * UFLAG_REDUNDANT_STRIDE;
++		size_t len;
++		int r;
++
++		/* bad block: skip this copy (fixed stride, redundancy covers it) */
++		if (nand_block_isbad(nand_mtd, offset))
++			continue;
++
++		r = nand_erase(nand_mtd, offset, UFLAG_REDUNDANT_STRIDE);
++		if (r) {
++			printf("uflag_write: copy %d erase failed at 0x%zx\n", i, offset);
++			mtd_block_markbad(nand_mtd, offset);
++			continue;
++		}
++
++		len = sizeof(page_buf);
++		r = nand_write(nand_mtd, offset, &len, page_buf);
++		if (r) {
++			printf("uflag_write: copy %d write failed at 0x%zx\n", i, offset);
++			mtd_block_markbad(nand_mtd, offset);
++			continue;
++		}
++		ok++;
++	}
++
++	if (ok == 0) {
++		printf("uflag_write: all %d copies failed\n", UFLAG_REDUNDANT_NUM);
++		return -1;
++	}
++	if (ok < UFLAG_REDUNDANT_NUM)
++		printf("uflag_write: warning: only %d/%d copies written\n",
++		       ok, UFLAG_REDUNDANT_NUM);
++	return 0;
++}
++
++static void uflag_set_env(struct ota_upgrade_flag *flag)
++{
++	char buf[16];
++
++	snprintf(buf, sizeof(buf), "%u", flag->state);
++	env_set("misc_state", buf);
++	snprintf(buf, sizeof(buf), "%u", flag->upgrade_source);
++	env_set("upgrade_source", buf);
++	snprintf(buf, sizeof(buf), "%u", flag->upgrade_size);
++	env_set("upgrade_size", buf);
++	snprintf(buf, sizeof(buf), "%u", flag->completed_mask);
++	env_set("completed_mask", buf);
++	snprintf(buf, sizeof(buf), "%u", flag->retry_count);
++	env_set("retry_count", buf);
++}
