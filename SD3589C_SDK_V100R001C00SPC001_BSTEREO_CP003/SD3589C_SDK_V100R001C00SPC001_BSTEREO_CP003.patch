++static const char *comp_name(struct ota_pkg_component *c)
++{
++	static char buf[17];
++	memcpy(buf, c->name, 16);
++	buf[16] = '\0';
++	return buf;
++}
++
++static u32 comp_bit_by_name(const char *name)
++{
++	if (strncmp(name, "bl31", 16) == 0)
++		return OTA_COMP_BL31;
++	if (strncmp(name, "kernel", 16) == 0)
++		return OTA_COMP_KERNEL;
++	if (strncmp(name, "rootfs", 16) == 0)
++		return OTA_COMP_ROOTFS;
++	if (strncmp(name, "uboot", 16) == 0)
++		return OTA_COMP_UBOOT;
++	if (strncmp(name, "userfs", 16) == 0)
++		return OTA_COMP_USERFS;
++	if (strncmp(name, "data", 16) == 0)
++		return OTA_COMP_DATA;
++	return 0;
++}
++
++static int is_nand_component_allowed(struct ota_pkg_component *c)
++{
++	if (c->media != OTA_MEDIA_NAND)
++		return 0;
++	if (comp_bit_by_name((const char *)c->name) == 0) {
++		printf("validate: unknown NAND component '%s'\n", comp_name(c));
++		return 0;
++	}
++	/* userfs/data components not allowed in V1.1 - UBIFS dynamic volumes, not raw partitions */
++	if (strncmp((const char *)c->name, "userfs", 16) == 0 ||
++	    strncmp((const char *)c->name, "data", 16) == 0) {
++		printf("validate: '%s' component not allowed (UBIFS dynamic volume, not raw partition)\n",
++		       comp_name(c));
++		return 0;
++	}
++	/*
++	 * uboot component is safe: OTFL checks uflag at boot and loads this
++	 * Recovery U-Boot from the otfl partition when PENDING/RUNNING.
++	 * The uboot partition being erased is NOT the medium we run from.
++	 * If power fails mid-write, next boot OTFL falls back to the intact
++	 * otfl-resident Recovery and resumes the upgrade.
++	 */
++	return 1;
++}
++
++static int validate_nand_components(struct ota_pkg_header *hdr,
++				    struct ota_pkg_component *table)
++{
++	u32 i;
++	u32 data_start = OTA_PKG_HEADER_SIZE + hdr->component_cnt * OTA_PKG_COMP_SIZE;
++
++	if (hdr->component_cnt == 0 || hdr->component_cnt > OTA_PKG_MAX_COMPS) {
++		printf("validate: invalid component count %u\n", hdr->component_cnt);
++		return -1;
++	}
++
++	for (i = 0; i < hdr->component_cnt; i++) {
++		struct ota_pkg_component *c = &table[i];
++		u32 end;
++
++		if (c->media != OTA_MEDIA_NAND) {
++			printf("validate: skipping non-NAND component '%s' (media=%u)\n",
++			       comp_name(c), c->media);
++			continue;
++		}
++
++		if (!is_nand_component_allowed(c))
++			return -1;
++
++		if (c->flash_size == 0 || c->data_size == 0 ||
++		    c->data_size > c->flash_size) {
++			printf("validate: '%s' bad size (flash=%u data=%u)\n",
++			       comp_name(c), c->flash_size, c->data_size);
++			return -1;
++		}
++
++		/* spec #12: flash_offset/flash_size must be 128KB block aligned,
++		 * otherwise erase geometry is ambiguous */
++		if ((c->flash_offset & (NAND_BLOCK_SIZE - 1)) != 0 ||
++		    (c->flash_size & (NAND_BLOCK_SIZE - 1)) != 0) {
++			printf("validate: '%s' not 128KB aligned (off=0x%x size=0x%x)\n",
++			       comp_name(c), c->flash_offset, c->flash_size);
++			return -1;
++		}
++
++		end = c->flash_offset + c->flash_size;
++		if (end > NAND_FLASH_SIZE) {
++			printf("validate: '%s' exceeds NAND size (0x%x)\n",
++			       comp_name(c), end);
++			return -1;
++		}
++
++		/* protect otfl and uflag regions */
++		if (c->flash_offset < PART_OFFSET_UBOOT) {
++			printf("validate: '%s' overlaps protected region\n",
++			       comp_name(c));
++			return -1;
++		}
++
++		/* match known partition bounds */
++		if (strncmp((const char *)c->name, "bl31", 16) == 0 &&
++		    (c->flash_offset != PART_OFFSET_BL31 ||
++		     c->flash_size > PART_SIZE_BL31))
++			goto bad_bounds;
++		if (strncmp((const char *)c->name, "kernel", 16) == 0 &&
++		    (c->flash_offset != PART_OFFSET_KERNEL ||
++		     c->flash_size > PART_SIZE_KERNEL))
++			goto bad_bounds;
++		if (strncmp((const char *)c->name, "rootfs", 16) == 0 &&
++		    (c->flash_offset != PART_OFFSET_ROOTFS ||
++		     c->flash_size > PART_SIZE_ROOTFS))
++			goto bad_bounds;
++		if (strncmp((const char *)c->name, "uboot", 16) == 0 &&
++		    (c->flash_offset != PART_OFFSET_UBOOT ||
++		     c->flash_size > PART_SIZE_UBOOT))
++			goto bad_bounds;
++
++		/* check overlap with other NAND components */
++		{
++			u32 j;
++
++			for (j = 0; j < i; j++) {
++				struct ota_pkg_component *p = &table[j];
++				u32 p_end;
++
++				if (p->media != OTA_MEDIA_NAND)
++					continue;
++				p_end = p->flash_offset + p->flash_size;
++				if (c->flash_offset < p_end &&
++				    p->flash_offset < end) {
++					printf("validate: '%s' [0x%x,0x%x) overlaps '%s' [0x%x,0x%x)\n",
++					       comp_name(c), c->flash_offset, end,
++					       comp_name(p), p->flash_offset, p_end);
++					return -1;
++				}
++			}
++		}
++
++		if (c->data_offset < data_start ||
++		    c->data_offset + c->data_size > hdr->total_size) {
++			printf("validate: '%s' data out of range\n", comp_name(c));
++			return -1;
++		}
++		continue;
++
++bad_bounds:
++		printf("validate: '%s' bounds mismatch\n", comp_name(c));
++		return -1;
++	}
++
++	return 0;
++}
++
++static int verify_package_crc(struct ota_pkg_header *hdr,
++			      struct ota_pkg_component *table, u8 *base)
++{
++	u32 data_start = OTA_PKG_HEADER_SIZE;
++	u32 signed_end = hdr->total_size - OTA_PKG_SIG_SIZE; /* exclude signature slot */
++	u32 calc_crc;
++	u8 header_copy[OTA_PKG_HEADER_SIZE];
++
++	/*
++	 * CRC covers the full header with package_crc zeroed out, plus the
++	 * component table and data area.
++	 */
++	memcpy(header_copy, base, OTA_PKG_HEADER_SIZE);
++	/* package_crc is stored at offset 16 in the header */
++	memset(header_copy + 16, 0, 4);
++	calc_crc = crc32(0, header_copy, OTA_PKG_HEADER_SIZE);
++	calc_crc = crc32(calc_crc, base + data_start, signed_end - data_start);
++
++	if (calc_crc != hdr->package_crc) {
++		printf("verify_package_crc: mismatch (expected 0x%08x, got 0x%08x)\n",
++		       hdr->package_crc, calc_crc);
++		return -1;
++	}
++	printf("verify_package_crc: OK (0x%08x)\n", calc_crc);
++	return 0;
++}
++
++#define VERIFY_CHUNK_SIZE	(128 * 1024)	/* 128KB chunks to stay within malloc pool */
++
++static int nand_verify_component(struct ota_pkg_component *c, u8 *data_base)
++{
++	u8 *verify_buf;
++	u32 crc;
++	size_t len;
++	size_t remaining;
++	size_t offset;
++	u8 *data = data_base + c->data_offset;
++
++	verify_buf = memalign(ARCH_DMA_MINALIGN, VERIFY_CHUNK_SIZE);
++	if (!verify_buf) {
++		printf("verify: malloc failed (%d)\n", VERIFY_CHUNK_SIZE);
++		return -1;
++	}
++
++	crc = 0;
++	remaining = c->data_size;
++	offset = 0;
++
++	while (remaining > 0) {
++		size_t chunk = (remaining < VERIFY_CHUNK_SIZE) ? remaining : VERIFY_CHUNK_SIZE;
++
++		/* bad-block aware read, same skip layout as write/boot path */
++		if (ota_nand_read(c->flash_offset + offset, verify_buf, chunk,
++				  c->flash_offset + c->flash_size) != 0) {
++			printf("verify: read failed at 0x%lx\n",
++			       (unsigned long)(c->flash_offset + offset));
++			free(verify_buf);
++			return -1;
++		}
++		len = chunk;
++
++		/* Compare with source data in DDR */
++		if (memcmp(verify_buf, data + offset, len) != 0) {
++			printf("verify FAIL: %s data mismatch at offset 0x%zx\n",
++			       comp_name(c), offset);
++			free(verify_buf);
++			return -1;
++		}
++
++		crc = crc32(crc, verify_buf, len);
++		remaining -= len;
++		offset += len;
++	}
++
++	free(verify_buf);
++
++	if (crc != c->data_crc) {
++		printf("verify FAIL: %s CRC expected 0x%08x got 0x%08x\n",
++		       comp_name(c), c->data_crc, crc);
++		return -1;
++	}
++	printf("verify OK: %s\n", comp_name(c));
++	return 0;
++}
++
++static int nand_write_component(struct ota_pkg_component *c, u8 *data_base)
++{
++	u8 *data = data_base + c->data_offset;
++	u32 crc;
++
++	printf("Writing %-12s offset=0x%06x size=0x%x\n",
++	       comp_name(c), c->flash_offset, c->data_size);
++
++	crc = crc32(0, data, c->data_size);
++	if (crc != c->data_crc) {
++		printf("CRC mismatch: expected 0x%08x got 0x%08x\n",
++		       c->data_crc, crc);
++		return -1;
++	}
++
++	/* bad-block aware erase+write: same skip layout as boot path
++	 * (nand read skip_bad); failures mark blocks bad and data is
++	 * rewritten to the next good block, never consumed by bad ones */
++	if (ota_nand_erase(c->flash_offset, c->flash_size) != 0) {
++		printf("Erase failed at 0x%x\n", c->flash_offset);
++		return -1;
++	}
++
++	if (ota_nand_write(c->flash_offset, data, c->data_size,
++			   c->flash_offset + c->flash_size) != 0) {
++		printf("Write failed at 0x%x\n", c->flash_offset);
++		return -1;
++	}
++
++	if (nand_verify_component(c, data_base) != 0) {
++		printf("Verify failed for %s\n", comp_name(c));
++		return -1;
++	}
++
++	printf("%-12s done\n", comp_name(c));
++	return 0;
++}
++
++
++/*
++ * Load upgrade package from UBI 'upgrade' volume into DDR.
++ * Uses U-Boot native UBI commands via run_command().
++ */
++static int load_upgrade_from_ubi(ulong addr, ulong max_size, ulong *out_size)
++{
++	int ret;
++	char cmd[128];
++
++	/* Attach upgrade partition */
++	snprintf(cmd, sizeof(cmd), "ubi part upgrade");
++	ret = run_command(cmd, 0);
++	if (ret) {
++		printf("load_upgrade: ubi part upgrade failed\n");
++		return -1;
++	}
++
++	/* Read upgrade volume to DDR */
++	snprintf(cmd, sizeof(cmd), "ubi read 0x%lx upgrade 0x%lx", addr, max_size);
++	ret = run_command(cmd, 0);
++	if (ret) {
++		printf("load_upgrade: ubi read failed\n");
++		return -1;
++	}
++
++	/* Get actual filesize from UBI layer */
++	{
++		char *fsz = env_get("filesize");
++		if (fsz)
++			*out_size = simple_strtoul(fsz, NULL, 16);
++		else
++			*out_size = max_size;
++	}
++
++	printf("load_upgrade: loaded %lu bytes from UBI upgrade volume to 0x%lx\n",
++	       *out_size, addr);
++	return 0;
++}
++
++static int do_nand_ota_upgrade(struct cmd_tbl *cmdtp, int flag, int argc,
++			       char *const argv[])
++{
++	ulong addr;
++	struct ota_pkg_header *hdr = NULL;
++	struct ota_pkg_component *table;
++	struct ota_upgrade_flag uflag;
++	u8 *base;
++	u32 i;
++	int ret;
++	int failed = 0;
++	/* 1 = deterministic failure (bad package: version/size/component/CRC/rollback),
++	 *    mark FAILED immediately, no retry.
++	 * 0 = I/O failure (NAND read/write, uflag write, UBI load), retry via retry_count. */
++	int deterministic = 0;
++	ulong pkg_size = 0;
++
++	if (argc < 2) {
++		/* Default load address */
++		addr = 0x42000000;
++	} else {
++		addr = simple_strtoul(argv[1], NULL, 16);
++		if (addr == 0 || addr > 0x80000000) {
++			printf("nand_ota: invalid load address 0x%lx\n", addr);
++			return CMD_RET_FAILURE;
++		}
++	}
++	base = (u8 *)addr;
++
++	ret = nand_mtd_init();
++	if (ret) {
++		printf("nand_ota: NAND init failed\n");
++		return CMD_RET_FAILURE;
++	}
++
++	ret = uflag_read(&uflag);
++	if (ret) {
++		printf("nand_ota: uflag read failed\n");
++		return CMD_RET_FAILURE;
++	}
++
++	if (uflag.magic != OTA_UPGRADE_MAGIC ||
++	    (uflag.state != OTA_STATE_PENDING && uflag.state != OTA_STATE_RUNNING)) {
++		printf("nand_ota: invalid uflag state\n");
++		return CMD_RET_FAILURE;
++	}
++
++	/* PENDING -> RUNNING transition */
++	if (uflag.state == OTA_STATE_PENDING) {
++		uflag.state = OTA_STATE_RUNNING;
++		ret = uflag_write(&uflag);
++		if (ret) {
++			printf("nand_ota: failed to set RUNNING\n");
++			goto fail;
++		}
++		printf("nand_ota: state PENDING -> RUNNING\n");
++	}
++
++	/* Load upgrade package from UBI upgrade volume */
++	ret = load_upgrade_from_ubi(addr, uflag.upgrade_size, &pkg_size);
++	if (ret) {
++		printf("nand_ota: failed to load upgrade package\n");
++		goto fail;
++	}
++
++	hdr = (struct ota_pkg_header *)base;
++
++	/* Validation phase: failures here are deterministic (the package itself is
++	 * invalid, so retrying is pointless). */
++	deterministic = 1;
++
++	if (hdr->magic != OTA_PKG_MAGIC) {
++		printf("nand_ota: bad package magic 0x%08x\n", hdr->magic);
++		goto fail;
++	}
++
++	if (hdr->version != OTA_PKG_VERSION) {
++		printf("nand_ota: unsupported version %u\n", hdr->version);
++		goto fail;
++	}
++
++	if (hdr->total_size < OTA_PKG_HEADER_SIZE + OTA_PKG_SIG_SIZE +
++	    sizeof(struct ota_pkg_component)) {
++		printf("nand_ota: total_size too small (%u)\n", hdr->total_size);
++		goto fail;
++	}
++
++	if (hdr->total_size > MAX_UPGRADE_SIZE) {
++		printf("nand_ota: total_size too large (%u > %u)\n",
++		       hdr->total_size, MAX_UPGRADE_SIZE);
++		goto fail;
++	}
++
++	if (uflag.upgrade_size > 0 && hdr->total_size != uflag.upgrade_size) {
++		printf("nand_ota: total_size mismatch (uflag=%u, pkg=%u)\n",
++		       uflag.upgrade_size, hdr->total_size);
++		goto fail;
++	}
++
++	if (hdr->component_cnt == 0 || hdr->component_cnt > OTA_PKG_MAX_COMPS) {
++		printf("nand_ota: invalid component count (%u)\n",
++		       hdr->component_cnt);
++		goto fail;
++	}
++
++	/* Check component_mask consistency with package */
++	{
++		u32 pkg_comp_mask = 0;
++		u32 j;
++		for (j = 0; j < hdr->component_cnt; j++) {
++			struct ota_pkg_component *c = (struct ota_pkg_component *)
++				((u8 *)base + OTA_PKG_HEADER_SIZE + j * OTA_PKG_COMP_SIZE);
++			u32 bit = comp_bit_by_name((const char *)c->name);
++			if (bit)
++				pkg_comp_mask |= bit;
++		}
++		if (pkg_comp_mask != uflag.component_mask) {
++			printf("nand_ota: component_mask mismatch (pkg=0x%x, uflag=0x%x)\n",
++			       pkg_comp_mask, uflag.component_mask);
++			goto fail;
++		}
++	}
++
++	table = (struct ota_pkg_component *)(base + OTA_PKG_HEADER_SIZE);
++
++	if (validate_nand_components(hdr, table) != 0) {
++		printf("nand_ota: component validation failed\n");
++		goto fail;
++	}
++
++	if (verify_package_crc(hdr, table, base) != 0)
++		goto fail;
++
++	/* Version anti-rollback check */
++	if (hdr->fw_version < uflag.version_new) {
++		printf("nand_ota: version rollback detected (pkg=0x%08x, uflag_new=0x%08x)\n",
++		       hdr->fw_version, uflag.version_new);
++		goto fail;
++	}
++	if (hdr->fw_version < uflag.version_old) {
++		printf("nand_ota: version rollback detected (pkg=0x%08x, uflag_old=0x%08x)\n",
++		       hdr->fw_version, uflag.version_old);
++		goto fail;
++	}
++
++	printf("nand_ota: package v%u, %u components, size=%u\n",
++	       hdr->version, hdr->component_cnt, hdr->total_size);
++
++	/* Validation passed; now flashing. NAND write / uflag write failures here are
++	 * I/O errors and may be retried. */
++	deterministic = 0;
++
++	/*
++	 * No uboot backup needed: OTFL loads this Recovery from the otfl
++	 * partition (which is never an OTA target). A power failure while
++	 * erasing the uboot partition just resumes via the intact otfl
++	 * Recovery on next boot.
++	 */
++
++	/* Component write order: bl31 -> kernel -> rootfs -> uboot */
++	{
++		const char *write_order[] = {"bl31", "kernel", "rootfs", "uboot"};
++		u32 order_idx;
++
++		for (order_idx = 0; order_idx < ARRAY_SIZE(write_order); order_idx++) {
++			for (i = 0; i < hdr->component_cnt; i++) {
++				struct ota_pkg_component *c = &table[i];
++				u32 bit;
++
++				if (c->media != OTA_MEDIA_NAND)
++					continue;
++
++				if (strncmp((const char *)c->name, write_order[order_idx], 16) != 0)
++					continue;
++
++				bit = comp_bit_by_name((const char *)c->name);
++				if (bit == 0) {
++					printf("Skipping %-12s (unknown NAND component)\n", comp_name(c));
++					continue;
++				}
++				if (!(uflag.component_mask & bit)) {
++					printf("Skipping %-12s (not selected by component_mask 0x%x)\n",
++					       comp_name(c), uflag.component_mask);
++					continue;
++				}
++				if (uflag.completed_mask & bit) {
++					printf("Skipping %-12s (already done)\n", comp_name(c));
++					continue;
++				}
++
++				if (nand_write_component(c, base) != 0) {
++					printf("FAILED: %-12s\n", comp_name(c));
++					failed = 1;
++					break;
++				}
++
++				uflag.completed_mask |= bit;
++				if (uflag_write(&uflag) != 0) {
++					printf("FAILED to update uflag completed_mask\n");
++					failed = 1;
++					break;
++				}
++			}
++			if (failed)
++				break;
++		}
++	}
++
++	if (failed)
++		goto fail;
++
++	/* Success: clear uflag to IDLE */
++	uflag.state = OTA_STATE_IDLE;
++	uflag.completed_mask = 0;
++	if (uflag_write(&uflag) != 0) {
++		printf("nand_ota: failed to clear uflag\n");
++		goto fail;
++	}
++
++	{
++		struct ota_upgrade_flag verify;
++		if (uflag_read(&verify) != 0 ||
++		    verify.state != OTA_STATE_IDLE) {
