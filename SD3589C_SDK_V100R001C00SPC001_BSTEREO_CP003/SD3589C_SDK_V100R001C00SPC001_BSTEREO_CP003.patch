++#define PART_SIZE_UFLAG		0x00080000	/* 512K */
++#define PART_OFFSET_UBOOT	0x00200000
++#define PART_SIZE_UBOOT		0x00100000	/* 1M */
++#define PART_OFFSET_BL31	0x00300000
++#define PART_SIZE_BL31		0x00080000	/* 512K */
++#define PART_OFFSET_KERNEL	0x00380000
++#define PART_SIZE_KERNEL	0x00800000	/* 8M */
++#define PART_OFFSET_ROOTFS	0x00B80000
++#define PART_SIZE_ROOTFS	0x00800000	/* 8M */
++#define PART_OFFSET_UPGRADE	0x01380000
++#define PART_SIZE_UPGRADE	0x02000000	/* 32M */
++#define PART_OFFSET_USERFS	0x03380000
++#define PART_SIZE_USERFS	0x02000000	/* 32M */
