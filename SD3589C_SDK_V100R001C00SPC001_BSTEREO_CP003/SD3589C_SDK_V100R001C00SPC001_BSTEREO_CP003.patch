++			goto fail;
++		}
++		printf("nand_ota: uflag cleared and verified OK\n");
++	}
++
++	printf("nand_ota: SUCCESS, resetting...\n");
++	do_reset(NULL, 0, 0, NULL);
++	return CMD_RET_SUCCESS;
++
++fail:
