++	 * some failures happen before hdr is assigned, so dereferencing hdr here
++	 * would be unsafe.
++	 *   deterministic=1 (invalid package) -> mark FAILED immediately;
++	 *   deterministic=0 (I/O error)       -> retry via retry_count. */
++	if (deterministic) {
++		uflag.state = OTA_STATE_FAILED;
++		printf("nand_ota: deterministic failure, marking FAILED\n");
++	} else if (uflag.retry_count > 0) {
++		uflag.retry_count--;
++		if (uflag.retry_count == 0) {
++			uflag.state = OTA_STATE_FAILED;
++			printf("nand_ota: retries exhausted, marking FAILED\n");
++		} else {
++			printf("nand_ota: FAILED, retry_count=%u, resetting...\n",
++			       uflag.retry_count);
++		}
++	} else {
++		uflag.state = OTA_STATE_FAILED;
++		printf("nand_ota: no retries left, marking FAILED\n");
++	}
++
++	if (uflag_write(&uflag) != 0)
++		printf("nand_ota: failed to write uflag on fail path\n");
++	do_reset(NULL, 0, 0, NULL);
++	return CMD_RET_FAILURE;
++}
