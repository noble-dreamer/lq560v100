++static int do_misc_check(struct cmd_tbl *cmdtp, int flag, int argc,
++			 char *const argv[])
++{
++	struct ota_upgrade_flag uflag;
++	int ret;
++
++	ret = uflag_read(&uflag);
++	if (ret) {
++		/* no valid flag copy: treat as no upgrade (return 0),
++		 * NOT CMD_RET_FAILURE(=1) which would falsely trigger
++		 * nand_ota_upgrade from bootcmd 'test $? -eq 1' */
++		printf("misc_check: no valid uflag, normal boot\n");
++		return 0;
++	}
++
++	if (uflag.magic != OTA_UPGRADE_MAGIC) {
++		printf("misc_check: invalid magic 0x%08x, normal boot\n", uflag.magic);
++		return 0;
